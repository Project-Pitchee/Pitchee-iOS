// The only checked-in version source, inherited by every target/configuration.
// Xcode Cloud's pre-build hook copies CI_TAG and CI_BUILD_NUMBER here in its
// temporary checkout. It never allocates or increments a build number.
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1
VERSIONING_SYSTEM = apple-generic

// Keep generated Info.plist values tied to the same effective build settings.
INFOPLIST_KEY_CFBundleShortVersionString = $(MARKETING_VERSION)
INFOPLIST_KEY_CFBundleVersion = $(CURRENT_PROJECT_VERSION)
