    "practice.kind.dailyReading.instruction" : {
      "comment" : "Guided practice and comparison. Keep goals, model outputs, recording checks, and personal listening feedback distinct.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اقرأ كما تتحدث في حياتك اليومية. ركّز على مدة الكلام المكتشف في هذا التدريب."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Čtěte tak, jak mluvíte v běžném životě. V tomto cvičení se zaměřte na délku rozpoznané řeči."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Læs, som du ville tale til daglig. Fokusér på varigheden af registreret tale i denne øvelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lies so, wie du im Alltag sprechen würdest. Achte bei dieser Übung auf die erkannte Sprechdauer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Διαβάστε όπως μιλάτε στην καθημερινότητά σας. Σε αυτή την εξάσκηση εστιάστε στη διάρκεια ανιχνευμένης ομιλίας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read as you would speak in everyday life. Focus on detected speech duration for this practice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lee como hablarías en la vida cotidiana. En esta práctica, céntrate en la duración del habla detectada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lue kuten puhuisit arjessa. Keskity tässä harjoituksessa havaitun puheen kestoon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lisez comme vous parleriez au quotidien. Pour cet exercice, concentrez-vous sur la durée de parole détectée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "קראו כפי שאתם מדברים ביום-יום. בתרגול זה התמקדו במשך הדיבור שזוהה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ऐसे पढ़ें जैसे रोज़मर्रा में बोलते हैं। इस अभ्यास में पहचानी गई बोलचाल की अवधि पर ध्यान दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Čitaj kao što govoriš u svakodnevnom životu. U ovoj se vježbi usredotoči na trajanje prepoznatog govora."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Úgy olvass, ahogyan a mindennapokban beszélnél. Ebben a gyakorlásban az észlelt beszéd időtartamára figyelj."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Baca seperti Anda berbicara sehari-hari. Fokuskan latihan ini pada durasi ucapan yang terdeteksi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Leggi come parleresti nella vita quotidiana. In questa pratica concentrati sulla durata del parlato rilevato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "普段話すように読みましょう。今回は検出された発話時間に注目します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "평소 말하듯이 읽어 보세요. 이번 연습에서는 감지된 발화 시간에 집중해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Baca seperti anda bercakap dalam kehidupan seharian. Fokus pada tempoh pertuturan yang dikesan untuk latihan ini."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lees zoals je in het dagelijks leven zou spreken. Richt je bij deze oefening op de gedetecteerde spraakduur."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Czytaj tak, jak mówisz na co dzień. W tym ćwiczeniu skup się na czasie wykrytej mowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Leia como falaria no dia a dia. Nesta prática, foque na duração da fala detectada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Читайте так, как говорите в повседневной жизни. В этой тренировке следите за длительностью обнаруженной речи."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Läs som du skulle tala till vardags. Fokusera på längden av upptäckt tal i den här övningen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "อ่านเหมือนพูดในชีวิตประจำวัน การฝึกนี้ให้เน้นระยะเวลาคำพูดที่ตรวจพบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Günlük hayatta konuştuğun gibi oku. Bu çalışmada algılanan konuşma süresine odaklan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Читайте так, як говорите в повсякденному житті. У цій вправі зосередьтеся на тривалості виявленого мовлення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Đọc như khi nói chuyện hằng ngày. Tập trung vào thời lượng lời nói được phát hiện trong bài luyện này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像日常说话一样读完短句，本次只关注有效说话时长。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像平常說話一樣朗讀。這次練習請留意偵測到的語音長度。"
          }
        }
      }
    },
