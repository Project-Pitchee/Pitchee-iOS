    "settings.localDiagnostics.privacy.description" : {
      "comment" : "Local diagnostics settings or summary. Describes only information kept on this device; do not imply that anything is uploaded.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تلخص فئات النتائج ومدة التسجيل ونسبة الكلام وتقديرات المستوى ووقت المعالجة على هذا الجهاز. لا تحفظ التشخيصات صوتًا أو سمات صوتية أو درجات أو سجلات فردية. ولا تُرسل هذه الملخصات أبدًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Na tomto zařízení se souhrnně zaznamenávají kategorie výsledků, délka nahrávky, podíl řeči, odhady úrovně zvuku a doba zpracování. Diagnostika neukládá zvuk, hlasové charakteristiky, skóre ani jednotlivé záznamy. Tyto souhrny se nikdy neodesílají."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Opsummerer resultatkategorier, optagelseslængde, taleandel, niveauestimater og behandlingstid på denne enhed. Diagnostik gemmer ikke lyd, stemmekendetegn, scorer eller individuelle registreringer. Disse oversigter sendes aldrig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fasst Ergebniskategorien, Aufnahmelänge, Sprachanteil, Pegelschätzungen und Verarbeitungszeit auf diesem Gerät zusammen. Die Diagnose speichert weder Audio noch Stimmmerkmale, Bewertungen oder einzelne Datensätze. Diese Zusammenfassungen werden nie gesendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Συνοψίζει τις κατηγορίες αποτελεσμάτων, τη διάρκεια εγγραφής, το ποσοστό ομιλίας, τις εκτιμήσεις στάθμης και τον χρόνο επεξεργασίας σε αυτή τη συσκευή. Τα διαγνωστικά δεν αποθηκεύουν ήχο, χαρακτηριστικά φωνής, βαθμολογίες ή μεμονωμένες καταχωρίσεις. Αυτές οι συνόψεις δεν αποστέλλονται ποτέ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Summarizes result categories, recording length, speech proportion, level estimates, and processing time on this device. No audio, voice features, scores, or individual records are stored in diagnostics. These summaries are never sent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Resume las categorías de resultados, la duración de las grabaciones, la proporción de habla, las estimaciones de nivel y el tiempo de procesamiento en este dispositivo. Los diagnósticos no guardan audio, características de la voz, puntajes ni registros individuales. Estos resúmenes nunca se envían."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tiivistää tulosluokat, tallenteen pituuden, puheen osuuden, tasoarviot ja käsittelyajan tällä laitteella. Diagnostiikka ei tallenna ääntä, ääniominaisuuksia, pisteitä tai yksittäisiä tietueita. Näitä yhteenvetoja ei koskaan lähetetä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Récapitule sur cet appareil les catégories de résultats, la durée d’enregistrement, la proportion de parole, les estimations de niveau et le temps de traitement. Les diagnostics ne conservent ni audio, ni caractéristiques vocales, ni scores, ni entrées individuelles. Ces récapitulatifs ne sont jamais envoyés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "מסכם קטגוריות תוצאה, אורך הקלטה, שיעור דיבור, אומדני רמה וזמן עיבוד במכשיר זה. האבחון אינו שומר שמע, מאפייני קול, ציונים או רשומות נפרדות. סיכומים אלה לעולם אינם נשלחים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इसी डिवाइस पर परिणामों की श्रेणियाँ, रिकॉर्डिंग की अवधि, बोलचाल का अनुपात, स्तर के अनुमान और प्रोसेसिंग समय का सारांश बनाता है। निदान में ऑडियो, आवाज़ की विशेषताएँ, स्कोर या अलग-अलग रिकॉर्ड सेव नहीं किए जाते। ये सारांश कभी भेजे नहीं जाते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Na ovom uređaju sažimaju se kategorije rezultata, duljina snimke, udio govora, procjene razine zvuka i vrijeme obrade. Dijagnostika ne sprema zvuk, značajke glasa, ocjene ni pojedinačne zapise. Ti se sažeci nikada ne šalju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ezen az eszközön összesíti az eredménykategóriákat, a felvétel hosszát, a beszéd arányát, a szintbecsléseket és a feldolgozási időt. A diagnosztika nem tárol hangot, hangjellemzőket, pontszámokat vagy egyéni bejegyzéseket. Ezek az összesítések soha nem kerülnek elküldésre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merangkum kategori hasil, durasi rekaman, proporsi ucapan, perkiraan tingkat suara, dan waktu pemrosesan di perangkat ini. Diagnostik tidak menyimpan audio, fitur suara, skor, atau catatan individual. Ringkasan ini tidak pernah dikirim."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Riepiloga su questo dispositivo le categorie dei risultati, la durata delle registrazioni, la proporzione di parlato, le stime del livello e il tempo di elaborazione. La diagnostica non memorizza audio, caratteristiche vocali, punteggi o singoli record. Questi riepiloghi non vengono mai inviati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "結果の種類、録音の長さ、音声の割合、レベルの推定値、処理時間をこの端末内で集計します。診断には音声、声の特徴、スコア、個別の記録を保存しません。集計が送信されることもありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "결과 유형, 녹음 길이, 음성 비율, 레벨 추정치, 처리 시간을 이 기기에서만 요약해요. 진단에는 오디오, 목소리 특징, 점수 또는 개별 기록을 저장하지 않아요. 이 요약은 전송되지 않아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merumuskan kategori hasil, panjang rakaman, bahagian pertuturan, anggaran aras, dan masa pemprosesan pada peranti ini. Diagnostik tidak menyimpan audio, ciri suara, skor, atau rekod individu. Ringkasan ini tidak pernah dihantar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vat resultaatcategorieën, opnameduur, spraakaandeel, niveauschattingen en verwerkingstijd samen op dit apparaat. Diagnostiek slaat geen audio, stemkenmerken, scores of afzonderlijke registraties op. Deze samenvattingen worden nooit verzonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Na tym urządzeniu podsumowywane są kategorie wyników, długość nagrania, udział mowy, szacunki poziomów dźwięku i czas przetwarzania. Diagnostyka nie przechowuje dźwięku, cech głosu, punktacji ani pojedynczych zapisów. Te podsumowania nigdy nie są wysyłane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Resume as categorias de resultados, a duração das gravações, a proporção de fala, as estimativas de nível e o tempo de processamento neste dispositivo. Os diagnósticos não armazenam áudio, características da voz, pontuações nem registros individuais. Esses resumos nunca são enviados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "На этом устройстве сводятся категории результатов, длительность записи, доля речи, оценки уровней звука и время обработки. Диагностика не сохраняет аудио, характеристики голоса, оценки или отдельные записи. Эти сводки никогда не отправляются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sammanfattar resultatkategorier, inspelningslängd, talandel, nivåuppskattningar och bearbetningstid på den här enheten. Diagnostiken lagrar inte ljud, röstegenskaper, poäng eller enskilda poster. Dessa sammanfattningar skickas aldrig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "สรุปประเภทผลลัพธ์ ความยาวบันทึกเสียง สัดส่วนคำพูด ค่าประมาณระดับเสียง และเวลาประมวลผลบนอุปกรณ์นี้ การวินิจฉัยไม่เก็บเสียง คุณลักษณะเสียง คะแนน หรือข้อมูลรายครั้ง และจะไม่ส่งสรุปเหล่านี้ออกไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sonuç kategorilerini, kayıt uzunluğunu, konuşma oranını, seviye tahminlerini ve işlem süresini bu cihazda özetler. Tanılama; ses, ses özellikleri, puanlar veya tekil kayıtlar saklamaz. Bu özetler asla gönderilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "На цьому пристрої підсумовуються категорії результатів, тривалість запису, частка мовлення, оцінки рівнів звуку й час обробки. Діагностика не зберігає аудіо, характеристики голосу, оцінки чи окремі записи. Ці зведення ніколи не надсилаються."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tổng hợp loại kết quả, độ dài bản ghi âm, tỷ lệ lời nói, ước tính mức âm thanh và thời gian xử lý trên thiết bị này. Chẩn đoán không lưu âm thanh, đặc trưng giọng nói, điểm hay từng bản ghi riêng lẻ. Các tóm tắt này không bao giờ được gửi đi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
