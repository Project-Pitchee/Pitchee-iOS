    "practice.home.resumeNote" : {
      "comment" : "Guided practice and comparison. Keep goals, model outputs, recording checks, and personal listening feedback distinct.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "استأنف نوع تدريبك الأخير بتسجيل A جديد. لا يبقى الصوت بين مرات تشغيل التطبيق."
