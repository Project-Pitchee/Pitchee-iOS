    "practice.quality.background" : {
      "comment" : "Guided practice and comparison. Keep goals, model outputs, recording checks, and personal listening feedback distinct.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مستويا الكلام والخلفية متقاربان، مما قد يؤثر في المقارنة. حاول التسجيل مجددًا في مكان أهدأ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Úrovně řeči a pozadí jsou podobné, což může ovlivnit porovnání. Zkuste nahrát znovu na tišším místě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tale- og baggrundsniveau ligger tæt, hvilket kan påvirke sammenligningen. Prøv at optage igen et mere stille sted."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sprach- und Hintergrundpegel liegen nahe beieinander. Das kann den Vergleich beeinflussen. Nimm erneut an einem ruhigeren Ort auf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Οι στάθμες ομιλίας και υποβάθρου είναι κοντά, κάτι που μπορεί να επηρεάσει τη σύγκριση. Δοκιμάστε νέα εγγραφή σε πιο ήσυχο μέρος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speech and background levels are close, which may affect comparison. Try recording again in a quieter place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los niveles de voz y fondo son similares, lo que puede afectar la comparación. Prueba a grabar de nuevo en un lugar más silencioso."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puheen ja taustan tasot ovat lähellä toisiaan, mikä voi vaikuttaa vertailuun. Kokeile tallentaa uudelleen hiljaisemmassa paikassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les niveaux de parole et de fond sont proches, ce qui peut influencer la comparaison. Réessayez dans un endroit plus calme."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "רמות הדיבור והרקע קרובות, דבר שעשוי להשפיע על ההשוואה. נסו להקליט שוב במקום שקט יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बोलचाल और पृष्ठभूमि के स्तर करीब हैं, जिससे तुलना प्रभावित हो सकती है। किसी शांत जगह में फिर रिकॉर्ड करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Razine govora i pozadine bliske su, što može utjecati na usporedbu. Pokušaj ponovno snimiti na tišem mjestu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A beszéd és a háttér szintje közel van egymáshoz, ami befolyásolhatja az összehasonlítást. Próbáld újra csendesebb helyen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tingkat ucapan dan latar belakang berdekatan, yang dapat memengaruhi perbandingan. Coba rekam lagi di tempat yang lebih tenang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I livelli del parlato e del sottofondo sono simili, e questo può influire sul confronto. Prova a registrare di nuovo in un luogo più silenzioso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "音声と背景音のレベルが近く、比較に影響する可能性があります。静かな場所でもう一度録音してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "음성과 배경음의 레벨이 비슷해 비교에 영향을 줄 수 있어요. 더 조용한 곳에서 다시 녹음해 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aras pertuturan dan latar belakang hampir sama, yang boleh mempengaruhi perbandingan. Cuba rakam semula di tempat yang lebih senyap."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spraak- en achtergrondniveaus liggen dicht bij elkaar, wat de vergelijking kan beïnvloeden. Probeer opnieuw op te nemen op een stillere plek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Poziomy mowy i tła są zbliżone, co może wpłynąć na porównanie. Spróbuj nagrać ponownie w cichszym miejscu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os níveis de fala e fundo estão próximos, o que pode afetar a comparação. Tente gravar novamente em um lugar mais silencioso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Уровни речи и фона близки, что может повлиять на сравнение. Попробуйте записать снова в более тихом месте."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tal- och bakgrundsnivåerna ligger nära varandra, vilket kan påverka jämförelsen. Prova att spela in igen på en tystare plats."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ระดับคำพูดใกล้เคียงกับเสียงพื้นหลัง ซึ่งอาจกระทบการเปรียบเทียบ ลองบันทึกอีกครั้งในที่เงียบกว่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Konuşma ve arka plan seviyeleri yakın; bu durum karşılaştırmayı etkileyebilir. Daha sessiz bir yerde yeniden kaydetmeyi dene."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Рівні мовлення й фону близькі, що може вплинути на порівняння. Спробуйте записати знову в тихішому місці."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mức âm lời nói gần mức âm nền, có thể ảnh hưởng đến so sánh. Thử ghi lại ở nơi yên tĩnh hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人声与背景的电平差较小，可能影响比较。请换到安静处重录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "語音與背景位準接近，可能影響比較。請換到更安靜的地方重新錄音。"
          }
        }
      }
    },
    "practice.quality.clipping" : {
      "comment" : "Guided practice and comparison. Keep goals, model outputs, recording checks, and personal listening feedback distinct.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قد يكون التسجيل مشوهًا بسبب قص الإشارة. ابتعد قليلًا عن الميكروفون وتجنب علو الصوت المفرط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nahrávka může být zkreslená přebuzením. Posuňte se o něco dál od mikrofonu a vyhněte se nadměrné hlasitosti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Optagelsen kan være overstyret. Flyt dig lidt længere fra mikrofonen, og undgå for høj lydstyrke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Aufnahme ist möglicherweise übersteuert. Vergrößere den Abstand zum Mikrofon etwas und vermeide übermäßige Lautstärke."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η εγγραφή μπορεί να έχει παραμόρφωση λόγω υπερφόρτωσης. Απομακρυνθείτε λίγο από το μικρόφωνο και αποφύγετε την υπερβολική ένταση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The recording may be clipped. Move a little farther from the microphone and avoid excessive volume."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La grabación puede estar saturada. Aléjate un poco del micrófono y evita un volumen excesivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tallenteen ääni saattaa leikkautua. Siirry hieman kauemmas mikrofonista ja vältä liian suurta äänenvoimakkuutta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’enregistrement présente peut-être de la saturation. Éloignez-vous un peu du microphone et évitez un volume excessif."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ייתכן שבהקלטה יש קיטום אות. התרחקו מעט מהמיקרופון והימנעו מעוצמה מוגזמת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "रिकॉर्डिंग में सिग्नल कटने से विकृति हो सकती है। माइक्रोफ़ोन से थोड़ा दूर जाएँ और बहुत तेज़ आवाज़ से बचें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Snimka možda ima izobličenje zbog preopterećenja. Malo se odmakni od mikrofona i izbjegavaj pretjeranu glasnoću."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A felvétel túlvezérelt lehet. Menj kicsit távolabb a mikrofontól, és kerüld a túl nagy hangerőt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rekaman mungkin mengalami distorsi karena sinyal terpotong. Jauhkan sedikit dari mikrofon dan hindari volume berlebihan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La registrazione potrebbe essere distorta per saturazione. Allontanati un po' dal microfono ed evita un volume eccessivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "録音が音割れしている可能性があります。マイクから少し離れ、大きすぎる声を避けてください。"
          }
        },
