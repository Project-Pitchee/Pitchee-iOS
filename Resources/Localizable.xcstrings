        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Net bir hedefin olabilir ya da yalnızca keşfedebilirsin. İstediğin zaman dönüp değiştirebilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Поставте чітку мету або просто досліджуйте — сюди можна повернутися й змінити вибір будь-коли."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Đặt mục tiêu rõ ràng hoặc chỉ để khám phá — bạn luôn có thể quay lại điều chỉnh."
          }
