    "onboarding.welcome.subtitle" : {
      "comment" : "Pitchee is the product name; keep it in Latin script and keep the space before the following Chinese text. Warm, companion-like second-person tone.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يحوّل Pitchee صوتك إلى ملاحظات واضحة قابلة للتتبع، ويرافقك في كل تغيّر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee mění váš hlas v jasnou a sledovatelnou zpětnou vazbu a doprovází vás při každé změně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee gør din stemme til klar, sporbar feedback og følger hver ændring sammen med dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee verwandelt deine Stimme in klares, nachvollziehbares Feedback und begleitet jede Veränderung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το Pitchee μετατρέπει τη φωνή σας σε σαφή, μετρήσιμη ανατροφοδότηση και καταγράφει κάθε αλλαγή μαζί σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitchee turns your voice into clear, trackable feedback and follows every change with you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee convierte tu voz en comentarios claros que puedes seguir, y te acompaña en cada cambio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee muuttaa äänesi selkeäksi, seurattavaksi palautteeksi ja seuraa kanssasi jokaista muutosta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee transforme votre voix en retours clairs et faciles à suivre, et vous accompagne à chaque changement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee הופכת את הקול שלכם למשוב ברור וניתן למעקב, ומלווה אתכם בכל שינוי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee आपकी आवाज़ को साफ़, ट्रैक करने लायक जानकारी में बदलता है और हर बदलाव आपके साथ दर्ज करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee pretvara tvoj glas u jasne povratne informacije koje možeš pratiti i zajedno s tobom bilježi svaku promjenu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A Pitchee világos, nyomon követhető visszajelzéssé alakítja a hangodat, és minden változást veled együtt követ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee mengubah suara Anda menjadi umpan balik yang jelas dan dapat dilacak, serta menemani setiap perubahannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee trasforma la tua voce in un riscontro chiaro e tracciabile e ti accompagna in ogni cambiamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee は声を、わかりやすく変化を追えるフィードバックに変え、一緒に見守っていきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee는 목소리를 또렷하고 추적하기 쉬운 피드백으로 바꿔, 변화를 함께 기록해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee menukar suara anda kepada maklum balas yang jelas dan boleh dijejaki, serta mengiringi setiap perubahan anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee zet je stem om in heldere feedback die je kunt volgen, en gaat elke verandering met je mee."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee zamienia twój głos w jasną, mierzalną informację zwrotną i towarzyszy ci w każdej zmianie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Pitchee transforma sua voz em informações claras e fáceis de acompanhar, registrando cada mudança com você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee превращает голос в понятную и отслеживаемую обратную связь и помогает замечать каждое изменение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee gör din röst till tydlig och följbar återkoppling – och följer varje förändring tillsammans med dig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee เปลี่ยนเสียงของคุณให้เป็นข้อเสนอแนะที่ชัดเจนและติดตามได้ พร้อมอยู่เคียงข้างทุกการเปลี่ยนแปลงของเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee sesini net ve izlenebilir geri bildirime dönüştürür, her değişimi seninle birlikte takip eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee перетворює ваш голос на чіткий відгук, який можна відстежувати, і разом із вами фіксує кожну зміну."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee biến giọng nói của bạn thành phản hồi rõ ràng, dễ theo dõi và đồng hành cùng bạn qua từng thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitchee 会把声音变成清晰、可追踪的反馈，陪你记录每一次变化。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitchee 會把聲音變成清晰、可追蹤的回饋，陪你記錄每一次變化。"
          }
        }
      }
    },
    "onboarding.welcome.title" : {
      "comment" : "Deliberate line break before the second clause; keep a short two-line split. Slogan tone, no punctuation.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اعرف نفسك\nمن خلال صوتك"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Poznejte sebe\nskrze svůj hlas"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lær dig selv at kende\ngennem din stemme"
