          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Громкость речи и фона показана в dBFS: чем ближе значение к 0, тем громче."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Röstens och bakgrundens ljudnivå visas i dBFS; ju närmare 0 värdet ligger, desto starkare är ljudet."
          }
