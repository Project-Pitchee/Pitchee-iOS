    "settings.localDiagnostics.clear.note" : {
      "comment" : "Local diagnostics settings or summary. Describes only information kept on this device; do not imply that anything is uploaded.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يُبقي مسح التشخيصات أو إيقافها إعداد المشاركة وحد الفترة الحالية فقط. ولا يزيد عدد المحاولات التي يمكن تسجيلها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vymazání nebo vypnutí diagnostiky zachová pouze nastavení účasti a limit aktuálního období. Nezvyšuje počet dostupných diagnostických záznamů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hvis du rydder eller slår diagnostik fra, bevares kun deltagelsesindstillingen og grænsen for den aktuelle periode. Det giver ikke flere pladser til diagnostiske registreringer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Löschen oder Deaktivieren der Diagnose behält nur die Teilnahme-Einstellung und die Grenze des laufenden Zeitraums bei. Es ermöglicht keine zusätzlichen Einträge."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η εκκαθάριση ή απενεργοποίηση διαγνωστικών διατηρεί μόνο τη ρύθμιση συμμετοχής και το όριο της τρέχουσας περιόδου. Δεν προσθέτει διαθέσιμες καταχωρίσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clearing or turning off diagnostics keeps only the participation setting and current period limit. It does not add more recording slots."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Borrar o desactivar los diagnósticos conserva únicamente la preferencia de participación y el límite del período actual. No añade más cupos para registrar análisis."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Diagnostiikan tyhjentäminen tai poistaminen käytöstä säilyttää vain osallistumisasetuksen ja nykyisen jakson rajan. Se ei lisää paikkoja diagnostiikan kirjauksille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Effacer ou désactiver les diagnostics conserve uniquement le réglage de participation et la limite de la période en cours. Cela n’augmente pas le nombre de diagnostics autorisés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ניקוי או כיבוי האבחון משאירים רק את הגדרת ההשתתפות ואת מגבלת התקופה הנוכחית. הם אינם מוסיפים מכסת תיעוד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "निदान मिटाने या बंद करने पर केवल भागीदारी सेटिंग और वर्तमान अवधि की सीमा बनी रहती है। इससे दर्ज करने की अतिरिक्त जगह नहीं मिलती।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Brisanje ili isključivanje dijagnostike zadržava samo postavku sudjelovanja i ograničenje trenutačnog razdoblja. Ne povećava broj dostupnih dijagnostičkih zapisa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A diagnosztika törlése vagy kikapcsolása csak a részvételi beállítást és az aktuális időszak korlátját tartja meg. Nem ad további helyeket a diagnosztikai bejegyzésekhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menghapus atau menonaktifkan diagnostik hanya mempertahankan pengaturan partisipasi dan batas periode saat ini. Ini tidak menambah jatah pencatatan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cancellare o disattivare la diagnostica conserva solo l'impostazione di partecipazione e il limite del periodo attuale. Non aggiunge altre possibilità di registrazione nella diagnostica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "診断を消去またはオフにした後は、参加設定と今期の回数制限だけが残ります。記録可能な回数は増えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "진단을 지우거나 끄면 참여 설정과 현재 기간의 횟수 제한만 유지돼요. 기록 가능한 횟수가 늘어나지는 않아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mengosongkan atau mematikan diagnostik hanya mengekalkan tetapan penyertaan dan had tempoh semasa. Ia tidak menambah kuota catatan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Als je diagnostiek wist of uitschakelt, blijven alleen de deelname-instelling en de limiet voor de huidige periode bewaard. Er komen geen extra plaatsen voor diagnostische registraties bij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wyczyszczenie lub wyłączenie diagnostyki zachowuje tylko ustawienie udziału i limit bieżącego okresu. Nie zwiększa liczby dostępnych wpisów diagnostycznych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Limpar ou desativar os diagnósticos mantém apenas a configuração de participação e o limite do período atual. Isso não adiciona mais vagas para registros nos diagnósticos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "После очистки или отключения диагностики сохраняются только настройка участия и ограничение текущего периода. Доступное число записей диагностики не увеличивается."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Om du rensar eller stänger av diagnostik behålls bara deltagandeinställningen och gränsen för den aktuella perioden. Det ger inte fler platser för diagnostiska registreringar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "การล้างหรือปิดการวินิจฉัยจะเก็บไว้เฉพาะการตั้งค่าเข้าร่วมและข้อจำกัดของรอบปัจจุบัน ไม่เพิ่มโควตาการบันทึกข้อมูล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tanılamayı temizlemek veya kapatmak yalnızca katılım ayarını ve mevcut dönem sınırını korur. Kayıt kotasını artırmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Після очищення або вимкнення діагностики зберігаються лише налаштування участі й обмеження поточного періоду. Доступна кількість записів діагностики не збільшується."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Xóa hoặc tắt chẩn đoán chỉ giữ lại cài đặt tham gia và giới hạn của kỳ hiện tại. Việc này không tăng số lượt được ghi nhận."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清空或关闭后，只保留参与设置和本周期次数限制，不增加可记录次数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除或關閉診斷後，只保留參與設定和本週期的次數限制，不會增加可記錄次數。"
          }
        }
      }
    },
