    "insights.dashboard.resize.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اسحب للخارج للتكبير أو للداخل للتصغير، أو اضغط لتبديل الحجم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tažením ven zvětšete, dovnitř zmenšete nebo klepnutím změňte velikost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Træk udad for at forstørre, indad for at formindske, eller tryk for at skifte størrelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nach außen ziehen zum Vergrößern, nach innen zum Verkleinern oder tippen, um die Größe zu wechseln."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Σύρετε προς τα έξω για μεγέθυνση, προς τα μέσα για σμίκρυνση ή πατήστε για αλλαγή μεγέθους."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag outward to enlarge, inward to shrink, or tap to switch sizes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arrastra hacia afuera para ampliar, hacia adentro para reducir o toca para cambiar el tamaño."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vedä ulospäin suurentaaksesi, sisäänpäin pienentääksesi tai napauta vaihtaaksesi kokoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Faites glisser vers l’extérieur pour agrandir, vers l’intérieur pour réduire, ou touchez pour changer la taille."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "גררו החוצה להגדלה, פנימה להקטנה, או הקישו להחלפת הגודל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बड़ा करने के लिए बाहर, छोटा करने के लिए अंदर खींचें या आकार बदलने के लिए टैप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Povucite prema van za povećanje, prema unutra za smanjenje ili dodirnite za promjenu veličine."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Húzza kifelé a nagyításhoz, befelé a kicsinyítéshez, vagy koppintson a méretváltáshoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seret ke luar untuk memperbesar, ke dalam untuk memperkecil, atau ketuk untuk mengganti ukuran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trascina verso l’esterno per ingrandire, verso l’interno per ridurre o tocca per cambiare dimensione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "外側にドラッグして拡大、内側にドラッグして縮小、またはタップしてサイズを切り替えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "바깥쪽으로 드래그하여 확대하고 안쪽으로 드래그하여 축소하거나 탭하여 크기를 전환하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seret ke luar untuk membesarkan, ke dalam untuk mengecilkan atau ketik untuk menukar saiz."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sleep naar buiten om te vergroten, naar binnen om te verkleinen of tik om het formaat te wisselen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przeciągnij na zewnątrz, aby powiększyć, do środka, aby zmniejszyć, lub stuknij, aby zmienić rozmiar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arraste para fora para ampliar, para dentro para reduzir ou toque para mudar o tamanho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Потяните наружу для увеличения, внутрь для уменьшения или коснитесь для переключения размера."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dra utåt för att förstora, inåt för att förminska eller tryck för att byta storlek."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ลากออกเพื่อขยาย ลากเข้าเพื่อลดขนาด หรือแตะเพื่อเปลี่ยนขนาด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Büyütmek için dışa, küçültmek için içe sürükleyin veya boyutu değiştirmek için dokunun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Потягніть назовні для збільшення, всередину для зменшення або торкніться для зміни розміру."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kéo ra ngoài để phóng to, vào trong để thu nhỏ hoặc chạm để đổi kích thước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
