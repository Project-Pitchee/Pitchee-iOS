    "practice.suggestion.explore.detail" : {
      "comment" : "Voice practice interface. Keep actions concise; preserve metric names and format arguments.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "جرّب تغييرًا صغيرًا واحدًا في طابع صوت أو أسلوب تعبير تحبه، مسترشدًا براحتك وتفضيلاتك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vyzkoušejte jednu drobnou změnu vlastnosti hlasu, která se vám líbí. Řiďte se pohodlím a vlastními preferencemi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prøv en lille ændring i en stemmekvalitet, du kan lide, med udgangspunkt i komfort og dine ønsker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Probiere eine kleine Änderung an einer Stimmqualität aus, die dir gefällt. Lass dich dabei von deinem Stimmgefühl und deinen Vorlieben leiten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Δοκιμάστε μια μικρή αλλαγή σε ένα χαρακτηριστικό της φωνής που σας αρέσει, με οδηγό την άνεση και τις προτιμήσεις σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try one small change in a vocal quality you like, guided by comfort and your preferences."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prueba un pequeño cambio en una cualidad vocal que te guste, guiándote por la comodidad y tus preferencias."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kokeile yhtä pientä muutosta äänen ominaisuuteen, josta pidät. Anna mukavuuden ja omien mieltymystesi ohjata."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Essayez un petit changement d’une qualité vocale qui vous plaît, en suivant votre confort et vos préférences."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "נסו שינוי קטן אחד בגוון קול או בסגנון הבעה שאתם אוהבים, לפי הנוחות וההעדפות שלכם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अपनी पसंद के स्वर-गुण या अभिव्यक्ति में एक बार में छोटा बदलाव आज़माएँ। सहजता और अपनी पसंद को आधार बनाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Isprobajte malu promjenu osobine glasa koja vam se sviđa, vodeći se ugodom i vlastitim željama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Próbáljon ki egy kis változtatást egy kedvelt hangtulajdonságon, a kényelmét és saját ízlését követve."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coba satu perubahan kecil pada timbre atau cara berekspresi yang Anda sukai, dengan mengutamakan kenyamanan dan pilihan Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prova un piccolo cambiamento in una qualità vocale che ti piace, seguendo comfort e preferenze."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "好きな音色や表現を選び、一度に小さな変化を1つ試しましょう。楽に出せることと自分の好みを大切にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "좋아하는 음색이나 표현에서 한 번에 작은 변화 하나를 시도해 보세요. 편안함과 자신의 취향을 기준으로 삼으세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cuba satu perubahan kecil pada warna nada atau cara penyampaian yang anda suka, berpandukan keselesaan dan pilihan anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Probeer één kleine verandering in een stemkwaliteit die je mooi vindt. Laat je leiden door comfort en je voorkeuren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wypróbuj drobną zmianę lubianej cechy głosu, kierując się komfortem i własnymi preferencjami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Experimente uma pequena mudança em uma qualidade vocal de que você gosta, seguindo seu conforto e suas preferências."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Попробуйте небольшое изменение нравящегося вам свойства голоса, ориентируясь на комфорт и свои предпочтения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prova en liten förändring i en röstkvalitet du gillar. Låt känslan och dina önskemål styra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "เลือกน้ำเสียงหรือการแสดงออกที่ชอบ แล้วลองเปลี่ยนทีละเล็กน้อย โดยยึดความสบายและความชอบของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rahatlığınızı ve tercihlerinizi temel alarak sevdiğiniz bir ses özelliğinde küçük bir değişiklik deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Спробуйте невелику зміну властивості голосу, яка вам подобається, орієнтуючись на комфорт і власні вподобання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Thử từng thay đổi nhỏ với âm sắc hoặc cách diễn đạt bạn thích, dựa trên sự thoải mái và sở thích của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择喜欢的音色或表达方式，一次试一个小变化，以舒适度和喜好为准。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "選擇喜歡的音色或表達方式，一次試一個小變化，以舒適度和喜好為準。"
          }
        }
      }
    },
