    "monitor.pitch.idle.message" : {
      "comment" : "Voice practice interface. Keep actions concise; preserve metric names and format arguments.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ابدأ المراقبة، ثم تحدث برفق أو مدّ صوتًا ثابتًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spusťte sledování a pak tiše mluvte nebo držte stálý tón."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Start overvågningen, og tal derefter stille eller hold en jævn lyd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Starte die Überwachung und sprich dann leise oder halte einen gleichmäßigen Ton."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ξεκινήστε την παρακολούθηση και μιλήστε σιγά ή κρατήστε έναν σταθερό ήχο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start monitoring, then speak softly or hold a steady sound."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inicia el seguimiento y habla suavemente o mantén un sonido estable."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aloita seuranta ja puhu sitten hiljaa tai pidä tasainen ääni."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lancez le suivi, puis parlez doucement ou tenez un son stable."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "התחילו ניטור, ואז דברו ברכות או השמיעו צליל ממושך ויציב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "निगरानी शुरू करें, फिर हल्के से बोलें या एक स्थिर स्वर लंबा खींचें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pokrenite praćenje, pa tiho govorite ili držite stalan ton."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Indítsa el a megfigyelést, majd beszéljen halkan, vagy tartson ki egy egyenletes hangot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mulai pemantauan, lalu bicara lembut atau tahan satu bunyi yang stabil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Avvia il monitoraggio, poi parla piano o mantieni un suono stabile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "モニタリングを開始し、軽く話すか、一定の声を伸ばしてみましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "모니터링을 시작한 뒤 부드럽게 말하거나 일정한 소리를 길게 내 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mulakan pemantauan, kemudian bercakap perlahan atau tahan bunyi yang sekata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Start de monitoring en spreek zacht of houd een gelijkmatige klank aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Włącz monitorowanie, a następnie mów cicho lub utrzymuj stały dźwięk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inicie o monitoramento e fale suavemente ou sustente um som estável."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
