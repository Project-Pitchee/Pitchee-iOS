    "scoring.explanation.intro.description" : {
      "comment" : "Long explanatory paragraph. Keep the disclaimer in the last sentence: the score is for personal trend tracking only.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تجمع الدرجة الإجمالية بين درجة طابع الصوت (VFP) ودرجة طبيعية الصوت ومتوسط التردد الأساسي وفق صيغ التطبيق وقواعده. ولا تحدد النوع الاجتماعي أو القدرة أو صحة الصوت. إذا كنت لا تزال تستكشف هدفك، فاسترشد بما تسمعه وبراحتك أثناء الكلام؛ لا يلزم أن تكون الدرجة الأعلى هدفك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Celkové skóre kombinuje skóre barvy hlasu (VFP), skóre přirozenosti a průměrnou základní frekvenci podle vzorců a pravidel aplikace. Neurčuje gender, schopnosti ani zdraví hlasu. Pokud svůj cíl teprve hledáte, řiďte se tím, co slyšíte a jak se při mluvení cítíte; vyšší skóre nemusí být vaším cílem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Den samlede score kombinerer klangfarve (VFP), naturlighed og gennemsnitlig grundfrekvens med appens formler og regler. Den bestemmer ikke køn, evner eller stemmens sundhed. Hvis du stadig udforsker dit mål, så lad det, du hører og mærker i stemmen, guide dig. En højere score behøver ikke være dit mål."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Gesamtwert verbindet Klangfarbenwert (VFP), Natürlichkeitswert und mittlere Grundfrequenz anhand der Formeln und Regeln der App. Er bestimmt weder Geschlecht noch Fähigkeiten oder Stimmgesundheit. Wenn du dein Ziel noch erkundest, lass dich von deinem Höreindruck und Stimmgefühl leiten. Ein höherer Wert muss nicht dein Ziel sein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η συνολική βαθμολογία συνδυάζει τη βαθμολογία χροιάς (VFP), τη φυσικότητα και τη μέση θεμελιώδη συχνότητα με τους τύπους και κανόνες της εφαρμογής. Δεν καθορίζει φύλο, ικανότητα ή υγεία της φωνής. Αν ακόμη αναζητάτε τον στόχο σας, βασιστείτε σε ό,τι ακούτε και αισθάνεστε· δεν χρειάζεται να στοχεύετε σε υψηλότερη βαθμολογία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The overall score combines the timbre score (VFP), naturalness score, and mean fundamental frequency using app formulas and rules. It does not determine gender, ability, or vocal health. If you are still exploring your goal, use what you hear and how your voice feels to guide you; a higher score does not have to be your goal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La puntuación global combina timbre (VFP), naturalidad y frecuencia fundamental media mediante fórmulas y reglas de la app. No determina género, capacidad ni salud vocal. Si aún exploras tu objetivo, guíate por lo que oyes y cómo sientes tu voz; una puntuación más alta no tiene por qué ser tu meta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kokonaispistemäärä yhdistää äänenväripisteet (VFP), luonnollisuuspisteet ja keskimääräisen perustaajuuden sovelluksen kaavoilla ja säännöillä. Se ei määritä sukupuolta, kykyä tai äänen terveyttä. Jos vielä etsit tavoitettasi, anna kuulemasi ja äänen tuntemusten ohjata. Suurempien pisteiden ei tarvitse olla tavoitteesi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le score global combine le score de timbre (VFP), le score de naturel et la fréquence fondamentale moyenne selon les formules et règles de l’app. Il ne détermine ni le genre, ni les capacités, ni la santé vocale. Si vous explorez encore votre objectif, laissez-vous guider par ce que vous entendez et ressentez ; un score plus élevé ne doit pas forcément être votre but."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הציון הכולל משלב את ציון גוון הקול (VFP), ציון הטבעיות ותדירות היסוד הממוצעת לפי נוסחאות וכללי האפליקציה. הוא אינו קובע מגדר, יכולת או בריאות קולית. אם עדיין לא גיבשתם מטרה, היעזרו במה שאתם שומעים ובתחושה בעת הפקת הקול; ציון גבוה יותר אינו חייב להיות המטרה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कुल स्कोर ऐप के सूत्रों और नियमों से स्वर-गुण स्कोर (VFP), स्वाभाविकता स्कोर और औसत मूल आवृत्ति को जोड़ता है। यह लिंग, क्षमता या आवाज़ की सेहत तय नहीं करता। यदि लक्ष्य अभी खोज रहे हैं, तो अपनी सुनने की अनुभूति और बोलते समय की सहजता को मार्गदर्शक बनाएँ; अधिक स्कोर पाना आपका लक्ष्य होना ज़रूरी नहीं है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ukupna ocjena kombinira ocjenu boje glasa (VFP), prirodnost i srednju osnovnu frekvenciju prema formulama i pravilima aplikacije. Ne utvrđuje rod, sposobnost ni zdravlje glasa. Ako još istražujete svoj cilj, vodite se onime što čujete i kako se vaš glas osjeća; viša ocjena ne mora biti vaš cilj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az összpontszám a hangszínpontszámot (VFP), a természetességi pontszámot és az átlagos alapfrekvenciát egyesíti az alkalmazás képleteivel és szabályaival. Nem állapít meg nemet, képességet vagy hang-egészségi állapotot. Ha még keresi a célját, az vezesse, amit hall, és ahogyan a hangját érzi; nem kell magasabb pontszámra törekednie."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skor keseluruhan menggabungkan skor timbre (VFP), skor kealamian, dan frekuensi dasar rata-rata dengan rumus serta aturan aplikasi. Skor ini tidak menentukan gender, kemampuan, atau kesehatan suara. Jika masih menjelajahi tujuan Anda, gunakan apa yang Anda dengar dan rasakan saat bersuara sebagai panduan; skor yang lebih tinggi tidak harus menjadi tujuan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il punteggio complessivo combina punteggio timbrico (VFP), naturalezza e frequenza fondamentale media con formule e regole dell’app. Non determina genere, capacità o salute vocale. Se stai ancora esplorando il tuo obiettivo, lasciati guidare da ciò che senti e dalle sensazioni della voce; un punteggio più alto non deve essere per forza il tuo scopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "総合スコアは、アプリの式とルールで音色スコア（VFP）、自然度スコア、平均基本周波数を組み合わせたものです。性別、能力、声の健康状態は判断できません。目標を探している場合は、自分の聞こえ方と出しやすさを参考にしてください。高いスコアを目指す必要はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "종합 점수는 앱의 공식과 규칙에 따라 음색 점수(VFP), 자연스러움 점수, 평균 기본 주파수를 조합해요. 성별이나 능력, 목소리 건강을 판단할 수는 없어요. 아직 목표를 탐색 중이라면 들리는 소리와 발성의 편안함을 기준으로 삼으세요. 더 높은 점수를 목표로 삼을 필요는 없어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skor keseluruhan menggabungkan skor warna nada (VFP), skor kewajaran dan purata frekuensi asas menggunakan formula serta peraturan aplikasi. Ia tidak menentukan jantina, keupayaan atau kesihatan suara. Jika masih menerokai matlamat, gunakan apa yang anda dengar dan rasakan semasa bersuara sebagai panduan; skor lebih tinggi tidak semestinya menjadi matlamat anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De totaalscore combineert klankkleur (VFP), natuurlijkheid en gemiddelde grondfrequentie met formules en regels van de app. De score bepaalt geen gender, vaardigheid of stemgezondheid. Verken je je doel nog, laat je dan leiden door wat je hoort en hoe je stem voelt. Een hogere score hoeft niet je doel te zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wynik ogólny łączy wynik barwy głosu (VFP), naturalność i średnią częstotliwość podstawową według wzorów i reguł aplikacji. Nie określa płci, umiejętności ani zdrowia głosu. Jeśli nadal szukasz swojego celu, kieruj się tym, co słyszysz i jak odczuwasz swój głos; wyższy wynik nie musi być Twoim celem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A pontuação geral combina timbre (VFP), naturalidade e frequência fundamental média usando fórmulas e regras do app. Ela não determina gênero, capacidade ou saúde vocal. Se ainda estiver explorando seu objetivo, guie-se pelo que ouve e sente ao falar; uma pontuação maior não precisa ser sua meta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Общая оценка объединяет оценку тембра (VFP), естественность и среднюю основную частоту по формулам и правилам приложения. Она не определяет гендер, способности или здоровье голоса. Если вы ещё ищете свою цель, ориентируйтесь на звучание и собственные ощущения; более высокая оценка не обязана быть вашей целью."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Totalpoängen kombinerar klangfärg (VFP), naturlighet och genomsnittlig grundfrekvens med appens formler och regler. Den avgör inte kön, förmåga eller rösthälsa. Om du fortfarande utforskar ditt mål, låt det du hör och hur rösten känns vägleda dig. Högre poäng behöver inte vara ditt mål."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "คะแนนรวมใช้สูตรและกฎของแอปผสานคะแนนน้ำเสียง (VFP) คะแนนความเป็นธรรมชาติ และความถี่มูลฐานเฉลี่ย ไม่สามารถระบุเพศ ความสามารถ หรือสุขภาพเสียงได้ หากยังสำรวจเป้าหมายอยู่ ให้ใช้สิ่งที่ได้ยินและความสบายในการใช้เสียงเป็นแนวทาง ไม่จำเป็นต้องตั้งเป้าให้ได้คะแนนสูงขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Genel puan; tını puanını (VFP), doğallık puanını ve ortalama temel frekansı uygulamanın formül ve kurallarıyla birleştirir. Cinsiyeti, yeteneği veya ses sağlığını belirlemez. Hedefinizi hâlâ keşfediyorsanız duyduğunuz sesi ve sesinizle ilgili hislerinizi rehber alın; daha yüksek puan hedefiniz olmak zorunda değildir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Загальна оцінка поєднує оцінку тембру (VFP), природність і середню основну частоту за формулами та правилами застосунку. Вона не визначає гендер, здібності чи здоров’я голосу. Якщо ви ще шукаєте свою мету, орієнтуйтеся на звучання й власні відчуття; вища оцінка не обов’язково має бути вашою метою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Điểm tổng hợp kết hợp điểm âm sắc (VFP), điểm độ tự nhiên và tần số cơ bản trung bình theo công thức và quy tắc của ứng dụng. Điểm không xác định giới, năng lực hay sức khỏe giọng nói. Nếu còn đang khám phá mục tiêu, hãy dựa vào điều bạn nghe và cảm giác khi nói; bạn không cần đặt mục tiêu đạt điểm cao hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "综合分按应用公式组合音色分（VFP）、自然分与平均基频，并按匹配规则处理。它不能判定性别、能力或嗓音健康。尚未确定目标时，可以依据自己的听感和舒适度探索，不必追求更高分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "綜合分按應用程式公式組合音色分（VFP）、自然分與平均基頻，並按符合的規則處理。它不能判定性別、能力或嗓音健康。尚未確定目標時，可以依據自己的聽感和舒適度探索，不必追求更高分。"
          }
        }
      }
    },
