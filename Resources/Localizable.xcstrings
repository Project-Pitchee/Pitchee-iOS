    "practice.suggestion.dailySpeech.detail" : {
      "comment" : "Voice practice interface. Keep actions concise; preserve metric names and format arguments.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "استبدل جملة التدريب المألوفة بكلام يومي، وحافظ على الراحة مع زيادة طوله تدريجيًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nahraďte známou cvičnou větu běžnou řečí a postupně ji prodlužujte tak, aby vám to bylo stále příjemné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erstat en velkendt øvelsessætning med hverdagstale, og gør den gradvist længere, mens stemmen føles behagelig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ersetze einen vertrauten Übungssatz durch alltägliche Sprache. Verlängere ihn schrittweise und achte darauf, dass es angenehm bleibt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Αντικαταστήστε μια γνώριμη φράση εξάσκησης με καθημερινή ομιλία και αυξήστε σταδιακά τη διάρκειά της με άνεση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replace a familiar practice sentence with everyday speech, staying comfortable as you gradually extend it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sustituye una frase de práctica conocida por una expresión cotidiana y alárgala poco a poco, manteniendo la comodidad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vaihda tuttu harjoituslause arkiseen ilmaisuun ja pidennä sitä vähitellen niin, että puhuminen tuntuu mukavalta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Remplacez une phrase d’exercice familière par une expression du quotidien, puis allongez-la progressivement en gardant votre confort."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "החליפו משפט תרגול מוכר בביטוי יומיומי, ושמרו על נוחות תוך הארכתו בהדרגה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "परिचित अभ्यास-वाक्य की जगह रोज़मर्रा की अभिव्यक्ति बोलें, सहज रहते हुए धीरे-धीरे उसे लंबा करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zamijenite poznatu rečenicu za vježbu svakodnevnim govorom i postupno je produžujte uz osjećaj ugode."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cserélje a megszokott gyakorlómondatot hétköznapi beszédre, és kényelmesen, fokozatosan növelje a hosszát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ganti kalimat latihan yang sudah akrab dengan ucapan sehari-hari, tetap nyaman sambil memperpanjangnya perlahan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sostituisci una frase di esercizio familiare con un’espressione quotidiana e allungala gradualmente, mantenendo il comfort."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "慣れた練習文を日常の表現に置き換え、楽な発声を保ちながら少しずつ長くしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "익숙한 연습 문장을 일상적인 표현으로 바꿔 보고, 편안함을 유지하며 조금씩 길게 말해 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gantikan ayat latihan yang biasa dengan ungkapan harian, kekalkan keselesaan sambil memanjangkannya sedikit demi sedikit."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vervang een vertrouwde oefenzin door alledaagse spraak en maak deze geleidelijk langer, zolang het comfortabel blijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zastąp znane zdanie do ćwiczeń codzienną wypowiedzią i stopniowo ją wydłużaj, zachowując komfort."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Troque uma frase de prática conhecida por uma expressão cotidiana e aumente sua extensão aos poucos, mantendo o conforto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Замените привычную тренировочную фразу повседневной речью и постепенно удлиняйте её, сохраняя комфорт."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Byt ut en välbekant övningsmening mot vardagligt tal och förläng den gradvis, så länge det känns bekvämt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "เปลี่ยนประโยคฝึกที่คุ้นเคยเป็นคำพูดในชีวิตประจำวัน รักษาความสบายแล้วค่อย ๆ พูดให้ยาวขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alıştığınız alıştırma cümlesini günlük bir ifadeyle değiştirin ve rahatlığı koruyarak yavaşça uzatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Замініть звичну тренувальну фразу повсякденним мовленням і поступово подовжуйте її, зберігаючи комфорт."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Thay câu luyện tập quen thuộc bằng lời nói hằng ngày, giữ cảm giác thoải mái rồi kéo dài dần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把熟悉的练习短句换成日常表达，保持轻松，再逐渐延长。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "把熟悉的練習短句換成日常表達，保持輕鬆，再逐漸延長。"
          }
        }
      }
    },
    "practice.suggestion.dailySpeech.title" : {
