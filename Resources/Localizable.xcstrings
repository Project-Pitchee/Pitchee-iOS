    "monitor.spectrum.readoutHint" : {
      "comment" : "Live audio monitoring. %@ placeholders are localized elapsed seconds where present.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "القمة هي أقوى مكوّن ترددي، وقد تختلف عن التردد الأساسي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vrchol je nejsilnější frekvenční složka a může se lišit od základní frekvence."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toppen er den stærkeste frekvenskomponent og kan afvige fra grundfrekvensen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Maximum ist der stärkste Frequenzanteil und kann von der Grundfrequenz abweichen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η κορυφή είναι η ισχυρότερη συνιστώσα συχνότητας και μπορεί να διαφέρει από τη θεμελιώδη συχνότητα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The peak is the strongest frequency component; it may differ from the fundamental frequency."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El pico es el componente de frecuencia más intenso y puede diferir de la frecuencia fundamental."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Huippu on voimakkain taajuuskomponentti, ja se voi poiketa perustaajuudesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le pic est la composante fréquentielle la plus forte ; il peut différer de la fréquence fondamentale."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "השיא הוא רכיב התדר החזק ביותר; הוא עשוי להיות שונה מתדר היסוד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "शिखर सबसे मज़बूत आवृत्ति घटक है; यह मूल आवृत्ति से अलग हो सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vrh je najjača frekvencijska komponenta i može se razlikovati od osnovne frekvencije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A csúcs a legerősebb frekvenciaösszetevő; eltérhet az alapfrekvenciától."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puncak adalah komponen frekuensi terkuat; nilainya dapat berbeda dari frekuensi dasar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il picco è la componente di frequenza più intensa e può differire dalla frequenza fondamentale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ピークは最も強い周波数成分で、基本周波数とは異なる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "피크는 가장 강한 주파수 성분이며 기본 주파수와 다를 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puncak ialah komponen frekuensi terkuat; ia mungkin berbeza daripada frekuensi asas."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De piek is de sterkste frequentiecomponent en kan afwijken van de grondfrequentie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Szczyt to najsilniejsza składowa częstotliwości; może różnić się od częstotliwości podstawowej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O pico é o componente de frequência mais forte e pode diferir da frequência fundamental."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Пик — самая сильная частотная составляющая; он может отличаться от основной частоты."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toppen är den starkaste frekvenskomponenten och kan skilja sig från grundfrekvensen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "จุดยอดคือองค์ประกอบความถี่ที่แรงที่สุด ซึ่งอาจแตกต่างจากความถี่มูลฐาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tepe, en güçlü frekans bileşenidir; temel frekanstan farklı olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Пік — найсильніша частотна складова; він може відрізнятися від основної частоти."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Đỉnh là thành phần tần số mạnh nhất và có thể khác với tần số cơ bản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
