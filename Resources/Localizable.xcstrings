    "export.chart.multiCurveGap.note" : {
      "comment" : "Explains gaps in the plotted lines when pitch and loudness curves are shown together.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الفراغات في المنحنيات تعني عدم وجود نتيجة موثوقة في تلك الفترة الزمنية؛ وتشترك جميع المنحنيات في المحور الزمني نفسه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prázdná místa v křivkách znamenají, že v daném úseku není spolehlivý výsledek; všechny křivky sdílejí stejnou časovou osu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Huller i kurverne betyder, at der ikke er et pålideligt resultat for det tidsrum; alle kurver bruger samme tidsakse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lücken in den Kurven bedeuten, dass für diesen Zeitraum kein verlässliches Ergebnis vorliegt; alle Kurven nutzen dieselbe Zeitachse."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Τα κενά στις καμπύλες σημαίνουν ότι δεν υπάρχει αξιόπιστο αποτέλεσμα για αυτό το διάστημα· όλες οι καμπύλες μοιράζονται τον ίδιο άξονα χρόνου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaps in the curves mean no reliable result for that time range; all curves share the same time axis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los espacios en blanco de las curvas indican que no hubo resultados confiables en ese intervalo; todas las curvas comparten el mismo eje de tiempo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
