    "practice.suggestion.pitchUnavailable.detail" : {
      "comment" : "Voice practice interface. Keep actions concise; preserve metric names and format arguments.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بيانات طبقة الصوت غير كافية. اقرأ مقطعًا بصوت مريح وحاول مجددًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Není dost údajů o výšce hlasu. Přečtěte úryvek pohodlným hlasem a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der er ikke nok tonehøjdedata. Læs en tekst med en behagelig stemme, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Es liegen nicht genug Tonhöhendaten vor. Lies einen Abschnitt mit angenehmer Stimme und versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Δεν υπάρχουν αρκετά δεδομένα τονικού ύψους. Διαβάστε ένα απόσπασμα με άνετη φωνή και δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is not enough pitch data. Read a passage in a comfortable voice and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No hay suficientes datos de tono. Lee un pasaje con una voz cómoda y vuelve a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sävelkorkeustietoja ei ole riittävästi. Lue katkelma mukavalla äänellä ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les données de hauteur sont insuffisantes. Lisez un passage avec une voix confortable et réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "אין מספיק נתוני גובה קול. קראו קטע בקול נוח ונסו שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "पिच का पर्याप्त डेटा नहीं है। सहज आवाज़ में एक अंश पढ़कर फिर कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nema dovoljno podataka o visini glasa. Pročitajte odlomak ugodnim glasom i pokušajte ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nincs elég hangmagassági adat. Olvasson fel egy szövegrészt kényelmes hangon, és próbálja újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Data nada belum cukup. Baca teks dengan suara nyaman dan coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I dati sul tono non sono sufficienti. Leggi un brano con una voce comoda e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "音高データが足りません。楽な声で文章を読んでから、もう一度試してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "음높이 데이터가 부족해요. 편안한 목소리로 문장을 읽고 다시 시도해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Data pic tidak mencukupi. Baca petikan dengan suara yang selesa dan cuba lagi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Er zijn onvoldoende toonhoogtegegevens. Lees een fragment met een comfortabele stem en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Brakuje wystarczających danych o wysokości głosu. Przeczytaj fragment wygodnym głosem i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Não há dados de altura suficientes. Leia um trecho com uma voz confortável e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Недостаточно данных о высоте голоса. Прочитайте отрывок комфортным голосом и повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Det finns inte tillräckligt med tonhöjdsdata. Läs ett stycke med en bekväm röst och försök igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ข้อมูลระดับเสียงไม่เพียงพอ อ่านข้อความด้วยเสียงที่สบายแล้วลองใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yeterli perde verisi yok. Rahat bir sesle bir metin parçası okuyup yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Недостатньо даних про висоту голосу. Прочитайте уривок комфортним голосом і спробуйте знову."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chưa đủ dữ liệu cao độ. Hãy đọc một đoạn bằng giọng thoải mái rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音高数据不足。用舒适的声音读一段话后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "音高資料不足。用舒適的聲音讀一段話後重試。"
          }
        }
      }
    },
