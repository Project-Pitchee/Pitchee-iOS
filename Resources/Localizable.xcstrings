    "voiceProfile.privacyPromise.recordingUsage.description" : {
      "comment" : "Explains retention: temporary audio is removed, only results persist.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تُحذف التسجيلات المؤقتة بعد التحليل؛ ويحتفظ السجل بنتائج التحليل فقط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dočasné nahrávky se po analýze mažou; historie uchovává jen výsledky analýzy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Midlertidige optagelser slettes efter analysen; historikken gemmer kun analyseresultaterne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Temporäre Aufnahmen werden nach der Analyse gelöscht; der Verlauf speichert nur die Analyseergebnisse."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Οι προσωρινές ηχογραφήσεις διαγράφονται μετά την ανάλυση· το ιστορικό κρατά μόνο τα αποτελέσματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recordings are analyzed on this device. Up to two audio takes are kept for playback during a practice and cleared when it ends, or at the next launch after a force quit. History keeps analysis metrics and practice details without audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las grabaciones temporales se eliminan después del análisis; el historial solo guarda los resultados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Väliaikaiset tallennukset poistetaan analyysin jälkeen; historiaan jäävät vain analyysin tulokset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les enregistrements temporaires sont supprimés après l’analyse ; l’historique ne conserve que les résultats."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הקלטות זמניות נמחקות לאחר הניתוח; ההיסטוריה שומרת רק את תוצאות הניתוח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अस्थायी रिकॉर्डिंग विश्लेषण के बाद हटा दी जाती है; इतिहास में सिर्फ़ विश्लेषण के नतीजे रहते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Privremene snimke brišu se nakon analize; povijest čuva samo rezultate analize."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az ideiglenes felvételek az elemzés után törlődnek; az előzmények csak az elemzési eredményeket őrzik meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rekaman sementara dihapus setelah analisis; riwayat hanya menyimpan hasil analisis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le registrazioni temporanee vengono eliminate dopo l'analisi; la cronologia conserva solo i risultati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "一時的な録音は分析後に削除され、履歴には分析結果だけが残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "분석이 끝나면 임시 녹음은 삭제하고, 기록에는 분석 결과만 저장해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rakaman sementara dipadamkan selepas analisis; sejarah hanya menyimpan hasil analisis."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tijdelijke opnames worden na de analyse verwijderd; de geschiedenis bewaart alleen de analyseresultaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tymczasowe nagrania są usuwane po analizie; historia przechowuje tylko wyniki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As gravações temporárias são excluídas após a análise; o histórico guarda apenas os resultados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Временные записи удаляются после анализа; в истории сохраняются только результаты."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tillfälliga inspelningar raderas efter analysen; historiken sparar bara analysresultaten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "การบันทึกเสียงชั่วคราวจะถูกลบหลังการวิเคราะห์ และประวัติจะเก็บเฉพาะผลการวิเคราะห์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Geçici kayıtlar analizden sonra silinir; geçmişte yalnızca analiz sonuçları saklanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Тимчасові записи видаляються після аналізу; в історії зберігаються лише результати аналізу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bản ghi tạm được xóa sau khi phân tích; lịch sử chỉ lưu kết quả phân tích."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录音只在本机分析。本次练习最多保留两段音频用于回听，结束后清理；强制退出后在下次启动时清理。历史保存分析指标与练习信息，不保留音频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分析結束後清理暫存錄音，歷史記錄僅儲存分析結果。"
          }
        }
      }
    },
