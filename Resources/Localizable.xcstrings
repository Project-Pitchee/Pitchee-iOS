          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只在這台裝置彙整分析結果類別、錄音長度、語音比例、音量位準估計和處理時間。診斷不儲存音訊、聲音特徵、分數或個別紀錄，也不會傳送這些摘要。"
          }
        }
      }
    },
