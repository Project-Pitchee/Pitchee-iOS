    "practice.suggestion.compareConditions.detail" : {
      "comment" : "Voice practice interface. Keep actions concise; preserve metric names and format arguments.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يختلف النموذج أو الإعدادات بين التحليلين. أعد المقارنة باستخدام الهدف والمقطع والظروف نفسها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Model nebo nastavení se liší. Porovnejte znovu se stejným cílem, úryvkem a podmínkami."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Modellen eller indstillingerne er forskellige. Sammenlign igen med samme mål, tekst og forhold."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Modell oder Einstellungen unterscheiden sich. Vergleiche erneut mit gleichem Ziel, gleichem Text und gleichen Bedingungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το μοντέλο ή οι ρυθμίσεις διαφέρουν. Συγκρίνετε ξανά με ίδιο στόχο, απόσπασμα και συνθήκες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The model or settings differ. Compare again with the same goal, passage, and conditions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El modelo o los ajustes son distintos. Compara de nuevo con el mismo objetivo, pasaje y condiciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Malli tai asetukset eroavat. Vertaa uudelleen samalla tavoitteella, tekstillä ja samoissa oloissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le modèle ou les réglages diffèrent. Recomparez avec le même objectif, le même passage et les mêmes conditions."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "המודל או ההגדרות שונים בין שני הניתוחים. השוו שוב עם אותה מטרה, אותו קטע ואותם תנאים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "दोनों विश्लेषणों में मॉडल या सेटिंग अलग हैं। एक ही लक्ष्य, अंश और स्थितियों में फिर तुलना करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Model ili postavke se razlikuju. Ponovno usporedite s istim ciljem, odlomkom i uvjetima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A modell vagy a beállítások eltérnek. Hasonlítsa össze újra azonos céllal, szöveggel és körülményekkel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Model atau pengaturan kedua analisis berbeda. Bandingkan lagi dengan tujuan, teks, dan kondisi yang sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il modello o le impostazioni sono diversi. Confronta di nuovo con lo stesso obiettivo, brano e condizioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "2回の分析でモデルや設定が異なります。同じ目標、文章、録音条件でもう一度比較してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "두 분석의 모델이나 설정이 달라요. 같은 목표와 문장, 녹음 조건으로 다시 비교해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Model atau tetapan kedua-dua analisis berbeza. Bandingkan semula dengan matlamat, petikan dan keadaan yang sama."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Het model of de instellingen verschillen. Vergelijk opnieuw met hetzelfde doel, fragment en dezelfde omstandigheden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Model lub ustawienia są inne. Porównaj ponownie przy tym samym celu, tekście i warunkach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O modelo ou as configurações são diferentes. Compare novamente com o mesmo objetivo, trecho e condições."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Модель или настройки различаются. Сравните снова с одной целью, тем же отрывком и в одинаковых условиях."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Modellen eller inställningarna skiljer sig. Jämför igen med samma mål, text och förhållanden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "โมเดลหรือการตั้งค่าของทั้งสองครั้งต่างกัน โปรดเปรียบเทียบใหม่โดยใช้เป้าหมาย ข้อความ และสภาพเดียวกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Model veya ayarlar farklı. Aynı hedef, metin ve koşullarla yeniden karşılaştırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Модель або налаштування відрізняються. Порівняйте знову з тією самою метою, уривком і умовами."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mô hình hoặc cài đặt giữa hai lần phân tích khác nhau. Hãy so sánh lại với cùng mục tiêu, đoạn đọc và điều kiện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两次分析的模型或设置不同。请使用相同目标、语句和条件重新比较。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "兩次分析的模型或設定不同。請使用相同目標、語句和條件重新比較。"
          }
        }
      }
    },
