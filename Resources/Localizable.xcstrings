            "value" : "เปรียบเทียบใหม่ในสภาพเดียวกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aynı koşullarda yeniden karşılaştırın"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Порівняйте знову за однакових умов"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "So sánh lại trong cùng điều kiện"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在相同条件下重新比较"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在相同條件下重新比較"
          }
        }
      }
    },
    "practice.suggestion.compareDrop.detail" : {
      "comment" : "Voice practice interface. Keep actions concise; preserve metric names and format arguments.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "انخفاض الدرجة مرة واحدة لا يثبت تقدمًا أو تراجعًا. استمع مجددًا وأعد القياس في الظروف نفسها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jediný pokles skóre nedokládá pokrok ani zhoršení. Poslechněte si nahrávku a opakujte za stejných podmínek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Et enkelt fald i scoren beviser hverken fremgang eller tilbagegang. Lyt igen, og gentag under de samme forhold."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein einzelner Rückgang des Werts belegt weder Fortschritt noch Rückschritt. Höre dir die Aufnahmen an und wiederhole den Vergleich unter gleichen Bedingungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Μία πτώση της βαθμολογίας δεν αποδεικνύει πρόοδο ή οπισθοδρόμηση. Ακούστε ξανά και επαναλάβετε στις ίδιες συνθήκες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One score decrease does not establish progress or regression. Listen back and repeat under the same conditions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una sola bajada de puntuación no demuestra progreso ni retroceso. Escucha y repite en las mismas condiciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yksi pistemäärän lasku ei osoita edistymistä tai taantumista. Kuuntele ja toista samoissa oloissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une seule baisse du score ne démontre ni progrès ni régression. Réécoutez et recommencez dans les mêmes conditions."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ירידה אחת בציון אינה מוכיחה התקדמות או נסיגה. האזינו שוב וחזרו על המדידה באותם תנאים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "एक बार स्कोर घटने से प्रगति या गिरावट तय नहीं होती। पहले सुनें, फिर समान स्थितियों में दोबारा मापें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jedan pad ocjene ne dokazuje napredak ni nazadovanje. Poslušajte snimku i ponovite u istim uvjetima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Egyetlen pontszámcsökkenés nem bizonyít fejlődést vagy visszaesést. Hallgassa vissza, és ismételje meg azonos körülmények között."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Satu penurunan skor tidak membuktikan kemajuan atau kemunduran. Dengarkan kembali dan ukur ulang dalam kondisi yang sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un solo calo di punteggio non dimostra progressi né regressi. Riascolta e ripeti nelle stesse condizioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "1回のスコア低下だけでは上達や後退は判断できません。聞き返してから、同じ条件でもう一度測定しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "점수가 한 번 내려갔다고 발전이나 퇴보를 판단할 수는 없어요. 다시 들어 본 뒤 같은 조건에서 재측정해 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Satu penurunan skor tidak membuktikan kemajuan atau kemerosotan. Dengar semula dan uji lagi dalam keadaan yang sama."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eén lagere score bewijst geen vooruitgang of achteruitgang. Luister terug en herhaal onder dezelfde omstandigheden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jednorazowy spadek wyniku nie dowodzi postępu ani regresu. Odsłuchaj nagranie i powtórz w tych samych warunkach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uma queda isolada de pontuação não demonstra progresso nem retrocesso. Ouça e repita nas mesmas condições."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Одно снижение оценки не доказывает прогресс или регресс. Прослушайте запись и повторите в тех же условиях."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En enda poängminskning bevisar varken framsteg eller tillbakagång. Lyssna och upprepa under samma förhållanden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "คะแนนลดลงครั้งเดียวไม่ยืนยันว่าก้าวหน้าหรือถอยหลัง ฟังย้อนแล้วทดสอบซ้ำในสภาพเดียวกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puanın bir kez düşmesi ilerleme veya gerileme olduğunu kanıtlamaz. Yeniden dinleyin ve aynı koşullarda tekrarlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Одне зниження оцінки не доводить прогресу чи регресу. Прослухайте запис і повторіть за тих самих умов."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Một lần giảm điểm không xác định được tiến bộ hay thụt lùi. Hãy nghe lại rồi đo lại trong cùng điều kiện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次分数下降不能确定进退步。先回听，再在相同条件下复测。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "一次分數下降不能確定進步或退步。先回聽，再在相同條件下複測。"
          }
        }
      }
    },
