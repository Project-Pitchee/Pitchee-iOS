        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Γνωρίστε τον εαυτό σας\nμέσα από τη φωνή σας"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
