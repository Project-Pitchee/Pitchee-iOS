    "insights.metric.compositeScore.description" : {
      "comment" : "Plain-language description of the composite score without making clinical claims.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تلخص النتيجة الإجمالية التحليل العام على مقياس 0–100. تابع الأنماط عبر عدة تسجيلات؛ فالنتيجة الواحدة لا تعكس جميع صفات الصوت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Celkové skóre shrnuje analýzu na stupnici 0–100. Sledujte změny v několika nahrávkách; jedno skóre nezachycuje všechny vlastnosti hlasu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Den samlede score opsummerer analysen på en skala fra 0 til 100. Se efter mønstre på tværs af optagelser; én score beskriver ikke alle en stemmes egenskaber."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Gesamtbewertung fasst die Analyse auf einer Skala von 0 bis 100 zusammen. Achte auf Entwicklungen über mehrere Aufnahmen hinweg; eine einzelne Bewertung erfasst nicht alle Eigenschaften einer Stimme."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η συνολική βαθμολογία συνοψίζει την ανάλυση σε κλίμακα 0–100. Αναζητήστε τάσεις σε πολλές εγγραφές· μία βαθμολογία δεν αποτυπώνει όλες τις ιδιότητες μιας φωνής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The composite score summarizes the overall analysis on a 0–100 scale. Look for patterns across recordings; one score does not capture every quality of a voice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El puntaje general resume el análisis en una escala de 0–100. Observa los patrones entre grabaciones; un solo puntaje no refleja todas las cualidades de una voz."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kokonaispisteet tiivistävät analyysin asteikolla 0–100. Tarkastele useiden tallenteiden välisiä suuntauksia: yksi pistemäärä ei kuvaa äänen kaikkia ominaisuuksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le score global résume l’analyse sur une échelle de 0 à 100. Observez les tendances entre plusieurs enregistrements : un seul score ne représente pas toutes les qualités d’une voix."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הציון הכולל מסכם את תוצאות הניתוח בסולם 0–100. חפשו דפוסים לאורך כמה הקלטות; ציון יחיד אינו משקף את כל איכויות הקול."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कुल स्कोर, विश्लेषण के समग्र परिणाम को 0–100 के पैमाने पर दिखाता है। कई रिकॉर्डिंग में रुझान देखें; एक स्कोर आवाज़ की हर विशेषता नहीं बताता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ukupna ocjena sažima analizu na ljestvici 0–100. Prati promjene kroz više snimki; jedna ocjena ne opisuje sve osobine glasa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az összpontszám 0–100 közötti skálán foglalja össze az elemzést. Figyeld több felvétel mintázatait: egyetlen pontszám nem írja le a hang minden tulajdonságát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skor keseluruhan merangkum hasil analisis pada skala 0–100. Amati pola dari beberapa rekaman; satu skor tidak mencakup semua kualitas suara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il punteggio complessivo riassume l'analisi su una scala da 0 a 100. Osserva l'andamento tra più registrazioni: un solo punteggio non rappresenta tutte le qualità di una voce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "総合スコアは分析全体の結果を0～100で表します。複数の録音で変化を確認しましょう。1回のスコアだけで声のすべての特徴を表すことはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "종합 점수는 전체 분석 결과를 0~100으로 요약해요. 여러 녹음에서 나타나는 변화를 살펴보세요. 한 번의 점수로 목소리의 모든 특징을 알 수는 없어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skor keseluruhan merumuskan hasil analisis pada skala 0–100. Perhatikan corak merentas rakaman; satu skor tidak merangkumi setiap ciri suara."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De totaalscore vat de analyse samen op een schaal van 0–100. Kijk naar patronen in meerdere opnamen; één score omvat niet alle eigenschappen van een stem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wynik ogólny podsumowuje analizę w skali 0–100. Obserwuj zmiany w wielu nagraniach — jeden wynik nie oddaje wszystkich cech głosu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A pontuação geral resume a análise em uma escala de 0–100. Observe os padrões entre as gravações; uma única pontuação não representa todas as qualidades de uma voz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Общая оценка отражает результат анализа по шкале от 0 до 100. Следите за изменениями по нескольким записям: одна оценка не передаёт всех качеств голоса."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Totalpoängen sammanfattar analysen på en skala från 0 till 100. Titta efter mönster i flera inspelningar; en enda poäng beskriver inte alla egenskaper hos en röst."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "คะแนนรวมสรุปผลวิเคราะห์โดยรวมบนมาตรา 0–100 ควรดูแนวโน้มจากหลายบันทึกเสียง เพราะคะแนนครั้งเดียวไม่สามารถสะท้อนทุกคุณลักษณะของเสียงได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Genel puan, analizin genel sonucunu 0–100 ölçeğinde özetler. Kayıtlar arasındaki örüntülere bak; tek bir puan, sesin tüm özelliklerini yansıtmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Загальна оцінка підсумовує результат аналізу за шкалою від 0 до 100. Стежте за змінами в кількох записах: одна оцінка не відображає всіх якостей голосу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Điểm tổng hợp tóm tắt kết quả phân tích trên thang 0–100. Hãy theo dõi xu hướng qua nhiều bản ghi âm; một điểm số không thể hiện mọi đặc điểm của giọng nói."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "综合评分汇总声音分析的整体结果，范围为 0–100。结合多次录音观察变化，单次分数不代表声音的全部特点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "綜合評分彙總聲音分析的整體結果，範圍為 0–100。結合多次錄音觀察變化，單次分數不代表聲音的全部特點。"
          }
        }
      }
    },
    "insights.metric.dailyBest.description" : {
      "comment" : "Explains the common daily aggregation rule used by the home and metric detail pages.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يمثل كل يوم التسجيل ذو النتيجة الإجمالية الأعلى، ويُختار التسجيل الأحدث عند تساوي النتائج. تستخدم الرسوم والإحصاءات القيم الصالحة من هذه التسجيلات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Každý den zastupuje nahrávka s nejvyšším celkovým skóre; při shodě se vybere pozdější nahrávka. Grafy a statistiky používají platné hodnoty těchto nahrávek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hver dag repræsenteres af optagelsen med den højeste samlede score. Ved samme score bruges den seneste optagelse. Diagrammer og statistik bruger gyldige værdier fra disse optagelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jeder Tag wird durch die Aufnahme mit der höchsten Gesamtbewertung vertreten. Bei Gleichstand zählt die spätere Aufnahme. Diagramme und Statistiken verwenden die gültigen Werte dieser Aufnahmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Κάθε ημέρα εκπροσωπείται από την εγγραφή με την υψηλότερη συνολική βαθμολογία. Σε ισοβαθμία επιλέγεται η πιο πρόσφατη. Τα γραφήματα και τα στατιστικά χρησιμοποιούν έγκυρες τιμές από αυτές τις εγγραφές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each day is represented by the recording with the highest composite score, using the later recording to break ties. Charts and statistics use valid values from those recordings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada día se representa con la grabación de mayor puntaje general; en caso de empate, se usa la más reciente. Los gráficos y las estadísticas usan los valores válidos de esas grabaciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kutakin päivää edustaa tallenne, jolla on korkeimmat kokonaispisteet. Tasapisteissä käytetään myöhempää tallennetta. Kaaviot ja tilastot käyttävät näiden tallenteiden kelvollisia arvoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chaque jour est représenté par l’enregistrement ayant le meilleur score global ; en cas d’égalité, le plus récent est retenu. Les graphiques et statistiques utilisent ses valeurs valides."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "כל יום מיוצג על ידי ההקלטה בעלת הציון הכולל הגבוה ביותר; במקרה של שוויון נבחרת ההקלטה המאוחרת יותר. התרשימים והסטטיסטיקה משתמשים בערכים התקינים מהקלטות אלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हर दिन का प्रतिनिधित्व सबसे अधिक कुल स्कोर वाली रिकॉर्डिंग करती है; स्कोर बराबर होने पर बाद की रिकॉर्डिंग चुनी जाती है। चार्ट और आँकड़े इन्हीं रिकॉर्डिंग के मान्य मान इस्तेमाल करते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Svaki dan predstavlja snimka s najvišom ukupnom ocjenom; kod jednakih ocjena odabire se kasnija snimka. Grafikoni i statistike koriste valjane vrijednosti iz tih snimki."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Minden napot a legmagasabb összpontszámú felvétel képvisel; pontegyenlőségnél a későbbi felvétel számít. A diagramok és statisztikák ezeknek a felvételeknek az érvényes értékeit használják."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Setiap hari diwakili oleh rekaman dengan skor keseluruhan tertinggi. Jika skornya sama, rekaman yang lebih baru dipilih. Grafik dan statistik menggunakan nilai yang valid dari rekaman tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ogni giorno è rappresentato dalla registrazione con il punteggio complessivo più alto; in caso di parità si usa quella più recente. Grafici e statistiche usano i valori validi di queste registrazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "各日は総合スコアが最も高い録音で代表し、同点の場合は後の録音を選びます。グラフと統計には、その代表録音の有効な値を使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "각 날짜에서 종합 점수가 가장 높은 녹음을 대표로 선택하며, 점수가 같으면 나중 녹음을 선택해요. 차트와 통계에는 해당 녹음의 유효한 값만 사용해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Setiap hari diwakili oleh rakaman dengan skor keseluruhan tertinggi. Jika skornya sama, rakaman yang lebih lewat dipilih. Carta dan statistik menggunakan nilai yang sah daripada rakaman tersebut."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elke dag wordt vertegenwoordigd door de opname met de hoogste totaalscore; bij gelijke scores wordt de latere opname gebruikt. Grafieken en statistieken gebruiken geldige waarden uit die opnamen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Każdy dzień reprezentuje nagranie z najwyższym wynikiem ogólnym; przy remisie wybierane jest późniejsze nagranie. Wykresy i statystyki korzystają z prawidłowych wartości tych nagrań."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada dia é representado pela gravação com a maior pontuação geral; em caso de empate, é usada a mais recente. Os gráficos e as estatísticas usam os valores válidos dessas gravações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Каждый день представляет запись с самой высокой общей оценкой; при равенстве выбирается более поздняя запись. Графики и статистика используют корректные значения из этих записей."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Varje dag representeras av inspelningen med högst totalpoäng. Vid lika poäng används den senare inspelningen. Diagram och statistik använder giltiga värden från dessa inspelningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "แต่ละวันใช้บันทึกเสียงที่มีคะแนนรวมสูงสุดเป็นตัวแทน หากคะแนนเท่ากันจะเลือกบันทึกที่ใหม่กว่า กราฟและสถิติใช้ค่าที่ใช้ได้จากบันทึกเหล่านี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Her günü en yüksek genel puana sahip kayıt temsil eder; puanlar eşitse daha sonraki kayıt seçilir. Grafikler ve istatistikler bu kayıtların geçerli değerlerini kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Кожен день представляє запис із найвищою загальною оцінкою; за однакових оцінок вибирається пізніший запис. Графіки й статистика використовують дійсні значення з цих записів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mỗi ngày được đại diện bởi bản ghi âm có điểm tổng hợp cao nhất; nếu bằng điểm, chọn bản ghi âm muộn hơn. Biểu đồ và thống kê sử dụng các giá trị hợp lệ từ những bản ghi âm đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天选取综合评分最高的一次录音作为代表；同分时选取较晚的录音。图表和统计仅使用这些代表记录中的有效数值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天選取綜合評分最高的一次錄音作為代表；同分時選取較晚的錄音。圖表和統計僅使用這些代表記錄中的有效數值。"
          }
        }
      }
    },
