    "practice.passage.v1" : {
      "comment" : "Guided practice and comparison. Keep goals, model outputs, recording checks, and personal listening feedback distinct.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الطقس لطيف اليوم. أريد أن أتمهل وأن أنطق هذه الجمل براحة. بعد قليل، سأقرأها مجددًا وأستمع لألاحظ أي اختلافات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dnes je příjemné počasí. Chci trochu zpomalit a pohodlně vyslovit tyto věty. Za chvíli si je přečtu znovu a poslechnu si, jestli jsou v nich nějaké rozdíly."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vejret er behageligt i dag. Jeg vil sætte tempoet ned og sige disse sætninger på en behagelig måde. Om lidt læser jeg dem igen og lytter efter forskelle."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Wetter ist heute angenehm. Ich möchte langsamer werden und diese Sätze entspannt aussprechen. Gleich lese ich sie noch einmal und höre auf mögliche Unterschiede."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ο καιρός είναι ευχάριστος σήμερα. Θέλω να επιβραδύνω λίγο και να πω αυτές τις προτάσεις άνετα. Σε λίγο θα τις διαβάσω ξανά και θα ακούσω αν υπάρχουν διαφορές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The weather feels pleasant today. I want to slow down and say these sentences comfortably. In a moment, I will read them again and listen for any differences."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hoy hace un tiempo agradable. Quiero ir más despacio y decir estas frases con comodidad. Dentro de un momento, las leeré otra vez y escucharé si hay diferencias."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sää tuntuu tänään miellyttävältä. Haluan hidastaa tahtia ja sanoa nämä lauseet mukavasti. Hetken kuluttua luen ne uudelleen ja kuuntelen, kuuluuko eroja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il fait bon aujourd’hui. Je veux ralentir et prononcer ces phrases confortablement. Dans un instant, je les relirai et j’écouterai les différences éventuelles."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "מזג האוויר נעים היום. אני רוצה להאט ולומר את המשפטים האלה בנוחות. בעוד רגע אקרא אותם שוב ואקשיב להבדלים, אם יהיו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आज मौसम सुहाना लग रहा है। मेरा मन है कि थोड़ा धीमा होकर ये वाक्य आराम से बोलूँ। कुछ देर में इन्हें फिर पढ़ना और सुनना है कि कोई अंतर है या नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Danas je vrijeme ugodno. Želim malo usporiti i opušteno izgovoriti ove rečenice. Za trenutak ću ih ponovno pročitati i poslušati ima li razlike."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ma kellemes az idő. Szeretnék lelassítani, és kényelmesen kimondani ezeket a mondatokat. Egy pillanat múlva újra elolvasom őket, és meghallgatom, van-e különbség."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cuaca hari ini terasa menyenangkan. Saya ingin melambat dan mengucapkan kalimat-kalimat ini dengan nyaman. Sebentar lagi, saya akan membacanya lagi dan mendengarkan apakah ada perbedaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oggi il tempo è piacevole. Voglio rallentare e pronunciare queste frasi senza sforzo. Tra poco le leggerò di nuovo e ascolterò se ci sono differenze."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "今日は気持ちのよい天気です。少しゆっくり、楽にこの文章を読んでみます。少ししたらもう一度読んで、どんな違いがあるか聞いてみます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "오늘은 날씨가 참 좋아요. 조금 천천히, 편안하게 이 문장들을 말해 보려고 해요. 잠시 후에 다시 읽고 어떤 차이가 있는지 들어 볼 거예요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cuaca hari ini terasa nyaman. Saya mahu memperlahankan rentak dan menyebut ayat-ayat ini dengan selesa. Sebentar lagi, saya akan membacanya semula dan mendengar jika ada perbezaan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Het weer voelt aangenaam vandaag. Ik wil het rustiger aan doen en deze zinnen op een comfortabele manier uitspreken. Zo meteen lees ik ze opnieuw en luister ik of er verschillen zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dzisiaj jest przyjemna pogoda. Chcę trochę zwolnić i swobodnie wypowiedzieć te zdania. Za chwilę przeczytam je ponownie i posłucham, czy słychać różnice."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O tempo está agradável hoje. Quero desacelerar e dizer estas frases com conforto. Daqui a pouco, vou lê-las de novo e ouvir se há alguma diferença."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сегодня приятная погода. Я хочу немного замедлиться и спокойно произнести эти предложения. Через некоторое время я прочитаю их снова и послушаю, есть ли разница."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vädret känns behagligt i dag. Jag vill sakta ner och säga de här meningarna på ett bekvämt sätt. Om en stund läser jag dem igen och lyssnar efter skillnader."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "วันนี้อากาศดี ฉันอยากค่อย ๆ พูดประโยคเหล่านี้อย่างสบาย อีกสักครู่ฉันจะอ่านซ้ำและฟังว่ามีอะไรแตกต่างไปบ้าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bugün hava çok hoş. Biraz yavaşlamak ve bu cümleleri rahatça söylemek istiyorum. Birazdan onları yeniden okuyup bir fark olup olmadığını dinleyeceğim."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сьогодні приємна погода. Я хочу трохи сповільнитися й спокійно вимовити ці речення. За мить я прочитаю їх знову й послухаю, чи є відмінності."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hôm nay thời tiết thật dễ chịu. Tôi muốn chậm lại và nói những câu này một cách thoải mái. Lát nữa, tôi sẽ đọc lại và lắng nghe xem có gì khác biệt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天的天气很舒服。我想放慢一点，轻松地说完这几句话。等一会儿，我会再读一次，听听两次有什么不同。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天天氣很舒服。我想放慢步調，輕鬆地說出這幾句話。等一下，我會再讀一次，聽聽有什麼不同。"
          }
        }
      }
    },
