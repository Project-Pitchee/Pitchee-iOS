    "recording.timeline.static.description" : {
      "comment" : "Explanation beside the static pitch display used with reduced motion or Assistive Access.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تُعرض طبقة الصوت كرقم. افتح بيانات طبقة الصوت الأخيرة لاستكشاف قيم الرسم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Výška hlasu se zobrazuje jako číslo. Otevřete poslední údaje o výšce hlasu a prohlédněte si hodnoty grafu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tonehøjde vises som et tal. Åbn de seneste tonehøjdedata for at udforske diagrammets værdier."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Tonhöhe wird als Zahl angezeigt. Öffne die aktuellen Tonhöhendaten, um die Diagrammwerte zu erkunden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το ύψος εμφανίζεται ως αριθμός. Ανοίξτε τα πρόσφατα δεδομένα ύψους για να εξερευνήσετε τις τιμές του γραφήματος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitch is shown as a number. Open recent pitch data to explore the chart values."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El tono se muestra como un número. Abre los datos recientes de tono para explorar los valores del gráfico."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sävelkorkeus näytetään lukuna. Avaa viimeisimmät sävelkorkeustiedot tutkiaksesi kaavion arvoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
