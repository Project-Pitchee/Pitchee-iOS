        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Místní porovnání skóre se zastavilo. Některá data možná nebyla vymazána. Odemkněte zařízení a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lokal scoresammenligning er stoppet. Nogle data er muligvis ikke blevet ryddet. Lås enheden op, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der lokale Bewertungsvergleich wurde angehalten. Einige Daten wurden möglicherweise nicht gelöscht. Entsperre das Gerät und versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η τοπική σύγκριση βαθμολογιών σταμάτησε. Ορισμένα δεδομένα ενδέχεται να μην έχουν διαγραφεί. Ξεκλειδώστε τη συσκευή και δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local score comparison has stopped. Some data may not have been cleared. Unlock the device and try again."
