    "recording.timeline.history.description" : {
      "comment" : "Explanation of stable chart data and unvoiced gaps.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "هذه لقطة للثواني الثلاث الأخيرة وقت الفتح. لا تُحدَّث أثناء قراءتك. تُعلّم الفترات التي لم تُكتشف فيها طبقة صوت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jde o snímek posledních tří sekund v okamžiku otevření. Během čtení se neaktualizuje. Úseky bez rozpoznané výšky hlasu jsou označené."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dette er et øjebliksbillede af de sidste tre sekunder, når det åbnes. Det opdateres ikke, mens du læser. Intervaller uden registreret tonehøjde er markeret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dies ist eine Momentaufnahme der letzten drei Sekunden beim Öffnen. Sie wird beim Lesen nicht aktualisiert. Abschnitte ohne erkannte Tonhöhe sind markiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Αυτό είναι ένα στιγμιότυπο των τελευταίων τριών δευτερολέπτων κατά το άνοιγμα. Δεν ενημερώνεται όσο διαβάζετε. Σημειώνονται τα διαστήματα χωρίς ανιχνευμένο ύψος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is a snapshot of the last three seconds when opened. It does not update while you read. Intervals without detected pitch are marked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta es una instantánea de los últimos tres segundos al abrirla. No se actualiza mientras la lees. Los intervalos sin tono detectado están marcados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tämä on tilannekuva avaamista edeltäneistä kolmesta sekunnista. Se ei päivity lukemisen aikana. Jaksot, joilla sävelkorkeutta ei havaittu, on merkitty."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il s’agit d’un instantané des trois dernières secondes au moment de l’ouverture. Il ne se met pas à jour pendant la lecture. Les intervalles sans hauteur détectée sont indiqués."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "זו תמונת מצב של שלוש השניות האחרונות בזמן הפתיחה. היא אינה מתעדכנת בזמן הקריאה. מקטעים ללא טון מזוהה מסומנים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "यह खोलते समय पिछले तीन सेकंड का स्नैपशॉट है। आपके पढ़ते समय यह अपडेट नहीं होता। जिन अंतरालों में पिच नहीं मिली, उन्हें चिह्नित किया जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ovo je presjek posljednjih triju sekundi u trenutku otvaranja. Ne ažurira se dok čitaš. Označeni su intervali bez prepoznate visine."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ez a megnyitást megelőző három másodperc pillanatképe. Olvasás közben nem frissül. Az észlelt hangmagasság nélküli szakaszok jelölve vannak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ini adalah cuplikan tiga detik terakhir saat dibuka. Data tidak diperbarui selama Anda membaca. Interval tanpa nada yang terdeteksi ditandai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Questa è un'istantanea degli ultimi tre secondi al momento dell'apertura. Non si aggiorna mentre la leggi. Gli intervalli senza tono rilevato sono indicati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "これは開いた時点での直近3秒間のデータです。読んでいる間は更新されません。音高を検出できなかった区間も示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "열었을 때의 마지막 3초를 캡처한 데이터예요. 읽는 동안에는 업데이트되지 않아요. 음높이가 감지되지 않은 구간도 표시돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ini ialah petikan data tiga saat terakhir ketika dibuka. Ia tidak dikemas kini semasa anda membaca. Sela tanpa pic yang dikesan ditandakan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dit is een momentopname van de laatste drie seconden bij het openen. Ze wordt niet bijgewerkt terwijl je leest. Intervallen zonder gedetecteerde toonhoogte zijn gemarkeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "To migawka ostatnich trzech sekund w chwili otwarcia. Nie aktualizuje się podczas czytania. Odcinki bez wykrytej wysokości są oznaczone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta é uma captura dos últimos três segundos no momento da abertura. Ela não se atualiza enquanto você lê. Os intervalos sem altura detectada são marcados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Это снимок последних трёх секунд на момент открытия. Во время чтения он не обновляется. Интервалы без обнаруженной высоты тона отмечены."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Det här är en ögonblicksbild av de senaste tre sekunderna när den öppnas. Den uppdateras inte medan du läser. Intervall utan upptäckt tonhöjd är markerade."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "นี่คือภาพข้อมูลสามวินาทีสุดท้าย ณ เวลาที่เปิด ข้อมูลจะไม่อัปเดตระหว่างที่คุณอ่าน ช่วงที่ตรวจไม่พบระดับเสียงจะมีเครื่องหมายกำกับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bu, açıldığı andaki son üç saniyenin görüntüsüdür. Okurken güncellenmez. Perde algılanmayan aralıklar işaretlenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Це знімок останніх трьох секунд на час відкриття. Під час читання він не оновлюється. Інтервали без виявленої висоти тону позначені."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Đây là ảnh chụp dữ liệu ba giây cuối tại thời điểm mở. Dữ liệu không cập nhật khi bạn đọc. Các khoảng không phát hiện được cao độ được đánh dấu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此列表是打开时最近三秒的音高快照，不会在阅读时自动更新。未检测到音高的时段会单独标明。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是開啟時最近三秒的資料快照，閱讀期間不會更新。未偵測到音高的區間會加以標示。"
          }
        }
      }
    },
