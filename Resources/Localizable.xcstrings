    "monitor.spectrogram.readoutHint" : {
      "comment" : "Reading guidance for a spectrogram. Time runs left to right in all interface languages.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يتقدم الزمن من اليسار إلى اليمين. تظهر الترددات المنخفضة في الأسفل؛ وتشير الألوان الأكثر سطوعًا إلى إشارة أقوى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Čas plyne zleva doprava. Nízké frekvence jsou dole; jasnější barvy znamenají silnější signál."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tiden går fra venstre mod højre. Lave frekvenser er nederst; lysere farver betyder et stærkere signal."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Zeit verläuft von links nach rechts. Tiefe Frequenzen sind unten; hellere Farben bedeuten ein stärkeres Signal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ο χρόνος προχωρά από αριστερά προς τα δεξιά. Οι χαμηλές συχνότητες βρίσκονται στο κάτω μέρος· τα πιο φωτεινά χρώματα σημαίνουν ισχυρότερο σήμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time runs left to right. Low frequencies are at the bottom; brighter colors mean a stronger signal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El tiempo avanza de izquierda a derecha. Las frecuencias bajas están abajo; los colores más brillantes indican una señal más intensa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aika kulkee vasemmalta oikealle. Matalat taajuudet ovat alhaalla; kirkkaammat värit tarkoittavat voimakkaampaa signaalia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le temps s’écoule de gauche à droite. Les basses fréquences sont en bas ; les couleurs plus vives indiquent un signal plus fort."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הזמן מתקדם משמאל לימין. התדרים הנמוכים נמצאים למטה; צבעים בהירים יותר מציינים אות חזק יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "समय बाएँ से दाएँ बढ़ता है। कम आवृत्तियाँ नीचे होती हैं; अधिक चमकीले रंग अधिक मज़बूत सिग्नल दर्शाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vrijeme teče slijeva nadesno. Niske frekvencije su pri dnu; svjetlije boje označavaju jači signal."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az idő balról jobbra halad. Az alacsony frekvenciák alul vannak; a világosabb színek erősebb jelet jelentenek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Waktu bergerak dari kiri ke kanan. Frekuensi rendah berada di bawah; warna yang lebih cerah menunjukkan sinyal yang lebih kuat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il tempo scorre da sinistra a destra. Le frequenze basse sono in basso; i colori più luminosi indicano un segnale più forte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "時間は左から右へ進みます。低い周波数は下に表示され、色が明るいほど信号が強いことを示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "시간은 왼쪽에서 오른쪽으로 흐릅니다. 낮은 주파수는 아래쪽에 표시되며, 색이 밝을수록 신호가 강합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Masa bergerak dari kiri ke kanan. Frekuensi rendah berada di bawah; warna yang lebih terang menunjukkan isyarat yang lebih kuat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De tijd loopt van links naar rechts. Lage frequenties staan onderaan; helderdere kleuren betekenen een sterker signaal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Czas biegnie od lewej do prawej. Niskie częstotliwości są na dole; jaśniejsze kolory oznaczają silniejszy sygnał."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O tempo avança da esquerda para a direita. As frequências baixas ficam na parte inferior; cores mais claras indicam um sinal mais forte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Время идёт слева направо. Низкие частоты находятся внизу; чем ярче цвет, тем сильнее сигнал."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tiden går från vänster till höger. Låga frekvenser visas längst ned; ljusare färger betyder en starkare signal."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "เวลาเคลื่อนจากซ้ายไปขวา ความถี่ต่ำอยู่ด้านล่าง และสีที่สว่างกว่าหมายถึงสัญญาณที่แรงกว่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zaman soldan sağa ilerler. Düşük frekanslar alttadır; daha parlak renkler daha güçlü bir sinyal anlamına gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Час іде зліва направо. Низькі частоти розташовані внизу; що яскравіший колір, то сильніший сигнал."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Thời gian chạy từ trái sang phải. Tần số thấp nằm ở phía dưới; màu càng sáng thì tín hiệu càng mạnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时间从左向右展开，低频在下、高频在上；颜色越亮，信号越强。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間由左向右展開，低頻在下、高頻在上；顏色越亮，訊號越強。"
          }
        }
      }
    },
