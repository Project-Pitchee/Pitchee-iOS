    "practice.suggestion.listen.detail" : {
      "comment" : "Voice practice interface. Keep actions concise; preserve metric names and format arguments.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "كرر الجملة نفسها بسرعة ومسافة من الميكروفون متقاربتين، ثم استمع إلى تغير واحد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zopakujte stejnou větu podobným tempem a ze stejné vzdálenosti od mikrofonu. Pak poslechem vyberte jednu změnu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gentag den samme sætning med lignende tempo og mikrofonafstand, og lyt efter én ændring."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wiederhole denselben Satz mit ähnlichem Tempo und Mikrofonabstand. Achte beim Anhören auf eine Veränderung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Επαναλάβετε την ίδια πρόταση με παρόμοιο ρυθμό και απόσταση από το μικρόφωνο και ακούστε για μία αλλαγή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repeat the same sentence at a similar pace and microphone distance, then listen for one change."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Repite la misma frase a un ritmo y una distancia al micrófono similares, y escucha un solo cambio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toista sama lause samankaltaisella nopeudella ja mikrofonietäisyydellä. Kuuntele sitten yhtä muutosta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Répétez la même phrase à un rythme et une distance du microphone similaires, puis écoutez un seul changement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "חזרו על אותו משפט בקצב ובמרחק דומים מהמיקרופון, ואז הקשיבו לשינוי אחד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "वही वाक्य मिलती-जुलती गति और माइक्रोफ़ोन की दूरी पर दोहराएँ, फिर एक बदलाव पर ध्यान देकर सुनें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ponovite istu rečenicu sličnim tempom i s iste udaljenosti od mikrofona, zatim poslušajte jednu promjenu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ismételje ugyanazt a mondatot hasonló tempóval és mikrofontávolságból, majd hallgasson meg egy változást."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ulangi kalimat yang sama dengan tempo dan jarak mikrofon serupa, lalu dengarkan satu perubahan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ripeti la stessa frase con ritmo e distanza dal microfono simili, poi ascolta un solo cambiamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "同じ文章を近い速さとマイク距離で繰り返し、1つの変化に注目して聞き返しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "같은 문장을 비슷한 속도와 마이크 거리로 반복한 뒤, 변화 하나에 집중해 들어 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ulang ayat yang sama dengan kadar dan jarak mikrofon yang serupa, kemudian dengar satu perubahan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Herhaal dezelfde zin met een vergelijkbaar tempo en dezelfde microfoonafstand. Luister vervolgens naar één verandering."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Powtórz to samo zdanie w podobnym tempie i z tej samej odległości od mikrofonu, a następnie posłuchaj jednej zmiany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Repita a mesma frase com ritmo e distância do microfone semelhantes e ouça uma única mudança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Повторите ту же фразу в похожем темпе и на том же расстоянии от микрофона, затем найдите на слух одно изменение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Upprepa samma mening med liknande tempo och mikrofonavstånd. Lyssna sedan efter en förändring."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "พูดประโยคเดิมด้วยจังหวะและระยะไมโครโฟนใกล้เคียงกัน แล้วฟังการเปลี่ยนแปลงหนึ่งอย่าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aynı cümleyi benzer hızda ve mikrofon mesafesinde tekrarlayın, ardından tek bir değişikliği dinleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Повторіть ту саму фразу в подібному темпі та з тієї самої відстані до мікрофона, а потім знайдіть на слух одну зміну."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lặp lại cùng một câu với tốc độ và khoảng cách micrô tương tự, rồi nghe để nhận ra một thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用同一句话、相近语速和麦克风距离复测，回听一个变化。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "用同一句話、相近語速和麥克風距離複測，回聽一個變化。"
          }
        }
      }
    },
    "practice.suggestion.masculineBasics.detail" : {
      "comment" : "Voice practice interface. Keep actions concise; preserve metric names and format arguments.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بطبقة مريحة، استخدم جملة قصيرة لاستكشاف رنين أعمق دون الضغط على الحلق أو إجبار طبقة الصوت على الانخفاض."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "V pohodlné výšce hlasu prozkoumejte na krátké větě hlubší rezonanci bez namáhání hrdla."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Brug en kort sætning i en behagelig tonehøjde til at udforske dybere resonans uden at presse halsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erkunde mit einem kurzen Satz und angenehmer Tonhöhe eine tiefere Resonanz, ohne den Hals anzuspannen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Σε άνετο τονικό ύψος, χρησιμοποιήστε μια σύντομη πρόταση για να εξερευνήσετε βαθύτερη αντήχηση χωρίς πίεση στον λαιμό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At a comfortable pitch, use a short sentence to explore deeper resonance without forcing your throat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Con un tono cómodo, usa una frase corta para explorar una resonancia más profunda sin forzar la garganta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tutki syvempää resonanssia lyhyellä lauseella ja mukavalla sävelkorkeudella pakottamatta kurkkua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "À une hauteur confortable, utilisez une courte phrase pour explorer une résonance plus profonde sans forcer la gorge."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "בגובה קול נוח, השתמשו במשפט קצר כדי לחקור תהודה עמוקה יותר, בלי ללחוץ על הגרון או לכפות הנמכת קול."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सहज पिच पर छोटा वाक्य बोलकर गहरे अनुनाद का अनुभव करें। गले पर दबाव न डालें और पिच ज़बरदस्ती नीचे न करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Na ugodnoj visini glasa kratkom rečenicom istražite dublju rezonanciju bez naprezanja grla."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kényelmes hangmagasságon, egy rövid mondattal fedezze fel a mélyebb rezonanciát, a torok erőltetése nélkül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dengan nada yang nyaman, gunakan kalimat pendek untuk menjelajahi resonansi lebih dalam tanpa menekan tenggorokan atau memaksa nada turun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Con un tono comodo, usa una frase breve per esplorare una risonanza più profonda senza forzare la gola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "楽な音高で短い文章を使い、より深い響きを探しましょう。喉を押さえたり無理に声を低くしたりしないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "편안한 음높이로 짧은 문장을 말하며 더 깊은 공명을 탐색해 보세요. 목을 누르거나 억지로 음을 낮추지 마세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pada pic yang selesa, gunakan ayat pendek untuk menerokai resonans yang lebih dalam tanpa menekan tekak atau memaksa pic turun."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verken met een korte zin een diepere resonantie op een comfortabele toonhoogte, zonder je keel te forceren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Na wygodnej wysokości głosu użyj krótkiego zdania, by odkrywać głębszy rezonans bez napinania gardła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Em uma altura confortável, use uma frase curta para explorar uma ressonância mais profunda sem forçar a garganta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "На комфортной высоте голоса исследуйте более глубокий резонанс в короткой фразе, не напрягая горло."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Använd en kort mening i en bekväm tonhöjd för att utforska djupare resonans utan att pressa halsen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ใช้ประโยคสั้นในระดับเสียงที่สบายเพื่อสำรวจการก้องกังวานที่ทุ้มขึ้น โดยไม่กดคอหรือฝืนลดระดับเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rahat bir perdede kısa bir cümleyle, boğazınızı zorlamadan daha derin rezonansı keşfedin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "На комфортній висоті голосу досліджуйте глибший резонанс у короткій фразі, не напружуючи горло."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Giữ cao độ thoải mái, dùng câu ngắn để khám phá cộng hưởng trầm hơn, không ép cổ họng hay cố hạ giọng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持舒适音高，用短句探索更沉稳的共鸣，避免压喉或强行降调。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "保持舒適音高，用短句探索更沉穩的共鳴，避免壓喉或強行降調。"
          }
        }
      }
    },
