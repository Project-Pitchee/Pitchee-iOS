    "practice.suggestion.oneElement.detail" : {
      "comment" : "Voice practice interface. Keep actions concise; preserve metric names and format arguments.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اختر طبقة الصوت أو الرنين أو التعبير لتدريب قصير، ثم افحص التغيرات باستخدام الجملة نفسها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pro krátké cvičení zvolte výšku hlasu, rezonanci nebo výraz a porovnávejte na stejné větě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vælg tonehøjde, resonans eller udtryk til en kort øvelse, og sammenlign med den samme sætning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wähle Tonhöhe, Resonanz oder Ausdruck für eine kurze Übung und vergleiche mit demselben Satz."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Επιλέξτε τονικό ύψος, αντήχηση ή έκφραση για σύντομη εξάσκηση και συγκρίνετε με την ίδια πρόταση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose pitch, resonance, or expression for a short practice, and compare using the same sentence."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elige tono, resonancia o expresión para una práctica breve y compara con la misma frase."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Valitse lyhyeen harjoitukseen sävelkorkeus, resonanssi tai ilmaisu ja vertaa samalla lauseella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Choisissez la hauteur, la résonance ou l’expression pour un exercice court, puis comparez avec la même phrase."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "בחרו גובה קול, תהודה או הבעה לתרגול קצר, ובדקו את השינוי באמצעות אותו משפט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "छोटे अभ्यास के लिए पिच, अनुनाद या अभिव्यक्ति में से एक चुनें और उसी वाक्य से बदलाव जाँचें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Za kratku vježbu odaberite visinu glasa, rezonanciju ili izražavanje i usporedite istom rečenicom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Egy rövid gyakorláshoz válassza a hangmagasságot, a rezonanciát vagy a kifejezésmódot, és ugyanazzal a mondattal hasonlítsa össze."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pilih nada, resonansi, atau ekspresi untuk latihan singkat, lalu periksa perubahannya dengan kalimat yang sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Scegli tono, risonanza o espressione per una breve pratica e confronta usando la stessa frase."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "音高、響き、表現から1つを選んで短く練習し、同じ文章で変化を確かめましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "음높이, 공명, 표현 중 하나를 골라 짧게 연습하고 같은 문장으로 변화를 확인해 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pilih pic, resonans atau penyampaian untuk latihan singkat, kemudian semak perubahan menggunakan ayat yang sama."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kies toonhoogte, resonantie of expressie voor een korte oefening en vergelijk met dezelfde zin."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Na krótkie ćwiczenie wybierz wysokość głosu, rezonans lub ekspresję i porównuj na tym samym zdaniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Escolha altura, ressonância ou expressão para uma prática breve e compare usando a mesma frase."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Выберите высоту, резонанс или выразительность для короткой практики и сравнивайте на одной фразе."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Välj tonhöjd, resonans eller uttryck för en kort övning och jämför med samma mening."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "เลือกระดับเสียง การก้องกังวาน หรือการแสดงออกอย่างใดอย่างหนึ่งเพื่อฝึกสั้น ๆ แล้วใช้ประโยคเดิมตรวจดูการเปลี่ยนแปลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kısa bir alıştırma için perdeyi, rezonansı veya ifadeyi seçin ve aynı cümleyle karşılaştırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Оберіть висоту, резонанс або виразність для короткої практики й порівнюйте на одній фразі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chọn cao độ, cộng hưởng hoặc cách diễn đạt để tập ngắn, rồi kiểm tra thay đổi bằng cùng một câu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从音高、共鸣或表达中选一项短练，用同一句话检查变化。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "從音高、共鳴或表達中選一項短練，用同一句話檢查變化。"
          }
        }
      }
    },
