    "settings.voicePreference.scoringNote" : {
      "comment" : "Direction-aware scoring copy.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يُحفظ اختيارك تلقائيًا. تتبع النتائج والتفسيرات اتجاه الصوت الذي تختاره."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Volba se ukládá automaticky. Skóre a vysvětlení odpovídají zvolenému směru hlasu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dit valg gemmes automatisk. Scorer og forklaringer følger den stemmeretning, du vælger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deine Auswahl wird automatisch gespeichert. Bewertungen und Erklärungen folgen deiner gewählten Stimmrichtung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η επιλογή σας αποθηκεύεται αυτόματα. Οι βαθμολογίες και οι εξηγήσεις ακολουθούν την κατεύθυνση φωνής που επιλέγετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your choice is saved automatically. Scores and explanations follow the voice direction you select."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu elección se guarda automáticamente. Los puntajes y las explicaciones siguen la orientación de voz que selecciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Valintasi tallennetaan automaattisesti. Pisteet ja selitykset noudattavat valitsemaasi äänen suuntaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Votre choix est enregistré automatiquement. Les scores et explications suivent la direction vocale choisie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הבחירה נשמרת אוטומטית. הציונים וההסברים תואמים לכיוון הקול שבחרתם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपकी पसंद अपने आप सेव होती है। स्कोर और स्पष्टीकरण आपकी चुनी हुई आवाज़ की दिशा के अनुसार होते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odabir se automatski sprema. Ocjene i objašnjenja prate odabrani smjer glasa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A választásod automatikusan mentésre kerül. A pontszámok és magyarázatok a kiválasztott hangirányt követik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pilihan Anda disimpan otomatis. Skor dan penjelasan mengikuti arah suara yang Anda pilih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La tua scelta viene salvata automaticamente. Punteggi e spiegazioni seguono l'orientamento vocale selezionato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "選択は自動的に保存されます。スコアと説明は、選んだ声の方向性に沿ったものになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "선택은 자동으로 저장돼요. 점수와 설명은 선택한 목소리 방향을 따라요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pilihan anda disimpan secara automatik. Skor dan penjelasan mengikut arah suara yang anda pilih."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je keuze wordt automatisch opgeslagen. Scores en uitleg volgen de stemrichting die je kiest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wybór jest zapisywany automatycznie. Wyniki i wyjaśnienia odpowiadają wybranemu kierunkowi głosu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sua escolha é salva automaticamente. As pontuações e explicações seguem a direção de voz selecionada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Выбор сохраняется автоматически. Оценки и пояснения соответствуют выбранному направлению голоса."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ditt val sparas automatiskt. Poäng och förklaringar följer den röstriktning du väljer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ตัวเลือกของคุณจะบันทึกอัตโนมัติ คะแนนและคำอธิบายจะอิงแนวเสียงที่คุณเลือก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seçimin otomatik kaydedilir. Puanlar ve açıklamalar seçtiğin ses yönünü izler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вибір зберігається автоматично. Оцінки й пояснення відповідають вибраному напряму голосу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lựa chọn của bạn được lưu tự động. Điểm và phần giải thích theo hướng giọng nói bạn chọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择会自动保存。评分和解释会跟随你选择的声音方向。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇會自動儲存。評分和解釋會跟隨你選擇的聲音方向。"
          }
        }
      }
    },
