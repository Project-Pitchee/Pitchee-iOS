    "practice.suggestion.captureEnvironment.detail" : {
      "comment" : "Voice practice interface. Keep actions concise; preserve metric names and format arguments.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يشير فحص التسجيل إلى أن انخفاض مستوى الإدخال أو ضوضاء الخلفية قد يؤثر في النتيجة. جرّب مكانًا أهدأ وحافظ على مسافة ثابتة من الميكروفون قبل إعادة التسجيل؛ لا حاجة إلى إجبار نفسك على رفع صوتك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kontrola nahrávky naznačuje, že ji může ovlivňovat tichý vstup nebo hluk v pozadí. Před dalším nahráváním zkuste tišší místo a stálou vzdálenost od mikrofonu; nemusíte nutit hlas do vyšší hlasitosti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kontrollen tyder på, at et svagt signal eller baggrundsstøj kan påvirke optagelsen. Find et roligere sted, og hold en fast afstand til mikrofonen, før du optager igen. Du behøver ikke presse stemmen til at tale højere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Aufnahmeprüfung deutet darauf hin, dass ein leises Eingangssignal oder Hintergrundgeräusche diese Aufnahme beeinflussen könnten. Suche einen ruhigeren Ort und halte einen gleichmäßigen Mikrofonabstand. Du musst nicht lauter sprechen als angenehm."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ο έλεγχος υποδεικνύει ότι η χαμηλή στάθμη εισόδου ή ο θόρυβος περιβάλλοντος μπορεί να επηρεάζουν τη λήψη. Δοκιμάστε πιο ήσυχο μέρος και σταθερή απόσταση από το μικρόφωνο πριν ηχογραφήσετε ξανά· δεν χρειάζεται να πιέσετε τη φωνή για μεγαλύτερη ένταση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The recording check suggests that quiet input or background noise may affect this take. Try a quieter place and a steady microphone distance before recording again; there is no need to force a louder voice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La comprobación indica que una entrada débil o el ruido de fondo pueden afectar esta toma. Busca un lugar más silencioso y mantén una distancia estable al micrófono antes de volver a grabar; no hace falta forzar la voz para hablar más alto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tarkistus viittaa siihen, että hiljainen tulosignaali tai taustamelu voi vaikuttaa tähän otokseen. Etsi rauhallisempi paikka ja pidä etäisyys mikrofoniin tasaisena ennen uutta äänitystä. Ääntä ei tarvitse pakottaa kovemmaksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le contrôle indique qu’un signal faible ou des bruits de fond peuvent affecter cette prise. Essayez un lieu plus calme et gardez une distance stable du microphone avant de réenregistrer, sans forcer le volume de votre voix."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "בדיקת ההקלטה מצביעה על כך שקלט חלש או רעש רקע עשויים להשפיע על התוצאה. נסו מקום שקט יותר ושמרו על מרחק קבוע מהמיקרופון לפני הקלטה חוזרת; אין צורך להכריח את הקול להיות חזק יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "रिकॉर्डिंग की जाँच के अनुसार धीमा इनपुट या आसपास का शोर नतीजे को प्रभावित कर सकता है। शांत जगह और माइक्रोफ़ोन से स्थिर दूरी रखकर दोबारा रिकॉर्ड करें; ज़ोर लगाकर ऊँचा बोलने की ज़रूरत नहीं है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Provjera snimke upućuje na to da tih ulaz ili pozadinska buka mogu utjecati na snimku. Prije ponovnog snimanja pokušajte na tišem mjestu i održavajte stalnu udaljenost od mikrofona; nema potrebe silom pojačavati glas."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az ellenőrzés szerint a halk bemenet vagy a háttérzaj befolyásolhatja ezt a felvételt. Új felvétel előtt próbáljon csendesebb helyet és állandó mikrofontávolságot; nem kell erőltetetten hangosabban beszélnie."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pemeriksaan rekaman menunjukkan input yang pelan atau derau latar mungkin memengaruhi hasil. Coba tempat yang lebih tenang dan jaga jarak mikrofon tetap stabil sebelum merekam ulang; tidak perlu memaksakan suara lebih keras."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il controllo indica che un ingresso debole o i rumori di fondo possono influire su questa prova. Cerca un luogo più silenzioso e mantieni una distanza stabile dal microfono prima di registrare di nuovo; non serve forzare la voce per alzare il volume."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "録音チェックでは、入力音量の小ささや背景音が結果に影響する可能性が示されました。静かな場所でマイクとの距離を一定にして録音し直しましょう。無理に声を大きくする必要はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "녹음 점검에서 작은 입력 음량이나 배경 소음이 결과에 영향을 줄 수 있는 것으로 나타났어요. 조용한 곳에서 마이크 거리를 일정하게 유지해 다시 녹음해 보세요. 억지로 목소리를 키울 필요는 없어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Semakan rakaman menunjukkan input perlahan atau bunyi latar mungkin mempengaruhi hasil. Cuba tempat lebih senyap dan kekalkan jarak mikrofon sebelum merakam semula; tidak perlu memaksa suara lebih kuat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De controle wijst erop dat een zacht ingangssignaal of achtergrondgeluid deze opname kan beïnvloeden. Zoek een stillere plek en houd een vaste microfoonafstand voordat je opnieuw opneemt. Je hoeft je stem niet te forceren om harder te spreken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kontrola wskazuje, że zbyt cichy sygnał lub szum tła mogą wpływać na nagranie. Przed kolejną próbą znajdź cichsze miejsce i zachowaj stałą odległość od mikrofonu; nie musisz na siłę zwiększać głośności głosu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A verificação sugere que um sinal baixo ou ruídos de fundo podem afetar esta tomada. Procure um local mais silencioso e mantenha uma distância estável do microfone antes de gravar novamente; não é preciso forçar a voz para falar mais alto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Проверка указывает, что тихий входной сигнал или фоновый шум могут влиять на запись. Перед повторной записью выберите более тихое место и сохраняйте постоянное расстояние до микрофона; специально говорить громче не нужно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kontrollen tyder på att en svag signal eller bakgrundsljud kan påverka tagningen. Hitta en tystare plats och håll ett jämnt mikrofonavstånd innan du spelar in igen. Du behöver inte pressa rösten för att tala högre."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "การตรวจสอบเสียงบันทึกพบว่าสัญญาณเบาหรือเสียงพื้นหลังอาจมีผลต่อผลลัพธ์ ลองหาที่เงียบขึ้นและรักษาระยะไมโครโฟนให้คงที่ก่อนบันทึกใหม่ ไม่จำเป็นต้องฝืนพูดให้ดังขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kayıt kontrolü, düşük giriş düzeyinin veya arka plan gürültüsünün bu kaydı etkileyebileceğini gösteriyor. Yeniden kaydetmeden önce daha sessiz bir yer deneyin ve mikrofona olan mesafeyi sabit tutun; sesinizi zorlayarak yükseltmenize gerek yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Перевірка вказує, що тихий вхідний сигнал або фоновий шум можуть впливати на цей запис. Перед повторним записом оберіть тихіше місце та зберігайте сталу відстань до мікрофона; навмисно говорити голосніше не потрібно."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kiểm tra bản ghi cho thấy tín hiệu nhỏ hoặc tiếng nền có thể ảnh hưởng đến kết quả. Hãy thử nơi yên tĩnh hơn, giữ khoảng cách micrô ổn định rồi ghi lại; không cần cố nói to hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录音检查提示输入偏轻或背景声可能影响结果。可以换到安静位置，保持稳定的麦克风距离后重录，无需刻意提高音量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "錄音檢查提示輸入偏輕或背景聲可能影響結果。可以換到安靜位置，保持穩定的麥克風距離後重錄，無需刻意提高音量。"
          }
        }
      }
    },
