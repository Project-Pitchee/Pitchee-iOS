    "scoreStudy.summary.interpretation.note" : {
      "comment" : "Optional local comparison of scoring rules against the person's self-rated practice goal. This is not gender identity or a claim of model accuracy. Nothing is uploaded.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تقارن هذه الميزة القرب من تقييمك الذاتي فقط. لا تثبت بضعة ردود ذاتية دقة النموذج أو الهوية الجندرية أو الصحة الصوتية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Porovnává se pouze blízkost vašemu sebehodnocení. Několik subjektivních odpovědí neurčuje přesnost modelu, genderovou identitu ani zdraví hlasu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dette sammenligner kun nærheden til din selvvurdering. Nogle få subjektive svar fastslår ikke modellens nøjagtighed, kønsidentitet eller stemmesundhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hier wird nur der Abstand zu deiner Selbsteinschätzung verglichen. Wenige subjektive Antworten belegen weder Modellgenauigkeit noch Geschlechtsidentität oder Stimmgesundheit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Συγκρίνεται μόνο η εγγύτητα στην αυτοαξιολόγησή σας. Λίγες υποκειμενικές απαντήσεις δεν τεκμηριώνουν την ακρίβεια του μοντέλου, την ταυτότητα φύλου ή την υγεία της φωνής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This compares proximity to your self-rating only. A few subjective responses do not establish model accuracy, gender identity, or vocal health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esto solo compara la cercanía a tu autoevaluación. Unas pocas respuestas subjetivas no demuestran la precisión del modelo ni determinan la identidad de género o la salud vocal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tässä verrataan vain läheisyyttä itsearviointiisi. Muutama subjektiivinen vastaus ei osoita mallin tarkkuutta eikä määritä sukupuoli-identiteettiä tai äänen terveyttä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cette comparaison porte uniquement sur la proximité avec votre autoévaluation. Quelques réponses subjectives ne permettent d’établir ni la précision du modèle, ni l’identité de genre, ni la santé vocale."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ההשוואה מתייחסת רק לקרבה להערכה העצמית שלכם. כמה תשובות סובייקטיביות אינן מבססות את דיוק המודל, הזהות המגדרית או בריאות הקול."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "यह केवल आपके स्व-मूल्यांकन से निकटता की तुलना करता है। कुछ व्यक्तिपरक प्रतिक्रियाएँ मॉडल की सटीकता, लैंगिक पहचान या आवाज़ के स्वास्थ्य को स्थापित नहीं करतीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uspoređuje se samo blizina tvojoj samoprocjeni. Nekoliko subjektivnih odgovora ne utvrđuje točnost modela, rodni identitet ni zdravlje glasa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ez csak az önértékelésedhez való közelséget hasonlítja össze. Néhány szubjektív válasz nem igazolja a modell pontosságát, és nem határozza meg a nemi identitást vagy a hang egészségét."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ini hanya membandingkan kedekatan dengan penilaian diri Anda. Beberapa respons subjektif tidak dapat membuktikan keakuratan model, identitas gender, atau kesehatan suara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il confronto riguarda solo la vicinanza alla tua autovalutazione. Poche risposte soggettive non dimostrano l'accuratezza del modello, né determinano l'identità di genere o la salute vocale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "これは自己評価への近さだけを比較します。少数の主観的な回答から、モデルの精度、性自認、声の健康状態を判断することはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "자기 평가와의 근접도만 비교해요. 소수의 주관적 응답으로 모델 정확도, 성별 정체성 또는 음성 건강을 판단할 수는 없어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ini hanya membandingkan kedekatan dengan penilaian kendiri anda. Beberapa respons subjektif tidak membuktikan ketepatan model, identiti jantina, atau kesihatan suara."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dit vergelijkt alleen de nabijheid tot je zelfbeoordeling. Een paar subjectieve antwoorden tonen geen modelnauwkeurigheid aan en bepalen geen genderidentiteit of stemgezondheid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Porównywana jest tylko bliskość do twojej samooceny. Kilka subiektywnych odpowiedzi nie pozwala ustalić dokładności modelu, tożsamości płciowej ani zdrowia głosu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Isto compara apenas a proximidade com sua autoavaliação. Algumas respostas subjetivas não comprovam a precisão do modelo nem determinam identidade de gênero ou saúde vocal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сравнивается только близость к вашей самооценке. Несколько субъективных ответов не позволяют определить точность модели, гендерную идентичность или здоровье голоса."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Detta jämför bara närheten till din självskattning. Ett fåtal subjektiva svar fastställer varken modellens noggrannhet, könsidentitet eller rösthälsa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "นี่เป็นเพียงการเปรียบเทียบความใกล้เคียงกับการประเมินตนเอง คำตอบตามความรู้สึกเพียงไม่กี่ครั้งไม่สามารถยืนยันความแม่นยำของโมเดล อัตลักษณ์ทางเพศ หรือสุขภาพเสียงได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bu yalnızca öz değerlendirmene yakınlığı karşılaştırır. Birkaç öznel yanıt, model doğruluğunu, cinsiyet kimliğini veya ses sağlığını belirlemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Порівнюється лише близькість до вашої самооцінки. Кілька суб’єктивних відповідей не визначають точність моделі, гендерну ідентичність чи здоров’я голосу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Việc này chỉ so sánh mức độ gần với tự đánh giá của bạn. Một vài phản hồi chủ quan không xác lập độ chính xác của mô hình, bản dạng giới hay sức khỏe giọng nói."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这里只比较与当次自评的接近程度。少量主观反馈不能证明模型更准确，也不能用于判断性别身份或发声健康。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這裡僅比較評分與自評的接近程度。少量主觀回覆無法證明模型準確度、性別認同或聲音健康狀況。"
          }
        }
      }
    },
