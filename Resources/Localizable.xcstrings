          "stringUnit" : {
            "state" : "needs_review",
            "value" : "คะแนนรวมใช้คะแนนน้ำเสียง (VFP) โดยตรง ซึ่งระบุเป็น Standard ในสูตรนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Genel puan, bu formülde Standard olarak adlandırılan tını puanını (VFP) doğrudan kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Загальна оцінка безпосередньо використовує оцінку тембру (VFP), позначену в цій формулі як Standard."
          }
        },
        "vi" : {
