    "practice.quality.scope" : {
      "comment" : "Guided practice and comparison. Keep goals, model outputs, recording checks, and personal listening feedback distinct.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "هذه فحوص أولية للتسجيل وليست تقييمًا لصحة الصوت. تصف نتائج النموذج وتجربتك في الاستماع أمورًا مختلفة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jde o předběžné kontroly podmínek nahrávání, nikoli o hodnocení zdraví hlasu. Skóre modelu a váš poslechový dojem popisují různé věci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dette er indledende optagelseskontroller, ikke en vurdering af stemmesundhed. Modellens scorer og din lytteoplevelse beskriver forskellige ting."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dies sind vorläufige Aufnahmeprüfungen, keine Beurteilung der Stimmgesundheit. Modellbewertungen und dein Höreindruck beschreiben unterschiedliche Dinge."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Αυτοί είναι προκαταρκτικοί έλεγχοι εγγραφής, όχι αξιολόγηση της υγείας της φωνής. Οι βαθμολογίες του μοντέλου και η εμπειρία ακρόασής σας περιγράφουν διαφορετικά πράγματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These are preliminary recording checks, not a voice health assessment. Model scores and your listening experience describe different things."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Estas son comprobaciones preliminares de grabación, no una evaluación de salud vocal. Los puntajes del modelo y tu experiencia al escuchar describen aspectos distintos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nämä ovat alustavia tallennustarkistuksia, eivät äänen terveyden arviointi. Mallin pisteet ja oma kuuntelukokemuksesi kuvaavat eri asioita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il s’agit de contrôles préliminaires de l’enregistrement, pas d’une évaluation de la santé vocale. Les scores du modèle et votre expérience d’écoute décrivent des choses différentes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "אלו בדיקות הקלטה ראשוניות, ולא הערכה של בריאות הקול. ציוני המודל וחוויית ההאזנה שלכם מתארים דברים שונים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ये रिकॉर्डिंग की प्रारंभिक जाँचें हैं, आवाज़ के स्वास्थ्य का आकलन नहीं। मॉडल के स्कोर और आपका सुनने का अनुभव अलग बातें बताते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ovo su preliminarne provjere uvjeta snimanja, a ne procjena zdravlja glasa. Ocjene modela i tvoj doživljaj slušanja opisuju različite stvari."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ezek előzetes felvételi ellenőrzések, nem a hang egészségének felmérése. A modell pontszámai és a hallgatási élményed különböző dolgokat írnak le."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ini adalah pemeriksaan awal rekaman, bukan penilaian kesehatan suara. Skor model dan pengalaman mendengarkan Anda menjelaskan hal yang berbeda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Questi sono controlli preliminari della registrazione, non una valutazione della salute vocale. I punteggi del modello e la tua esperienza d'ascolto descrivono aspetti diversi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "これらは録音条件の予備的なチェックであり、声の健康状態の評価ではありません。モデルのスコアと自分で聞いた印象は、それぞれ別の情報を示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "녹음 조건에 대한 예비 점검이며 음성 건강 평가가 아니에요. 모델 점수와 직접 들은 느낌은 서로 다른 정보를 나타내요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ini ialah semakan awal rakaman, bukan penilaian kesihatan suara. Skor model dan pengalaman pendengaran anda menerangkan perkara yang berbeza."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dit zijn voorlopige opnamecontroles, geen beoordeling van de gezondheid van je stem. Modelscores en je luisterervaring beschrijven verschillende dingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "To wstępne kontrole warunków nagrania, a nie ocena zdrowia głosu. Wyniki modelu i twoje wrażenia z odsłuchu opisują różne rzeczy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Estas são verificações preliminares da gravação, não uma avaliação de saúde vocal. As pontuações do modelo e sua experiência ao ouvir descrevem aspectos diferentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
