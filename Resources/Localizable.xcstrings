    "scoreStudy.settings.storageError.message" : {
      "comment" : "Optional local comparison of scoring rules against the person's self-rated practice goal. This is not gender identity or a claim of model accuracy. Nothing is uploaded.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "توقفت مقارنة النتائج محليًا. قد لا تكون بعض البيانات قد مُسحت. افتح قفل الجهاز وحاول مجددًا."
