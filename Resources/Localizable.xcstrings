        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La comparación local de puntajes se ha detenido. Es posible que algunos datos no se hayan borrado. Desbloquea el dispositivo e inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Paikallinen pistevertailu on pysähtynyt. Joitakin tietoja ei ehkä ole tyhjennetty. Avaa laitteen lukitus ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
