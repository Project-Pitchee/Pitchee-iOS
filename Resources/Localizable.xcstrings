    "practice.suggestion.captureUnavailable.detail" : {
      "comment" : "Voice practice interface. Keep actions concise; preserve metric names and format arguments.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "معلومات جودة التسجيل غير متوفرة. سجّل مقطعًا واضحًا قبل اختيار محور التدريب."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chybí údaje o kvalitě nahrávky. Než zvolíte zaměření cvičení, nahrajte zřetelný úryvek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der mangler oplysninger om optagelseskvaliteten. Optag et tydeligt tekststykke, før du vælger et øvelsesfokus."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Angaben zur Aufnahmequalität fehlen. Nimm einen klar verständlichen Abschnitt auf, bevor du einen Übungsschwerpunkt wählst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Λείπουν στοιχεία ποιότητας της ηχογράφησης. Ηχογραφήστε ένα καθαρό απόσπασμα πριν επιλέξετε σε τι θα εξασκηθείτε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recording-quality information is missing. Record a clear passage before choosing a practice focus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Falta información sobre la calidad de la grabación. Graba un pasaje claro antes de elegir un objetivo de práctica."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tallennuslaadun tiedot puuttuvat. Äänitä selkeä katkelma ennen harjoituskohteen valintaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les informations sur la qualité de l’enregistrement sont manquantes. Enregistrez un passage clair avant de choisir un axe de travail."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "חסר מידע על איכות ההקלטה. הקליטו קטע ברור לפני בחירת מוקד התרגול."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "रिकॉर्डिंग की गुणवत्ता की जानकारी नहीं है। अभ्यास का केंद्र चुनने से पहले स्पष्ट आवाज़ में एक अंश दोबारा रिकॉर्ड करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nedostaju podaci o kvaliteti snimke. Snimite jasan odlomak prije odabira fokusa vježbe."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hiányoznak a felvétel minőségére vonatkozó adatok. A gyakorlás fókuszának kiválasztása előtt rögzítsen egy tiszta szövegrészt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Informasi kualitas rekaman tidak tersedia. Rekam teks dengan jelas sebelum memilih fokus latihan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mancano le informazioni sulla qualità della registrazione. Registra un brano chiaro prima di scegliere su cosa esercitarti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "今回は録音品質の情報がありません。明瞭な声で文章を録音し直してから、練習の重点を選びましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이번 녹음에는 품질 정보가 없어요. 또렷한 목소리로 문장을 다시 녹음한 뒤 연습할 항목을 선택해 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Maklumat kualiti rakaman tiada. Rakam petikan yang jelas sebelum memilih fokus latihan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Informatie over de opnamekwaliteit ontbreekt. Neem een duidelijk fragment op voordat je een oefenfocus kiest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Brakuje informacji o jakości nagrania. Nagraj wyraźny fragment, zanim wybierzesz cel ćwiczeń."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Faltam informações sobre a qualidade da gravação. Grave um trecho claro antes de escolher um foco de prática."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Нет данных о качестве записи. Запишите чёткий отрывок, прежде чем выбирать направление практики."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Information om inspelningskvaliteten saknas. Spela in ett tydligt stycke innan du väljer ett övningsfokus."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ไม่มีข้อมูลคุณภาพการบันทึกในครั้งนี้ บันทึกข้อความด้วยเสียงชัดเจนใหม่ก่อนเลือกจุดเน้นในการฝึก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kayıt kalitesi bilgileri eksik. Alıştırma odağını seçmeden önce net bir konuşma bölümü kaydedin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Немає даних про якість запису. Запишіть чіткий уривок, перш ніж обирати напрям практики."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Thiếu thông tin chất lượng ghi âm. Hãy ghi lại một đoạn rõ tiếng trước khi chọn trọng tâm luyện tập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这次缺少录音质量信息。重新录一段清晰语音，再选择练习重点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "這次缺少錄音品質資訊。重新錄一段清晰語音，再選擇練習重點。"
          }
        }
      }
    },
