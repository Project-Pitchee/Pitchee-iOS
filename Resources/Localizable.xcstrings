    "practice.suggestion.pitchComfort.detail" : {
      "comment" : "Voice practice interface. Keep actions concise; preserve metric names and format arguments.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "كان متوسط طبقة الصوت مرتفعًا في هذا التسجيل. جرّب الجملة نفسها ضمن مجال أسهل وقارن الراحة وما تسمعه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Výška hlasu byla v tomto pokusu vysoká. Zkuste stejnou větu v pohodlnějším rozsahu a porovnejte pocit i zvuk."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Din tonehøjde var høj i denne optagelse. Prøv den samme sætning i et mere behageligt leje, og sammenlign følelsen og lyden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deine Tonhöhe war bei dieser Aufnahme hoch. Sprich denselben Satz in einem angenehmeren Bereich und vergleiche Stimmgefühl und Klang."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το τονικό ύψος ήταν υψηλό σε αυτή τη λήψη. Δοκιμάστε την ίδια πρόταση σε πιο άνετη περιοχή και συγκρίνετε την αίσθηση και τον ήχο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your pitch was high in this take. Try the same sentence in an easier range and compare how it feels and sounds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu tono fue alto en esta toma. Prueba la misma frase en un registro más cómodo y compara la sensación y el sonido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sävelkorkeutesi oli tässä otoksessa korkea. Kokeile samaa lausetta helpommalla äänialueella ja vertaa tuntemusta ja ääntä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Votre hauteur était élevée dans cette prise. Essayez la même phrase dans une zone plus aisée et comparez les sensations et le son."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "גובה הקול הממוצע בהקלטה זו היה גבוה. נסו את אותו משפט בטווח נוח יותר והשוו בין התחושה לצליל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इस रिकॉर्डिंग की औसत पिच ऊँची थी। वही वाक्य अधिक सहज दायरे में बोलें और सहजता व सुनाई देने वाली आवाज़ की तुलना करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Visina glasa u ovom je pokušaju bila visoka. Isprobajte istu rečenicu u ugodnijem rasponu pa usporedite osjećaj i zvuk."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ezen a felvételen magas volt a hangmagassága. Próbálja ugyanazt a mondatot kényelmesebb tartományban, majd hasonlítsa össze az érzést és a hangzást."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nada rata-rata rekaman ini cukup tinggi. Coba kalimat yang sama dalam rentang yang lebih mudah, lalu bandingkan kenyamanan dan bunyinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il tono era alto in questa prova. Ripeti la stessa frase in un registro più comodo e confronta sensazioni e suono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "今回の平均音高は高めでした。同じ文章をもっと楽な音域で話し、出しやすさと聞こえ方を比べてみましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이번 평균 음높이는 높은 편이었어요. 같은 문장을 더 편한 음역으로 말하며 편안함과 들리는 소리를 비교해 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Purata pic rakaman ini agak tinggi. Cuba ayat yang sama dalam julat yang lebih mudah dan bandingkan keselesaan serta bunyinya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je toonhoogte was hoog in deze opname. Probeer dezelfde zin in een comfortabeler bereik en vergelijk hoe het voelt en klinkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Głos w tej próbie był wysoki. Wypowiedz to samo zdanie w wygodniejszym zakresie i porównaj odczucie oraz brzmienie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sua altura estava alta nesta tomada. Tente a mesma frase em uma região mais confortável e compare a sensação e o som."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "В этой записи высота голоса была высокой. Произнесите ту же фразу в более удобном диапазоне и сравните ощущения и звучание."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Din tonhöjd var hög i den här tagningen. Prova samma mening i ett bekvämare läge och jämför känslan och ljudet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ระดับเสียงเฉลี่ยครั้งนี้ค่อนข้างสูง ลองพูดประโยคเดิมในช่วงเสียงที่สบายกว่า แล้วเปรียบเทียบความรู้สึกกับเสียงที่ได้ยิน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bu kayıtta ses perdeniz yüksekti. Aynı cümleyi daha rahat bir aralıkta deneyin ve hissini ve duyuluşunu karşılaştırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "У цьому записі висота голосу була високою. Вимовте ту саму фразу в зручнішому діапазоні та порівняйте відчуття й звучання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cao độ trung bình của bản ghi này khá cao. Hãy nói cùng câu ở quãng dễ chịu hơn, rồi so sánh cảm giác và âm thanh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这次平均音高较高。用更轻松的音区说同一句话，比较舒适度与听感。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "這次平均音高較高。用更輕鬆的音區說同一句話，比較舒適度與聽感。"
          }
        }
      }
    },
