    "insights.history.unavailable.description" : {
      "comment" : "Recovery guidance for unreadable saved analysis details.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تعذرت قراءة بيانات التحليل الكاملة. ارجع لعرض مؤشراته الموجزة، أو أنشئ تسجيلًا جديدًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Úplná data analýzy se nepodařilo načíst. Vraťte se k souhrnným ukazatelům nebo pořiďte novou nahrávku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De fulde analysedata kunne ikke læses. Gå tilbage for at se de opsummerede målinger, eller lav en ny optagelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die vollständige Analyse konnte nicht gelesen werden. Gehe zurück zu den zusammengefassten Kennzahlen oder erstelle eine neue Aufnahme."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Δεν ήταν δυνατή η ανάγνωση των πλήρων δεδομένων ανάλυσης. Επιστρέψτε για να δείτε τους συνοπτικούς δείκτες ή κάντε μια νέα εγγραφή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The full analysis data could not be read. Go back to view its summary metrics, or make a new recording."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se pudieron leer los datos del análisis completo. Vuelve atrás para ver sus métricas de resumen o haz una nueva grabación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Koko analyysin tietoja ei voitu lukea. Palaa takaisin nähdäksesi mittareiden yhteenvedon tai tee uusi tallenne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Impossible de lire l’analyse complète. Revenez aux indicateurs récapitulatifs ou effectuez un nouvel enregistrement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "לא ניתן היה לקרוא את נתוני הניתוח המלאים. חזרו להצגת המדדים המסכמים או צרו הקלטה חדשה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "विश्लेषण का पूरा डेटा पढ़ा नहीं जा सका। सारांश मेट्रिक देखने के लिए वापस जाएँ या नई रिकॉर्डिंग करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nije moguće pročitati potpune podatke analize. Vrati se na sažete pokazatelje ili napravi novu snimku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A teljes elemzés adatait nem sikerült beolvasni. Lépj vissza az összesített mutatókhoz, vagy készíts új felvételt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
