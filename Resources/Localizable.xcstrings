    "onboarding.preferences.voicePrompt" : {
      "comment" : "Direct question introducing the option cards; keep the question mark.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ما نوع الصوت الذي تطمح إليه؟"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jaký hlas je vaším cílem?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hvordan vil du gerne lyde?"
          }
        },
        "de" : {
          "stringUnit" : {
