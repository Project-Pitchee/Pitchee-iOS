    "practice.suggestion.analysisUnavailable.detail" : {
      "comment" : "Voice practice interface. Keep actions concise; preserve metric names and format arguments.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بعض بيانات التحليل غير متاحة. سجّل مقطعًا آخر وحلّله."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Některé údaje analýzy nejsou dostupné. Nahrajte a analyzujte další pokus."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nogle analysedata er utilgængelige. Optag og analysér et nyt forsøg."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Einige Analysedaten sind nicht verfügbar. Erstelle und analysiere eine neue Aufnahme."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ορισμένα δεδομένα ανάλυσης δεν είναι διαθέσιμα. Ηχογραφήστε και αναλύστε μια νέα λήψη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some analysis data is unavailable. Record and analyze another take."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Algunos datos de análisis no están disponibles. Graba y analiza otra toma."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Osa analyysitiedoista ei ole käytettävissä. Äänitä ja analysoi uusi otos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Certaines données d’analyse sont indisponibles. Enregistrez et analysez une autre prise."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "חלק מנתוני הניתוח אינם זמינים. הקליטו ונתחו שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "विश्लेषण का कुछ डेटा उपलब्ध नहीं है। दोबारा रिकॉर्ड करके विश्लेषण करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Neki podaci analize nisu dostupni. Snimite i analizirajte novi pokušaj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Egyes elemzési adatok nem érhetők el. Készítsen és elemezzen egy új felvételt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sebagian data analisis tidak tersedia. Rekam dan analisis ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alcuni dati di analisi non sono disponibili. Registra e analizza un’altra prova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "一部の分析データが利用できません。もう一度録音して分析してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
