    "scoring.rules.f0Unavailable.description" : {
      "comment" : "Guidance giving the user a concrete way to improve the next recording.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لم يُكتشف تردد أساسي قابل للاستخدام. تحقق من ظروف التسجيل وحاول التسجيل مجددًا بصوت مريح. غياب بيانات طبقة الصوت لا يحدد مشكلة صوتية بعينها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nebyla zjištěna použitelná základní frekvence. Zkontrolujte podmínky nahrávání a zkuste znovu mluvit pohodlným hlasem. Chybějící údaje o výšce hlasu nedokážou určit hlasový problém."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der blev ikke registreret en brugbar grundfrekvens. Kontrollér optagelsesforholdene, og prøv igen med en behagelig stemme. Manglende tonehøjdedata kan ikke udpege et stemmeproblem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Es wurde keine nutzbare Grundfrequenz erkannt. Prüfe die Aufnahmebedingungen und nimm erneut mit angenehmer Stimme auf. Fehlende Tonhöhendaten können kein Stimmproblem bestimmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Δεν ανιχνεύτηκε χρησιμοποιήσιμη θεμελιώδης συχνότητα. Ελέγξτε τις συνθήκες ηχογράφησης και δοκιμάστε ξανά με άνετη ομιλία. Η έλλειψη δεδομένων τονικού ύψους δεν εντοπίζει φωνητικό πρόβλημα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No usable fundamental frequency was detected. Check the recording conditions and try speaking comfortably again. Missing pitch data cannot identify a vocal problem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se detectó una frecuencia fundamental utilizable. Revisa las condiciones de grabación y vuelve a hablar con comodidad. La falta de datos de tono no permite identificar un problema vocal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Käyttökelpoista perustaajuutta ei havaittu. Tarkista tallennusolot ja kokeile puhua uudelleen mukavalla äänellä. Puuttuvat sävelkorkeustiedot eivät tunnista ääniongelmaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aucune fréquence fondamentale exploitable n’a été détectée. Vérifiez les conditions d’enregistrement et réessayez avec une voix confortable. L’absence de données de hauteur ne permet pas d’identifier un problème vocal."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "לא זוהתה תדירות יסוד שמישה. בדקו את תנאי ההקלטה ונסו להקליט שוב בקול נוח. היעדר נתוני גובה קול אינו מזהה בעיה קולית מסוימת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "उपयोग योग्य मूल आवृत्ति नहीं मिली। रिकॉर्डिंग की स्थितियाँ जाँचें और सहज आवाज़ में फिर रिकॉर्ड करें। पिच का डेटा न होने से किसी खास आवाज़ संबंधी समस्या का पता नहीं चलता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nije otkrivena upotrebljiva osnovna frekvencija. Provjerite uvjete snimanja i pokušajte ponovno govoriti ugodnim glasom. Nedostatak podataka o visini glasa ne može utvrditi problem s glasom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nem észlelhető használható alapfrekvencia. Ellenőrizze a felvételi körülményeket, és próbáljon újra kényelmesen beszélni. A hiányzó hangmagassági adatok nem azonosítanak hangproblémát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Frekuensi dasar yang dapat digunakan belum terdeteksi. Periksa kondisi rekaman lalu coba merekam lagi dengan suara nyaman. Ketiadaan data nada tidak dapat mengidentifikasi masalah vokal tertentu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Non è stata rilevata una frequenza fondamentale utilizzabile. Controlla le condizioni di registrazione e riprova parlando comodamente. L’assenza di dati sul tono non identifica un problema vocale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "利用できる基本周波数が検出されませんでした。録音条件を確認してから、楽な声で録音し直しましょう。音高データがないことだけでは、発声の問題は判断できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "사용할 수 있는 기본 주파수가 감지되지 않았어요. 녹음 조건을 확인하고 편안한 목소리로 다시 녹음해 보세요. 음높이 데이터가 없다는 것만으로 발성 문제를 판단할 수는 없어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tiada frekuensi asas yang boleh digunakan dikesan. Semak keadaan rakaman dan cuba rakam semula dengan suara yang selesa. Ketiadaan data pic tidak dapat mengenal pasti masalah vokal tertentu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Er is geen bruikbare grondfrequentie gevonden. Controleer de opnameomstandigheden en probeer opnieuw comfortabel te spreken. Ontbrekende toonhoogtegegevens kunnen geen stemprobleem aanwijzen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nie wykryto użytecznej częstotliwości podstawowej. Sprawdź warunki nagrania i spróbuj ponownie mówić swobodnie. Brak danych o wysokości nie wskazuje konkretnego problemu z głosem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nenhuma frequência fundamental utilizável foi detectada. Verifique as condições de gravação e tente falar confortavelmente de novo. A falta de dados de altura não identifica um problema vocal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Не обнаружена пригодная для анализа основная частота. Проверьте условия записи и попробуйте снова говорить комфортным голосом. Отсутствие данных о высоте не позволяет определить проблему с голосом."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ingen användbar grundfrekvens upptäcktes. Kontrollera inspelningsförhållandena och försök tala bekvämt igen. Saknade tonhöjdsdata kan inte identifiera ett röstproblem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ไม่พบความถี่มูลฐานที่ใช้ได้ ลองตรวจสอบสภาพการบันทึกแล้วบันทึกใหม่ด้วยเสียงที่สบาย การไม่มีข้อมูลระดับเสียงไม่สามารถระบุปัญหาการใช้เสียงได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kullanılabilir bir temel frekans algılanmadı. Kayıt koşullarını kontrol edip rahatça konuşarak yeniden deneyin. Perde verisinin eksik olması bir ses sorununu belirleyemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Не виявлено придатної для аналізу основної частоти. Перевірте умови запису й спробуйте знову говорити комфортним голосом. Відсутність даних про висоту не дозволяє визначити проблему з голосом."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chưa phát hiện tần số cơ bản dùng được. Hãy kiểm tra điều kiện ghi âm và thử ghi lại bằng giọng thoải mái. Thiếu dữ liệu cao độ không thể xác định vấn đề phát âm cụ thể."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这次未检测到可用的基频。可以先检查录音条件，再用舒适的声音重录。缺少音高数据不能判断具体发声问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "這次未偵測到可用的基頻。可以先檢查錄音條件，再用舒適的聲音重錄。缺少音高資料不能判斷具體發聲問題。"
          }
        }
      }
    },
    "scoring.rules.f0Unavailable.result" : {
