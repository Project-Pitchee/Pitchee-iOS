    "practice.suggestion.captureClipping.detail" : {
      "comment" : "Voice practice interface. Keep actions concise; preserve metric names and format arguments.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يشير فحص التسجيل إلى احتمال وجود قصّ في الإشارة. جرّب الابتعاد قليلًا عن الميكروفون أو خفض كسب الإدخال، ثم أعد التسجيل بمستوى صوتك المعتاد قبل اختيار محور التدريب."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kontrola nahrávky naznačuje možné ořezání signálu. Zkuste se trochu vzdálit od mikrofonu nebo snížit vstupní zesílení a nahrajte se běžnou hlasitostí. Potom zvolte zaměření cvičení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Optagelseskontrollen tyder på mulig overstyring. Prøv at øge afstanden til mikrofonen lidt eller sænke indgangsforstærkningen. Optag derefter med din sædvanlige lydstyrke, før du vælger et øvelsesfokus."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Aufnahmeprüfung deutet auf mögliches Clipping hin. Vergrößere den Mikrofonabstand etwas oder senke die Eingangsverstärkung. Nimm dann mit gewohnter Lautstärke erneut auf, bevor du einen Übungsschwerpunkt wählst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ο έλεγχος της ηχογράφησης υποδεικνύει πιθανό ψαλιδισμό. Απομακρυνθείτε λίγο από το μικρόφωνο ή μειώστε το κέρδος εισόδου και ηχογραφήστε ξανά με τη συνηθισμένη σας ένταση πριν επιλέξετε σε τι θα εξασκηθείτε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The recording check suggests possible clipping. Try moving slightly farther from the microphone or lowering the input gain, then record at your usual volume before choosing a training focus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La comprobación indica posible saturación. Prueba a alejarte un poco del micrófono o a reducir la ganancia de entrada. Después, graba a tu volumen habitual antes de elegir un objetivo de práctica."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tallennustarkistus viittaa mahdolliseen leikkautumiseen. Kokeile siirtyä hieman kauemmas mikrofonista tai pienentää tulovahvistusta. Äänitä sitten tavallisella äänenvoimakkuudella ennen harjoituskohteen valintaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le contrôle de l’enregistrement signale un possible écrêtage. Éloignez-vous légèrement du microphone ou réduisez le gain d’entrée, puis enregistrez à votre volume habituel avant de choisir un axe de travail."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "בדיקת ההקלטה מצביעה על חיתוך אפשרי של האות. נסו להתרחק מעט מהמיקרופון או להנמיך את הגבר הקלט, ואז להקליט בעוצמה הרגילה לפני בחירת מוקד התרגול."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "रिकॉर्डिंग की जाँच में क्लिपिंग की संभावना मिली है। माइक्रोफ़ोन से थोड़ा दूर जाएँ या इनपुट गेन कम करें, फिर अभ्यास का केंद्र चुनने से पहले सामान्य आवाज़ में दोबारा रिकॉर्ड करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Provjera snimke upućuje na moguće odrezivanje signala. Malo se udaljite od mikrofona ili smanjite ulazno pojačanje pa ponovno snimite uobičajenom glasnoćom prije odabira fokusa vježbe."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A felvétel ellenőrzése lehetséges túlvezérlést jelez. Lépjen kissé távolabb a mikrofontól, vagy csökkentse a bemeneti erősítést, majd rögzítsen újra szokásos hangerővel, mielőtt kiválasztja a gyakorlás fókuszát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pemeriksaan rekaman menunjukkan kemungkinan clipping. Coba menjauh sedikit dari mikrofon atau kurangi gain input, lalu rekam dengan volume biasa sebelum memilih fokus latihan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il controllo segnala un possibile clipping. Prova ad allontanarti leggermente dal microfono o a ridurre il guadagno d’ingresso, poi registra al volume abituale prima di scegliere su cosa esercitarti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "録音チェックでクリッピングの可能性が示されました。マイクから少し離すか入力ゲインを下げ、普段の声量で録音し直してから練習の重点を選びましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "녹음 점검에서 클리핑 가능성이 감지됐어요. 마이크와 조금 거리를 두거나 입력 게인을 낮춰 평소 음량으로 다시 녹음한 뒤 연습할 항목을 선택해 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Semakan rakaman menunjukkan kemungkinan pemotongan isyarat. Cuba jauhkan sedikit mikrofon atau kurangkan gandaan input, kemudian rakam dengan kelantangan biasa sebelum memilih fokus latihan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De opnamecontrole wijst op mogelijke clipping. Ga iets verder van de microfoon staan of verlaag de ingangsversterking. Neem daarna op met je gebruikelijke volume voordat je een oefenfocus kiest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kontrola nagrania wskazuje możliwe przesterowanie. Odsuń się nieco od mikrofonu lub zmniejsz wzmocnienie wejściowe, a następnie nagraj się ze zwykłą głośnością, zanim wybierzesz cel ćwiczeń."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A verificação sugere possível saturação. Tente se afastar um pouco do microfone ou reduzir o ganho de entrada. Depois, grave no volume habitual antes de escolher um foco de prática."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Проверка записи указывает на возможное срезание пиков сигнала. Попробуйте немного отодвинуться от микрофона или снизить входное усиление, затем перезапишите речь с обычной громкостью, прежде чем выбирать направление тренировки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inspelningskontrollen tyder på möjlig klippning. Prova att öka avståndet till mikrofonen lite eller sänka ingångsförstärkningen. Spela sedan in med din vanliga volym innan du väljer ett övningsfokus."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "การตรวจสอบเสียงบันทึกพบว่าอาจมีสัญญาณถูกตัดยอด ลองเพิ่มระยะจากไมโครโฟนเล็กน้อยหรือลดเกนขาเข้า แล้วบันทึกด้วยความดังตามปกติก่อนเลือกจุดเน้นในการฝึก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kayıt kontrolü, sinyalin kırpılmış olabileceğini gösteriyor. Alıştırma odağını seçmeden önce mikrofondan biraz uzaklaşmayı veya giriş kazancını azaltmayı deneyin, ardından normal ses düzeyinizle yeniden kaydedin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Перевірка запису вказує на можливе обрізання сигналу. Спробуйте трохи відсунутися від мікрофона або зменшити вхідне підсилення, а потім перезапишіть мовлення зі звичною гучністю, перш ніж обирати напрям тренування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kiểm tra bản ghi cho thấy có thể bị xén đỉnh. Hãy thử đứng xa micrô hơn một chút hoặc giảm độ lợi đầu vào, rồi ghi lại bằng âm lượng bình thường trước khi chọn trọng tâm luyện tập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录音检查提示可能存在削波。可以稍微拉开麦克风距离，或降低输入增益，用平常音量重录后再选择训练重点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "錄音檢查提示可能存在削波。可以稍微拉開麥克風距離，或降低輸入增益，用平常音量重錄後再選擇訓練重點。"
          }
        }
      }
    },
