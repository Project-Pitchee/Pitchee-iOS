        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "केवल पिछले 60 सेकंड रखे जाते हैं। निगरानी पेज छोड़ने पर ऑडियो मिटा दिया जाता है और रिकॉर्डिंग के रूप में सेव नहीं होता।"
