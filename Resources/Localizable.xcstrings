    "recording.interruption.saved" : {
      "comment" : "Explains that an interrupted recording is finalized and its captured audio is analyzed.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "توقف التسجيل. سيُحلَّل الصوت المسجَّل قبل التوقف؛ يمكنك التسجيل مجددًا للحصول على تسجيل كامل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nahrávání bylo přerušeno. Zvuk zachycený před zastavením bude analyzován; pro úplný záznam můžete nahrávat znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Optagelsen blev afbrudt. Lyden optaget før stoppet bliver analyseret; du kan optage igen for at få en komplet optagelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Aufnahme wurde unterbrochen. Das bis zum Stopp aufgenommene Audio wird analysiert. Für eine vollständige Aufnahme kannst du erneut aufnehmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η ηχογράφηση διακόπηκε. Ο ήχος πριν από τη διακοπή θα αναλυθεί. Μπορείτε να ηχογραφήσετε ξανά για μια πλήρη λήψη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recording was interrupted. Audio captured before the stop will be analyzed; you can record again for a complete take."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La grabación se interrumpió. Se analizará el audio capturado antes de detenerse; puedes volver a grabar una toma completa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tallennus keskeytyi. Ennen pysäytystä tallennettu ääni analysoidaan. Voit tallentaa uudelleen saadaksesi kokonaisen otoksen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’enregistrement a été interrompu. Le son capturé avant l’arrêt sera analysé. Vous pouvez enregistrer à nouveau une prise complète."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ההקלטה הופסקה. השמע שנקלט לפני העצירה ינותח; ניתן להקליט שוב כדי לקבל הקלטה מלאה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "रिकॉर्डिंग बाधित हुई। रुकने से पहले रिकॉर्ड की गई आवाज़ का विश्लेषण किया जाएगा; पूरी रिकॉर्डिंग के लिए आप फिर से रिकॉर्ड कर सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Snimanje je prekinuto. Zvuk snimljen prije zaustavljanja bit će analiziran; možete ponovno snimiti cijelu snimku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A felvétel megszakadt. A leállítás előtt rögzített hang elemzésre kerül; teljes felvételhez újra rögzíthet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Perekaman terhenti. Audio yang direkam sebelum berhenti akan dianalisis; Anda dapat merekam ulang untuk mendapatkan rekaman lengkap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La registrazione è stata interrotta. L’audio acquisito prima dell’arresto verrà analizzato; puoi registrare di nuovo una ripresa completa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "録音が中断されました。停止までに録音された音声を分析します。全体を録音するには、もう一度録音してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "녹음이 중단되었어요. 중단 전에 녹음된 음성을 분석합니다. 전체 녹음을 원하면 다시 녹음할 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rakaman terganggu. Audio yang dirakam sebelum berhenti akan dianalisis; anda boleh merakam semula untuk rakaman yang lengkap."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De opname is onderbroken. De audio van vóór het stoppen wordt geanalyseerd; je kunt opnieuw opnemen voor een volledige opname."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nagrywanie zostało przerwane. Dźwięk nagrany przed zatrzymaniem zostanie przeanalizowany. Możesz nagrać ponownie całość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A gravação foi interrompida. O áudio capturado antes da interrupção será analisado; você pode gravar novamente para obter uma gravação completa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Запись прервана. Звук, записанный до остановки, будет проанализирован. Для полной записи можно записать снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inspelningen avbröts. Ljudet som spelades in före stoppet kommer att analyseras. Du kan spela in igen för en fullständig tagning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "การบันทึกถูกขัดจังหวะ ระบบจะวิเคราะห์เสียงที่บันทึกไว้ก่อนหยุด คุณสามารถบันทึกใหม่เพื่อให้ได้เสียงครบถ้วน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kayıt kesintiye uğradı. Durmadan önce kaydedilen ses analiz edilecek; tam bir kayıt için yeniden kaydedebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Запис перервано. Звук, записаний до зупинки, буде проаналізовано. Для повного запису можна записати знову."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quá trình ghi âm bị gián đoạn. Âm thanh thu được trước khi dừng sẽ được phân tích; bạn có thể ghi lại để có bản ghi đầy đủ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录音已中断，将分析停止前录到的内容。你可以重新录制完整片段。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "錄音已中斷，將分析停止前錄到的內容。你可以重新錄製完整片段。"
          }
        }
      }
    },
    "recording.reference.passage" : {
      "comment" : "Reading passage recorded by the user; keep it natural to read aloud and roughly the same length.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "في الصباح الباكر، دفعتُ النافذة ورأيت ضوء الشمس يستقر على أوراق الشجر. ومن بعيد جاء تغريد الطيور الخفيف، وأخذ الشارع يزدحم بالحياة رويدًا رويدًا. أريد أن أتمهّل قليلًا، وأن أسجّل بصوت طبيعي حياةَ يومي البسيطة والجميلة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Brzy ráno otevírám okno a vidím slunce, jak si hraje na listech. Z dálky se ozývá tichý ptačí zpěv a ulice se pomalu probouzí. Chci zpomalit a přirozeným hlasem zachytit dnešní obyčejný, a přece krásný den."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tidligt om morgenen åbnede jeg vinduet og så solen skinne på bladene. Et sted i det fjerne hørtes blide fuglestemmer, og gaden blev langsomt levende. Jeg vil sætte tempoet ned og med en naturlig stemme fortælle om dagens almindelige, men smukke liv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Am frühen Morgen öffne ich das Fenster und sehe, wie das Sonnenlicht auf den Blättern liegt. In der Ferne höre ich leises Vogelgezwitscher, und die Straße wird langsam lebendig. Ich möchte langsamer werden und mit natürlicher Stimme diesen ganz gewöhnlichen, schönen Tag festhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Νωρίς το πρωί άνοιξα το παράθυρο και είδα το φως του ήλιου να πέφτει στα φύλλα. Από μακριά ακουγόταν το απαλό κελάηδημα των πουλιών και ο δρόμος ζωντάνευε σιγά σιγά. Θέλω να περπατήσω πιο αργά και να καταγράψω, με τη φυσική μου φωνή, τη συνηθισμένη αλλά όμορφη ζωή της σημερινής μέρας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Early in the morning, I pushed open the window and saw the sunlight resting on the leaves. Somewhere in the distance came the soft chirping of birds, and the street slowly grew lively. I want to slow down and, in my natural voice, record the ordinary yet beautiful life of today."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Por la mañana temprano abrí la ventana y vi la luz del sol sobre las hojas. A lo lejos llegaba el suave canto de los pájaros y la calle empezaba a animarse. Quiero ir más despacio y, con una voz natural, registrar la vida sencilla y hermosa de hoy."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Varhain aamulla avasin ikkunan ja näin auringonvalon lepäävän lehdillä. Kaukaa kuului lintujen hiljaista laulua, ja katu heräsi vähitellen eloon. Haluan hidastaa tahtia ja kertoa tästä tavallisesta mutta kauniista päivästä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Au petit matin, j’ouvre la fenêtre et je regarde la lumière du soleil se poser sur les feuilles. Au loin, des oiseaux chantent doucement et la rue s’anime peu à peu. Je voudrais ralentir le pas et, d’une voix naturelle, garder la trace de cette journée simple et belle."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "בבוקר מוקדם פתחתי את החלון וראיתי את אור השמש נח על העלים. מרחוק נשמע ציוץ ציפורים עדין, והרחוב התחיל לאט לאט להתעורר. אני רוצה להאט את הקצב ולספר בקול טבעי על היום הפשוט והיפה הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सुबह मैंने खिड़की खोली, तो धूप पत्तों पर पड़ी दिखी। दूर से पक्षियों की हल्की आवाज़ आ रही थी और सड़क धीरे-धीरे गुलज़ार हो रही थी। मन है कि कुछ देर रुककर, स्वाभाविक आवाज़ में, आज की साधारण और सुंदर ज़िंदगी दर्ज कर लूँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rano ujutro otvorim prozor i vidim kako sunce pada na lišće. U daljini se čuje tiho ptičje pjevanje, a ulica polako oživljava. Želim usporiti i prirodnim glasom zabilježiti ljepotu ovog običnog dana."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kora reggel kinyitottam az ablakot, és láttam, ahogy a napfény megpihen a leveleken. A távolból halk madárcsicsergés hallatszott, az utca pedig lassan megelevenedett. Szeretnék lelassítani, és természetes hangon megörökíteni a mai hétköznapi, mégis szép életet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pagi hari, saya membuka jendela dan melihat cahaya matahari jatuh di atas dedaunan. Dari kejauhan terdengar kicau burung yang lembut, dan jalanan pun perlahan mulai ramai. Saya ingin melambatkan langkah dan, bersama suara alam, merekam kehidupan hari ini yang sederhana tetapi indah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Di mattina apro la finestra e vedo la luce del sole posarsi sulle foglie. In lontananza arriva il canto leggero degli uccelli e la strada piano piano si anima. Vorrei rallentare e, con una voce naturale, raccontare la vita di oggi, semplice e bella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "朝早く、窓を開けると、日の光が木の葉の上にのっていました。遠くからは鳥のさえずりが聞こえてきて、通りも少しずつにぎやかになっていきます。私は歩みをゆるめて、自然の音と一緒に、今日の何気ないけれど美しい時間を記録したいと思います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "아침에 창문을 열자 햇살이 나뭇잎 위로 내려앉았어요. 멀리서 새소리가 잔잔하게 들려오고, 거리도 조금씩 활기를 띠었어요. 저는 걸음을 늦추고 자연스러운 목소리로 오늘의 평범하고 아름다운 하루를 기록하려 해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pada awal pagi, saya membuka tingkap dan melihat cahaya matahari jatuh pada daun-daun. Dari jauh terdengar kicauan burung yang lembut, dan jalan mula menjadi riuh. Saya mahu memperlahankan langkah, dengan suara yang semula jadi, merakam kehidupan hari ini yang biasa tetapi indah."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vroeg in de ochtend schoof ik het raam open en zag het zonlicht op de bladeren liggen. In de verte klonk zacht vogelgezang en de straat kwam langzaam tot leven. Ik wil het rustiger aan doen en met een natuurlijke stem de gewone, mooie dag van vandaag vastleggen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wczesnym rankiem otwieram okno i widzę, jak światło słońca pada na liście. Z oddali dobiega ciche ćwierkanie ptaków, a ulica powoli się ożywia. Chcę zwolnić i naturalnym głosem zapisać dzisiejsze zwyczajne, a piękne życie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De manhã, abro a janela e vejo a luz do sol pousar nas folhas. Ao longe, chega o canto suave dos pássaros, e a rua vai ficando mais movimentada. Quero andar mais devagar e, com a voz natural, registrar a vida simples e bonita de hoje."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ранним утром я открываю окно и вижу, как солнечный свет ложится на листья. Вдалеке слышится тихое пение птиц, и улица понемногу оживает. Хочется замедлить шаг и спокойным, естественным голосом записать этот обычный и вместе с тем прекрасный день."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tidigt på morgonen öppnade jag fönstret och såg solljuset vila på löven. Långt bort hördes svag fågelsång, och gatan vaknade sakta till liv. Jag vill sakta ner och med en naturlig röst fånga den vanliga men vackra vardagen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "เช้าตรู่ ฉันผลักหน้าต่างออก เห็นแสงแดดเกาะอยู่บนใบไม้ ไกลออกไปมีเสียงนกร้องเบา ๆ ถนนค่อย ๆ คึกคักขึ้น ฉันอยากผ่อนฝีเท้าลง แล้วใช้เสียงธรรมชาติบันทึกชีวิตธรรมดา ๆ ที่งดงามของวันนี้ไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sabah pencereyi açtım ve güneşin yapraklara vurduğunu gördüm. Uzaklardan hafif kuş sesleri geliyor, sokak yavaş yavaş canlanıyordu. Ben de adımlarımı yavaşlatıp bugünün sıradan ama güzel hayatını doğal bir sesle anlatmak istiyorum."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Рано-вранці я відчиняю вікно й бачу, як сонячне світло лягає на листя. Удалині чути тихий спів птахів, і вулиця потроху оживає. Хочеться сповільнити крок і природним голосом записати цей простий, але гарний день."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Buổi sáng, tôi mở cửa sổ và thấy nắng đậu trên những chiếc lá. Từ đằng xa vọng lại tiếng chim hót nhẹ nhàng, con phố cũng dần trở nên rộn ràng. Tôi muốn chậm lại một chút, dùng giọng nói tự nhiên để ghi lại cuộc sống bình dị mà tươi đẹp của hôm nay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清晨，我推开窗户，看见阳光落在树叶上。远处传来轻轻的鸟鸣，街道也慢慢热闹起来。我想放慢脚步，用自然的声音，记录今天平凡而美好的生活。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清晨，我推開窗戶，看見陽光落在樹葉上。遠處傳來輕輕的鳥鳴，街道也慢慢熱鬧起來。我想放慢腳步，用自然的聲音，記錄今天平凡而美好的生活。"
          }
        }
      }
    },
