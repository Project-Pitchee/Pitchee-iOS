    "monitor.retention.note" : {
      "comment" : "Live audio monitoring. %@ placeholders are localized elapsed seconds where present.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يُحتفظ بآخر 60 ثانية فقط. يُحذف الصوت عند مغادرة صفحة المراقبة ولا يُحفظ كتسجيل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uchovává se pouze posledních 60 sekund. Při opuštění sledování se zvuk vymaže a neuloží se jako nahrávka."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kun de seneste 60 sekunder bevares. Lyden slettes, når du forlader overvågningen, og gemmes ikke som en optagelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nur die letzten 60 Sekunden werden behalten. Beim Verlassen der Überwachung wird das Audio gelöscht und nicht als Aufnahme gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Διατηρούνται μόνο τα τελευταία 60 δευτερόλεπτα. Ο ήχος διαγράφεται όταν φύγετε από την παρακολούθηση και δεν αποθηκεύεται ως εγγραφή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the latest 60 seconds are kept. Audio is cleared when you leave the monitor and is not saved as a recording."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Solo se conservan los últimos 60 segundos. El audio se borra al salir del monitor y no se guarda como grabación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vain viimeiset 60 sekuntia säilytetään. Ääni poistetaan poistuessasi seurannasta, eikä sitä tallenneta äänitteeksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seules les 60 dernières secondes sont conservées. L’audio est effacé lorsque vous quittez la surveillance et n’est pas sauvegardé comme enregistrement."
