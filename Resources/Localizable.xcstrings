    "settings.localDiagnostics.storageError.message" : {
      "comment" : "Local diagnostics settings or summary. Describes only information kept on this device; do not imply that anything is uploaded.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "توقفت التشخيصات المحلية. قد لا تكون بعض البيانات قد مُسحت. افتح قفل الجهاز وحاول مجددًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Místní diagnostika se zastavila. Některá data možná nebyla vymazána. Odemkněte zařízení a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lokal diagnostik er stoppet. Nogle data er muligvis ikke blevet ryddet. Lås enheden op, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die lokale Diagnose wurde angehalten. Einige Daten wurden möglicherweise nicht gelöscht. Entsperre das Gerät und versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Τα τοπικά διαγνωστικά σταμάτησαν. Ορισμένα δεδομένα ενδέχεται να μην έχουν διαγραφεί. Ξεκλειδώστε τη συσκευή και δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local diagnostics have stopped. Some data may not have been cleared. Unlock the device and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los diagnósticos locales se han detenido. Es posible que algunos datos no se hayan borrado. Desbloquea el dispositivo e inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Paikallinen diagnostiikka on pysähtynyt. Joitakin tietoja ei ehkä ole tyhjennetty. Avaa laitteen lukitus ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les diagnostics locaux se sont arrêtés. Certaines données n’ont peut-être pas été effacées. Déverrouillez l’appareil et réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "האבחון המקומי הופסק. ייתכן שחלק מהנתונים לא נוקו. בטלו את נעילת המכשיר ונסו שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "स्थानीय निदान रुक गया है। कुछ डेटा शायद मिटा न हो। डिवाइस अनलॉक करके दोबारा कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lokalna dijagnostika zaustavljena je. Neki podaci možda nisu izbrisani. Otključaj uređaj i pokušaj ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A helyi diagnosztika leállt. Előfordulhat, hogy egyes adatok nem törlődtek. Oldd fel az eszközt, és próbáld újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Diagnostik lokal telah berhenti. Sebagian data mungkin belum dihapus. Buka kunci perangkat dan coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La diagnostica locale si è interrotta. Alcuni dati potrebbero non essere stati cancellati. Sblocca il dispositivo e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "端末内の診断を停止しました。一部のデータが消去されていない可能性があります。端末のロックを解除して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "기기 내 진단이 중지됐어요. 일부 데이터가 지워지지 않았을 수 있어요. 기기의 잠금을 해제하고 다시 시도해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Diagnostik setempat telah dihentikan. Sesetengah data mungkin belum dipadam. Buka kunci peranti dan cuba lagi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De lokale diagnostiek is gestopt. Sommige gegevens zijn mogelijk niet gewist. Ontgrendel het apparaat en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lokalna diagnostyka została zatrzymana. Część danych mogła nie zostać usunięta. Odblokuj urządzenie i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os diagnósticos locais foram interrompidos. Alguns dados podem não ter sido limpos. Desbloqueie o dispositivo e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Локальная диагностика остановлена. Некоторые данные могли остаться неочищенными. Разблокируйте устройство и повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Den lokala diagnostiken har stoppats. Vissa uppgifter kanske inte har rensats. Lås upp enheten och försök igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "การวินิจฉัยในเครื่องหยุดแล้ว ข้อมูลบางส่วนอาจยังไม่ถูกล้าง ปลดล็อกอุปกรณ์แล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yerel tanılama durduruldu. Bazı veriler temizlenmemiş olabilir. Cihazın kilidini aç ve tekrar dene."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Локальну діагностику зупинено. Деякі дані могли залишитися неочищеними. Розблокуйте пристрій і спробуйте ще раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chẩn đoán trên thiết bị đã dừng. Một số dữ liệu có thể chưa được xóa. Mở khóa thiết bị rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地诊断已停止。部分资料可能尚未清除，请解锁设备后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本機診斷已停止。部分資料可能尚未清除，請解鎖裝置後再試一次。"
          }
        }
      }
    },
