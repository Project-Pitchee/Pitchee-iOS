    "analysis.statistics.volume.note" : {
      "comment" : "Explanatory footnote about the dBFS scale and about the per-metric offset relative to the noise floor. Keep technical terms unchanged.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يُعرض مستوى الصوت بوحدة dBFS، حيث يمثل 0 dBFS أعلى مستوى يمكن للجهاز تسجيله؛ وتمثل القيم أسفل المتوسط والوسيط مستوى الصوت فوق الضجيج المحيط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hlasitost se uvádí v dBFS, kde 0 dBFS je nejvyšší úroveň, kterou zařízení dokáže zaznamenat; hodnoty u průměru a mediánu vyjadřují hlasitost nad úrovní okolního hluku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lydstyrke vises i dBFS, hvor 0 dBFS er det højeste niveau, enheden kan optage; under gennemsnit og median vises lydstyrken over baggrundsstøjen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Lautstärke wird in dBFS angezeigt; 0 dBFS ist der lauteste Pegel, den das Gerät aufnehmen kann. Die Werte unter Mittelwert und Median zeigen die Lautstärke über dem Umgebungsgeräusch."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η ένταση εμφανίζεται σε dBFS, όπου 0 dBFS είναι το πιο δυνατό επίπεδο που μπορεί να καταγράψει η συσκευή· οι τιμές στη μέση και τη διάμεσο δείχνουν ένταση πάνω από τον θόρυβο περιβάλλοντος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volume is shown in dBFS, where 0 dBFS is the loudest level the device can record; the values shown under average and median are volume above the ambient noise floor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El volumen se muestra en dBFS, donde 0 dBFS es el nivel máximo que puede grabar el dispositivo; los valores que aparecen bajo el promedio y la mediana corresponden al volumen por encima del ruido de fondo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voimakkuus näytetään dBFS-yksikkönä, jossa 0 dBFS on kovin taso, jonka laite pystyy tallentamaan; keskiarvon ja mediaanin alla näkyvät arvot ovat voimakkuutta ympäristön kohinatason yläpuolella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le volume est exprimé en dBFS : 0 dBFS correspond au niveau le plus élevé que l’appareil peut enregistrer. Les valeurs affichées sous le volume moyen et le volume médian indiquent le volume au-dessus du bruit de fond."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "העוצמה מוצגת ב-dBFS, כאשר 0 dBFS הוא הרמה הגבוהה ביותר שהמכשיר יכול להקליט; הערכים שמוצגים מתחת לממוצע ולחציון הם עוצמה מעל רעש הרקע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "वॉल्यूम dBFS में दिखाया जाता है, जहाँ 0 dBFS वह सबसे तेज़ स्तर है जो डिवाइस रिकॉर्ड कर सकता है; औसत और मध्य के नीचे दिखाया गया मान परिवेशी शोर स्तर से ऊपर की आवाज़ बताता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Glasnoća se prikazuje u dBFS, gdje je 0 dBFS najviša razina koju uređaj može snimiti; vrijednosti prikazane uz prosjek i medijan označavaju glasnoću iznad razine šuma okoline."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A hangerő dBFS-ben jelenik meg, ahol a 0 dBFS a készülék által rögzíthető legerősebb szint; az átlag és a medián alatt megjelenő értékek a környezeti zajszint feletti hangerőt mutatják."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Volume ditampilkan dalam dBFS, dengan 0 dBFS sebagai level terkeras yang dapat direkam perangkat; nilai di bawah rata-rata dan median adalah volume di atas dasar kebisingan lingkungan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il volume è espresso in dBFS, dove 0 dBFS è il livello più alto che il dispositivo può registrare; i valori sotto media e mediana indicano il volume al di sopra del rumore di fondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "音量は dBFS で表示し、0 dBFS が端末で録音できる最大レベルです。平均と中央値の下に表示される値は、周囲のノイズを基準とした音量です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "음량은 dBFS로 표시하며 0 dBFS는 기기가 기록할 수 있는 가장 큰 소리예요. 평균과 중앙값 아래에 표시되는 값은 주변 소음보다 큰 음량을 나타내요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kelantangan ditunjukkan dalam dBFS, dengan 0 dBFS sebagai tahap paling kuat yang boleh dirakam oleh peranti; nilai di bawah purata dan median ialah kelantangan melebihi aras hingar persekitaran."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Volume wordt weergegeven in dBFS, waarbij 0 dBFS het luidste niveau is dat je apparaat kan opnemen; de waarden onder gemiddeld en mediaan zijn het volume boven de omgevingsruisvloer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Głośność podawana jest w dBFS, gdzie 0 dBFS to najwyższy poziom, jaki urządzenie może zarejestrować; wartości pod średnią i medianą oznaczają głośność powyżej poziomu szumu otoczenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O volume é mostrado em dBFS, em que 0 dBFS é o nível mais alto que o dispositivo consegue gravar; os valores exibidos abaixo de média e mediana representam o volume acima do ruído de fundo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Громкость указана в dBFS, где 0 dBFS — максимальный уровень, который может записать устройство; значения под средней и медианной громкостью показывают уровень выше фонового шума."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Volym visas i dBFS, där 0 dBFS är den högsta nivå enheten kan spela in; värdena under medel och median visar volymen över bakgrundsbullret."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ความดังแสดงเป็น dBFS โดย 0 dBFS คือระดับที่ดังที่สุดที่อุปกรณ์บันทึกได้ ส่วนค่าที่แสดงใต้ค่าเฉลี่ยและมัธยฐานคือความดังที่สูงกว่าระดับเสียงรบกวนพื้นหลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ses düzeyi dBFS ile gösterilir; 0 dBFS, cihazın kaydedebileceği en yüksek düzeydir. Ortalama ve ortanca değerlerinin altında, ortam gürültü tabanının üzerindeki ses düzeyi gösterilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Гучність подано в dBFS, де 0 dBFS — найгучніший рівень, який здатен записати пристрій; значення під середньою та медіаною — це гучність понад рівень фонового шуму."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Âm lượng được hiển thị bằng dBFS, trong đó 0 dBFS là mức to nhất mà thiết bị có thể ghi; các giá trị dưới mục trung bình và trung vị là âm lượng cao hơn mức ồn nền xung quanh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音量使用 dBFS 表示，0 dBFS 为设备可记录的最大值；平均值和中位数下方显示高于环境底噪的音量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音量以 dBFS 表示，0 dBFS 是裝置可錄製的最大值；平均值和中位數下方顯示的是高於環境底噪的音量。"
          }
        }
      }
    },
