    "export.chart.loudnessScale.note" : {
      "comment" : "Caption explaining the dBFS scale when both loudness curves are shown.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تُعرض جهارة الصوت والجهارة الخلفية بوحدة dBFS؛ وكلما اقتربت القيمة من 0 كان الصوت أعلى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hlasitost řeči i pozadí se uvádí v dBFS; hodnoty blíž k nule znamenají vyšší hlasitost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tale- og baggrundslydstyrke vises i dBFS; værdier tættere på 0 er kraftigere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sprach- und Hintergrundlautstärke werden in dBFS angezeigt; je näher der Wert bei 0 liegt, desto lauter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η ένταση φωνής και η ένταση περιβάλλοντος εμφανίζονται σε dBFS· όσο πιο κοντά στο 0, τόσο πιο δυνατά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voice and background loudness are shown in dBFS; values closer to 0 are louder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El volumen de la voz y el de fondo se muestran en dBFS; los valores más cercanos a 0 son más fuertes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puheen ja taustan voimakkuus näytetään dBFS-yksikkönä; mitä lähempänä arvo on nollaa, sitä kovempi ääni on."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le niveau sonore de la voix et celui de l’arrière-plan sont exprimés en dBFS ; plus la valeur approche de 0, plus le son est fort."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "עוצמת הדיבור והרקע מוצגות ב-dBFS; ככל שהערך קרוב יותר ל-0, הקול חזק יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आवाज़ और परिवेशी तीव्रता dBFS में दिखाई जाती है; 0 के करीब के मान ज़्यादा तेज़ होते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Glasnoća govora i pozadine prikazuje se u dBFS; vrijednosti bliže nuli znače veću glasnoću."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A beszéd és a háttér hangereje dBFS-ben jelenik meg; a 0-hoz közelebbi értékek hangosabbak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kenyaringan suara dan latar ditampilkan dalam dBFS; nilai yang lebih dekat ke 0 berarti lebih keras."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il volume della voce e quello di fondo sono in dBFS; i valori più vicini a 0 sono più alti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "音声と背景の音量は dBFS で示し、0 に近いほど大きくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
