    "monitor.hub.description" : {
      "comment" : "Live audio monitoring. %@ placeholders are localized elapsed seconds where present.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اختر الطيف أو التردد الأساسي لمتابعة صوتك مباشرة، ثم أوقفه مؤقتًا وأعد تشغيل الصوت الأخير."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vyberte spektrum nebo základní frekvenci, sledujte hlas živě a poté sledování pozastavte a přehrajte poslední zvuk."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vælg spektrum eller grundfrekvens for at følge din stemme live, sætte på pause og afspille den seneste lyd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wähle Spektrum oder Grundfrequenz, um deine Stimme live zu beobachten, zu pausieren und die letzten Sekunden anzuhören."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Επιλέξτε φάσμα ή θεμελιώδη συχνότητα για να παρακολουθήσετε ζωντανά τη φωνή σας, έπειτα κάντε παύση και ακούστε ξανά τον πρόσφατο ήχο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose spectrum or fundamental frequency to watch your voice live, then pause and replay recent audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elige el espectro o la frecuencia fundamental para observar tu voz en directo, pausar y reproducir el audio reciente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Valitse spektri tai perustaajuus, seuraa ääntäsi reaaliajassa ja keskeytä kuunnellaksesi viimeisintä ääntä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Choisissez le spectre ou la fréquence fondamentale pour observer votre voix en direct, puis faites une pause et réécoutez l’audio récent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "בחרו ספקטרום או תדר יסוד כדי לצפות בקול בזמן אמת, ולאחר מכן השהו והשמיעו שוב את השמע האחרון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आवाज़ को लाइव देखने के लिए स्पेक्ट्रम या मूल आवृत्ति चुनें, फिर रोककर हाल का ऑडियो दोबारा सुनें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odaberite spektar ili osnovnu frekvenciju za praćenje glasa uživo, a zatim pauzirajte i reproducirajte nedavni zvuk."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Válassza a spektrumot vagy az alapfrekvenciát hangja élő megfigyeléséhez, majd szüneteltesse és játssza vissza a legutóbbi hangot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pilih spektrum atau frekuensi dasar untuk mengamati suara secara langsung, lalu jeda dan putar ulang audio terbaru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Scegli lo spettro o la frequenza fondamentale per osservare la voce in tempo reale, quindi sospendi e riascolta l’audio recente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "スペクトルまたは基本周波数を選んで声をリアルタイムに確認し、一時停止して直前の音声を再生できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "스펙트럼 또는 기본 주파수를 선택해 목소리를 실시간으로 확인한 다음, 일시 정지하고 최근 오디오를 다시 들어 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pilih spektrum atau frekuensi asas untuk melihat suara anda secara langsung, kemudian jeda dan main semula audio terkini."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kies spectrum of grondfrequentie om je stem live te volgen, te pauzeren en recente audio terug te luisteren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wybierz widmo lub częstotliwość podstawową, aby obserwować głos na żywo, a potem wstrzymać i odtworzyć ostatni dźwięk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Escolha o espectro ou a frequência fundamental para observar sua voz ao vivo, pausar e reproduzir o áudio recente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Выберите спектр или основную частоту, чтобы наблюдать голос в реальном времени, затем приостановить и прослушать недавний звук."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Välj spektrum eller grundfrekvens för att följa rösten live, pausa och spela upp det senaste ljudet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "เลือกสเปกตรัมหรือความถี่มูลฐานเพื่อดูเสียงแบบสด จากนั้นพักและเล่นเสียงล่าสุดย้อนหลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sesinizi canlı izlemek için spektrum veya temel frekansı seçin, ardından duraklatıp son sesi tekrar dinleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
