    "practice.home.description" : {
      "comment" : "Guided practice and comparison. Keep goals, model outputs, recording checks, and personal listening feedback distinct.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اختر محورًا واحدًا وكرر المقطع النصي نفسه لاستكشاف ما يتغير."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vyberte jedno zaměření a opakujte stejný text, abyste prozkoumali změny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vælg ét fokus, og gentag samme tekst for at undersøge, hvad der ændrer sig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wähle einen Schwerpunkt und wiederhole denselben Text, um Veränderungen zu erkunden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Επιλέξτε ένα σημείο εστίασης και επαναλάβετε το ίδιο κείμενο για να εξερευνήσετε τις αλλαγές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose one focus and repeat the same passage to explore what changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elige un aspecto y repite el mismo texto para explorar qué cambia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Valitse yksi kohde ja toista sama teksti tutkiaksesi, mikä muuttuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Choisissez un axe de travail et relisez le même passage pour explorer les changements."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "בחרו מוקד אחד וחזרו על אותו קטע כדי לבחון מה משתנה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "एक केंद्र-बिंदु चुनें और बदलाव देखने के लिए वही अंश दोहराएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odaberi jedan fokus i ponovi isti tekst da istražiš što se mijenja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Válassz egy fókuszt, és ismételd meg ugyanazt a szöveget, hogy felfedezd, mi változik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pilih satu fokus dan ulangi teks yang sama untuk mengeksplorasi perubahan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Scegli un aspetto e ripeti lo stesso brano per esplorare cosa cambia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "注目する項目を1つ選び、同じ文章を繰り返して変化を確かめましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "집중할 항목 하나를 선택하고 같은 글을 다시 읽으며 변화를 살펴보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pilih satu fokus dan ulang petikan yang sama untuk meneroka perubahan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kies één aandachtspunt en herhaal dezelfde tekst om te ontdekken wat verandert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wybierz jeden element i powtórz ten sam tekst, aby poznać zmiany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Escolha um foco e repita o mesmo texto para explorar o que muda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Выберите один аспект и повторите тот же текст, чтобы исследовать изменения."
          }
        },
        "sv" : {
          "stringUnit" : {
