    "practice.suggestion.captureDuration.detail" : {
      "comment" : "Voice practice interface. Keep actions concise; preserve metric names and format arguments.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اقرأ مقطعًا كاملًا بسرعة طبيعية، مع رصد 5 ثوانٍ على الأقل من الكلام قبل التحليل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Přečtěte přirozeně celý úryvek tak, aby obsahoval alespoň 5 sekund rozpoznané řeči."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Læs et helt tekststykke naturligt med mindst 5 sekunders registreret tale."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lies einen vollständigen Abschnitt in natürlichem Tempo mit mindestens 5 Sekunden erkannter Sprache."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Διαβάστε φυσικά ένα ολόκληρο απόσπασμα με τουλάχιστον 5 δευτερόλεπτα ανιχνεύσιμης ομιλίας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read a complete passage naturally, with at least 5 seconds of detected speech."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lee un pasaje completo de forma natural, con al menos 5 segundos de habla detectada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lue kokonainen katkelma luonnollisesti niin, että tunnistettua puhetta kertyy vähintään 5 sekuntia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lisez naturellement un passage complet, avec au moins 5 secondes de parole détectée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "קראו קטע שלם בקצב טבעי, עם לפחות 5 שניות של דיבור מזוהה לפני הניתוח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "स्वाभाविक गति से पूरा अंश पढ़ें। विश्लेषण से पहले कम से कम 5 सेकंड की बोलचाल का पता चलना चाहिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prirodno pročitajte cijeli odlomak s najmanje 5 sekundi prepoznatog govora."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Olvasson fel természetesen egy teljes szövegrészt, legalább 5 másodpercnyi észlelt beszéddel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Baca satu teks sampai selesai dengan tempo alami dan pastikan setidaknya 5 detik ucapan terdeteksi sebelum dianalisis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Leggi un intero brano in modo naturale, con almeno 5 secondi di parlato rilevato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "自然な速さで文章を最後まで読み、5秒以上の有効な音声を確保してから分析しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "자연스러운 속도로 문장을 끝까지 읽어 유효한 말소리가 5초 이상 담기게 한 뒤 분석해 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Baca petikan lengkap dengan kadar semula jadi, dengan sekurang-kurangnya 5 saat pertuturan yang dikesan sebelum analisis."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lees een volledig fragment op natuurlijke wijze voor, met minstens 5 seconden herkende spraak."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przeczytaj naturalnie cały fragment zawierający co najmniej 5 sekund wykrytej mowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Leia um trecho completo naturalmente, com pelo menos 5 segundos de fala detectada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Естественно прочитайте полный отрывок, чтобы в записи было не менее 5 секунд распознанной речи."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Läs ett helt stycke naturligt, med minst 5 sekunders upptäckt tal."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "อ่านข้อความให้จบด้วยจังหวะเป็นธรรมชาติ โดยให้ตรวจพบเสียงพูดอย่างน้อย 5 วินาทีก่อนวิเคราะห์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En az 5 saniye algılanan konuşma içerecek şekilde tam bir metin parçasını doğal biçimde okuyun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Природно прочитайте повний уривок, щоб запис містив щонайменше 5 секунд розпізнаного мовлення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Đọc hết một đoạn với tốc độ tự nhiên, đảm bảo có ít nhất 5 giây lời nói được phát hiện trước khi phân tích."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以自然语速读完一段话，保留至少 5 秒有效语音后再分析。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "以自然語速讀完一段話，保留至少 5 秒有效語音後再分析。"
          }
        }
      }
    },
