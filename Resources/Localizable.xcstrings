    "practice.suggestion.masculineComfort.detail" : {
      "comment" : "Voice practice interface. Keep actions concise; preserve metric names and format arguments.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "كانت طبقة صوتك منخفضة بالفعل. حافظ على صوت مريح وواضح، واستكشف الرنين دون محاولة خفضها أكثر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Výška hlasu už byla nízká. Mluvte lehce a zřetelně; zkoumejte rezonanci bez dalšího tlačení hlasu dolů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Din tonehøjde var allerede lav. Hold stemmen afslappet og tydelig. Udforsk resonans uden at presse tonehøjden længere ned."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deine Tonhöhe war bereits niedrig. Halte die Stimme locker und klar. Erkunde die Resonanz, ohne die Tonhöhe weiter zu drücken."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το τονικό ύψος ήταν ήδη χαμηλό. Κρατήστε τη φωνή άνετη και καθαρή· εξερευνήστε την αντήχηση χωρίς να την πιέζετε χαμηλότερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your pitch was already low. Keep your voice easy and clear; explore resonance without pushing lower."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu tono ya era bajo. Mantén la voz relajada y clara; explora la resonancia sin forzar un tono aún más grave."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sävelkorkeutesi oli jo matala. Pidä ääni rentona ja selkeänä. Tutki resonanssia painamatta ääntä alemmas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Votre hauteur était déjà basse. Gardez une voix aisée et claire ; explorez la résonance sans forcer davantage vers le grave."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "גובה הקול כבר היה נמוך. שמרו על קול נינוח וברור, וחקרו תהודה בלי להנמיך בכוח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इस बार पिच पहले से कम थी। आवाज़ सहज और स्पष्ट रखें; उसे और नीचे करने के बजाय अनुनाद आज़माएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Visina glasa već je bila niska. Neka glas ostane lagan i jasan; istražite rezonanciju bez prisilnog spuštanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A hangmagassága már alacsony volt. Maradjon könnyed és tiszta a hangja; fedezze fel a rezonanciát további mélyítés erőltetése nélkül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nada kali ini sudah rendah. Jaga suara tetap ringan dan jelas; jelajahi resonansi tanpa memaksanya lebih rendah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il tono era già basso. Mantieni la voce sciolta e chiara; esplora la risonanza senza forzare ancora verso il basso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "今回の音高はすでに低めでした。楽で明瞭な発声を保ち、さらに低くしようとせず響きを探しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이번 음높이는 이미 낮은 편이었어요. 편안하고 또렷하게 발성하며, 더 낮추려 하지 말고 공명을 탐색해 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pic kali ini sudah rendah. Kekalkan suara yang santai dan jelas; terokai resonans tanpa memaksanya lebih rendah."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je toonhoogte was al laag. Houd je stem ontspannen en helder. Verken resonantie zonder de toonhoogte verder omlaag te duwen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wysokość głosu była już niska. Zachowaj swobodę i wyrazistość; badaj rezonans bez wymuszania dalszego obniżania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sua altura já estava baixa. Mantenha a voz solta e clara; explore a ressonância sem forçar a voz ainda mais para o grave."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Высота голоса уже была низкой. Сохраняйте лёгкое и ясное звучание; исследуйте резонанс, не пытаясь силой понизить голос ещё больше."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Din tonhöjd var redan låg. Håll rösten avspänd och tydlig. Utforska resonansen utan att pressa tonhöjden längre ned."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ระดับเสียงครั้งนี้ต่ำอยู่แล้ว รักษาเสียงให้สบายและชัดเจน สำรวจการก้องกังวานโดยไม่ฝืนให้ต่ำลงอีก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ses perdeniz zaten düşüktü. Sesinizi rahat ve net tutun; daha da kalınlaştırmaya zorlamadan rezonansı keşfedin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Висота голосу вже була низькою. Зберігайте легке й чітке звучання; досліджуйте резонанс без примусового подальшого зниження."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cao độ lần này đã thấp. Giữ giọng nhẹ nhàng, rõ ràng và khám phá cộng hưởng mà không cố hạ thêm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这次音高已经较低。保持轻松清晰，先探索共鸣，无需继续压低。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "這次音高已經較低。保持輕鬆清晰，先探索共鳴，無需繼續壓低。"
          }
        }
      }
    },
    "practice.suggestion.masculineComfort.title" : {
