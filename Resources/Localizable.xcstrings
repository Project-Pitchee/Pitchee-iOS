        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "स्थानीय स्कोर तुलना रुक गई है। कुछ डेटा शायद मिटा न हो। डिवाइस अनलॉक करके दोबारा कोशिश करें।"
