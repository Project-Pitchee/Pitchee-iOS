    "export.error.photoLibraryAccessDenied.message" : {
      "comment" : "Shown when permission to add report images to Photos is denied or restricted. Directs the user to check photo permissions in system settings.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تعذّرت إضافة الصور إلى مكتبة الصور. تحقق من أذونات الصور لتطبيق Pitchee في الإعدادات وحاول مجددًا."
