    "practice.suggestion.compare.detail" : {
      "comment" : "Voice practice interface. Keep actions concise; preserve metric names and format arguments.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قارن الراحة والصوت الذي تريده والدرجة، وكرر المقارنة في الظروف نفسها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Porovnejte pohodlí, požadovaný zvuk a skóre; opakujte za stejných podmínek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sammenlign komfort, den ønskede lyd og scoren. Gentag under de samme forhold."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vergleiche das Stimmgefühl, deinen gewünschten Klang und den Wert. Wiederhole die Aufnahme unter gleichen Bedingungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Συγκρίνετε την άνεση, τον επιθυμητό ήχο και τη βαθμολογία· επαναλάβετε στις ίδιες συνθήκες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare comfort, your desired sound, and the score; repeat under the same conditions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Compara la comodidad, el sonido que buscas y la puntuación; repite en las mismas condiciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vertaa mukavuutta, toivomaasi ääntä ja pisteitä. Toista samoissa oloissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Comparez le confort, le son recherché et le score ; recommencez dans les mêmes conditions."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "השוו נוחות, את הצליל הרצוי ואת הציון, וחזרו על ההשוואה באותם תנאים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सहजता, मनचाही आवाज़ और स्कोर की तुलना करें; उन्हीं स्थितियों में दोहराएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usporedite ugodu, željeni zvuk i ocjenu; ponovite u istim uvjetima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hasonlítsa össze a kényelmet, a kívánt hangzást és a pontszámot; ismételje meg azonos körülmények között."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bandingkan kenyamanan, suara yang diinginkan, dan skor; ulangi dalam kondisi yang sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Confronta comfort, suono desiderato e punteggio; ripeti nelle stesse condizioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "楽に出せたか、目指す声に近いか、スコアはどうかを聞き比べ、同じ条件で繰り返しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "편안함, 원하는 소리, 점수를 함께 비교하고 같은 조건에서 반복해 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bandingkan keselesaan, bunyi yang diingini dan skor; ulang dalam keadaan yang sama."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vergelijk comfort, je gewenste klank en de score. Herhaal onder dezelfde omstandigheden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Porównaj komfort, pożądane brzmienie i wynik; powtórz w tych samych warunkach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Compare conforto, som desejado e pontuação; repita nas mesmas condições."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сопоставьте комфорт, желаемое звучание и оценку; повторите в тех же условиях."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jämför känslan, den önskade klangen och poängen. Upprepa under samma förhållanden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "เปรียบเทียบความสบาย เสียงที่ต้องการ และคะแนน แล้วทำซ้ำในสภาพเดียวกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rahatlığı, istediğiniz sesi ve puanı karşılaştırın; aynı koşullarda tekrarlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Зіставте комфорт, бажане звучання й оцінку; повторіть за тих самих умов."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "So sánh sự thoải mái, âm thanh mong muốn và điểm số; lặp lại trong cùng điều kiện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "结合舒适度、目标听感与分数回听，在相同条件下重复比较。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "結合舒適度、目標聽感與分數回聽，在相同條件下重複比較。"
          }
        }
      }
    },
