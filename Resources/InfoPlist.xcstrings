    "NSMicrophoneUsageDescription" : {
      "comment" : "Permission prompt shown the first time Pitchee records. Name the concrete benefit and keep it a single sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يستخدم Pitchee الميكروفون لتسجيل صوتك بهدف التحليل على الجهاز."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aplikace Pitchee používá mikrofon k nahrávání hlasu, který se analyzuje přímo v zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee bruger mikrofonen til at optage din stemme og analysere den på enheden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee verwendet das Mikrofon, um deine Stimme für die Analyse auf dem Gerät aufzunehmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το Pitchee χρησιμοποιεί το μικρόφωνο για να ηχογραφεί τη φωνή σας και να την αναλύει στη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitchee uses the microphone to record your voice for on-device analysis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee necesita el micrófono para grabar tu voz y analizarla en el dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee käyttää mikrofonia äänesi tallentamiseen laitteella tehtävää analyysia varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee utilise le microphone pour enregistrer votre voix et l’analyser directement sur l’appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee משתמשת במיקרופון כדי להקליט את הקול שלכם לצורך ניתוח במכשיר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee डिवाइस पर विश्लेषण के लिए आपकी आवाज़ रिकॉर्ड करने हेतु माइक्रोफ़ोन का उपयोग करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee koristi mikrofon za snimanje tvog glasa i analizu na uređaju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A Pitchee a mikrofont használja a hangod rögzítéséhez, hogy a készüléken végezhesse el az elemzést."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee memakai mikrofon untuk merekam suara Anda agar dapat dianalisis di perangkat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee usa il microfono per registrare la tua voce e analizzarla sul dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee は、端末上で分析するためにマイクで声を録音します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee는 목소리를 녹음해 기기에서 분석하기 위해 마이크를 사용해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee menggunakan mikrofon untuk merakam suara anda bagi analisis pada peranti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee gebruikt de microfoon om je stem op te nemen voor analyse op je apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee potrzebuje dostępu do mikrofonu, aby nagrać głos i przeprowadzić analizę na urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Pitchee usa o microfone para gravar sua voz e fazer a análise no próprio dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee использует микрофон, чтобы записывать голос для анализа на устройстве."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee använder mikrofonen för att spela in din röst för analys på enheten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee ใช้ไมโครโฟนบันทึกเสียงของคุณเพื่อวิเคราะห์บนอุปกรณ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee, sesini kaydedip cihazında analiz edebilmek için mikrofona erişir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee використовує мікрофон, щоб записати ваш голос для аналізу на пристрої."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee dùng micrô để ghi âm giọng nói của bạn nhằm phân tích ngay trên thiết bị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitchee 需要使用麦克风录制声音，以完成分析。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pitchee 需要使用麥克風錄製聲音，以完成分析。"
          }
        }
      }
    },
