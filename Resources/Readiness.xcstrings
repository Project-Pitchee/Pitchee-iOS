    "readiness.coldStart": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the starting score. Complete more valid recordings to receive a personalized score."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前为初始分；完成更多有效录音后生成个性化评分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前為初始分；完成更多有效錄音後產生個人化評分。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s’agit du score initial. Effectuez davantage d’enregistrements valides pour obtenir un score personnalisé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist der Startwert. Erstelle weitere gültige Aufnahmen für eine persönliche Bewertung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es la puntuación inicial. Completa más grabaciones válidas para obtener una puntuación personalizada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это начальная оценка. Сделайте больше подходящих записей для получения персональной оценки."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الدرجة الأولية. أكمل المزيد من التسجيلات الصالحة للحصول على درجة مخصصة لك."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在は初期スコアです。有効な録音を増やすと、個人に合わせたスコアが表示されます。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זהו הציון ההתחלתי. יש להשלים עוד הקלטות תקינות לקבלת ציון אישי."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu başlangıç puanıdır. Kişisel puan almak için daha fazla geçerli kayıt tamamlayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là điểm khởi đầu. Hoàn thành thêm bản ghi hợp lệ để nhận điểm cá nhân hóa."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή είναι η αρχική βαθμολογία. Ολοκληρώστε περισσότερες έγκυρες ηχογραφήσεις για εξατομικευμένη βαθμολογία."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo è il punteggio iniziale. Completa altre registrazioni valide per ricevere un punteggio personalizzato."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือคะแนนเริ่มต้น บันทึกเสียงที่ใช้ได้ให้มากขึ้นเพื่อรับคะแนนเฉพาะบุคคล"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह शुरुआती स्कोर है। व्यक्तिगत स्कोर पाने के लिए और मान्य रिकॉर्डिंग पूरी करें।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це початкова оцінка. Зробіть більше придатних записів, щоб отримати персональну оцінку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta är startpoängen. Gör fler giltiga inspelningar för att få en personlig poäng."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini ialah skor permulaan. Lengkapkan lebih banyak rakaman sah untuk mendapatkan skor peribadi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini adalah skor awal. Selesaikan lebih banyak rekaman valid untuk mendapatkan skor pribadi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä on aloituspistemäärä. Tee lisää kelvollisia tallenteita saadaksesi henkilökohtaisen pistemäärän."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To wynik początkowy. Wykonaj więcej prawidłowych nagrań, aby otrzymać wynik dopasowany do Ciebie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er startscoren. Lav flere gyldige optagelser for at få en personlig score."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is de beginscore. Maak meer geldige opnamen om een persoonlijke score te krijgen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재는 초기 점수입니다. 유효한 녹음을 더 완료하면 개인화된 점수가 제공됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é a pontuação inicial. Faça mais gravações válidas para receber uma pontuação personalizada."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a kezdőpontszám. Készíts több érvényes felvételt a személyre szabott pontszámhoz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je počáteční skóre. Pořiďte více platných nahrávek a získáte osobní skóre."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo je početni rezultat. Napravite više valjanih snimki za personalizirani rezultat."
          }
        }
      }
    },
    "readiness.refreshTime": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates daily at 04:00 Beijing time"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天北京时间 04:00 更新"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天北京時間 04:00 更新"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mise à jour quotidienne à 04:00, heure de Pékin"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Täglich um 04:00 Uhr Pekinger Zeit aktualisiert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se actualiza a diario a las 04:00, hora de Pekín"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновляется ежедневно в 04:00 по пекинскому времени"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحدّث يوميًا الساعة 04:00 بتوقيت بكين"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日北京時間 04:00 に更新"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתעדכן מדי יום בשעה 04:00 לפי שעון בייג׳ינג"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her gün Pekin saatiyle 04:00’te güncellenir"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cập nhật hằng ngày lúc 04:00 giờ Bắc Kinh"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενημερώνεται καθημερινά στις 04:00 ώρα Πεκίνου"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si aggiorna ogni giorno alle 04:00, ora di Pechino"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปเดตทุกวันเวลา 04:00 น. ตามเวลาปักกิ่ง"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर दिन बीजिंग समय 04:00 बजे अपडेट होता है"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновлюється щодня о 04:00 за пекінським часом"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppdateras dagligen kl. 04:00 Pekingtid"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikemas kini setiap hari pada 04:00 waktu Beijing"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperbarui setiap hari pukul 04.00 waktu Beijing"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivittyy päivittäin klo 04.00 Pekingin aikaa"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizacja codziennie o 04:00 czasu pekińskiego"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opdateres dagligt kl. 04.00 Beijing-tid"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt dagelijks om 04:00 Pekingse tijd bijgewerkt"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 베이징 시간 04:00에 업데이트"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualiza diariamente às 04:00, horário de Pequim"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Naponta pekingi idő szerint 04:00-kor frissül"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizuje se denně v 04:00 pekingského času"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ažurira se svakodnevno u 04:00 po pekinškom vremenu"
          }
        }
      }
    },
