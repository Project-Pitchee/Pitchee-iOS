    "feature.practice.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore a way of using your voice that works for you, with analysis and practice resources."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用分析与练习资料，探索适合自己的发声方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過分析與練習資料，探索適合自己的發聲方式。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grâce aux analyses et aux ressources d’entraînement, explorez une façon d’utiliser votre voix qui vous convient."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entdecke mit Analysen und Übungsmaterialien einen Umgang mit deiner Stimme, der zu dir passt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora una forma de usar tu voz que se adapte a ti, con análisis y recursos para practicar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте анализ и материалы для практики, чтобы найти подходящий вам способ звучать."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استكشف طريقة استخدام صوتك التي تناسبك، بمساعدة التحليل ومواد التدريب."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分析と練習の資料を通して、自分に合った声の出し方を探しましょう。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בעזרת ניתוח ומשאבים לתרגול, אפשר לגלות דרך להשתמש בקול שמתאימה לך."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiz ve alıştırma kaynaklarıyla sana uygun bir ses kullanımı keşfet."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khám phá cách phát giọng phù hợp với bạn qua phân tích và tài liệu luyện tập."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με ανάλυση και υλικό εξάσκησης, εξερεύνησε έναν τρόπο χρήσης της φωνής που σου ταιριάζει."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con analisi e materiali per esercitarti, esplora un modo di usare la voce che sia adatto a te."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำรวจวิธีใช้เสียงที่เหมาะกับคุณ ผ่านการวิเคราะห์และเนื้อหาสำหรับฝึก"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विश्लेषण और अभ्यास सामग्री की मदद से अपने लिए सही आवाज़ निकालने का तरीका खोजें।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За допомогою аналізу й матеріалів для практики знайдіть спосіб звучати, який підходить саме вам."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utforska ett sätt att använda rösten som passar dig, med hjälp av analys och övningsmaterial."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terokai cara menggunakan suara yang sesuai untuk anda melalui analisis dan bahan latihan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelajahi cara menggunakan suara yang cocok untuk Anda melalui analisis dan materi latihan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Löydä itsellesi sopiva tapa käyttää ääntäsi analyysien ja harjoittelumateriaalien avulla."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzięki analizie i materiałom do ćwiczeń odkrywaj sposób używania głosu, który Ci odpowiada."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udforsk en måde at bruge stemmen på, der passer til dig, med analyser og øvelsesmateriale."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontdek met analyses en oefenmateriaal een manier om je stem te gebruiken die bij je past."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분석과 연습 자료를 통해 나에게 맞는 발성 방식을 탐색해 보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com análises e materiais de prática, explore uma forma de usar a voz que funcione para você."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elemzéssel és gyakorlóanyagokkal fedezd fel a neked megfelelő hanghasználatot."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "S pomocí analýzy a materiálů ke cvičení objevujte způsob používání hlasu, který vám vyhovuje."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uz analizu i materijale za vježbanje istražite način korištenja glasa koji vam odgovara."
          }
        }
      }
    },
