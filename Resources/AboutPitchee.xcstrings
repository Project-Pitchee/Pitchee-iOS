    "hero.tagline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your voice.\nMore like you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让声音，\n更像你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓聲音，\n更像你。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une voix qui\nvous ressemble."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Stimme.\nGanz du."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu voz.\nMás tú."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусть ваш голос\nзвучит по-вашему."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صوتك.\nأقرب إلى حقيقتك."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの声を、\nもっとあなたらしく。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקול שלך.\nיותר כמוך."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesin.\nSana daha yakın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giọng nói của bạn.\nĐậm chất riêng hơn."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η φωνή σου.\nΠιο κοντά σε σένα."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua voce.\nPiù vicina a te."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงของคุณ\nที่เป็นคุณมากขึ้น"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी आवाज़।\nऔर भी आप जैसी।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нехай ваш голос\nзвучить по-вашому."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din röst.\nMer som du."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara anda.\nLebih mencerminkan diri anda."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara Anda.\nMakin mencerminkan diri Anda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oma äänesi.\nEnemmän sinua."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niech Twój głos\nbrzmi bardziej jak Ty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din stemme.\nMere dig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een stem die\nbij je past."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 목소리,\n더 당신답게."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua voz.\nMais você."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hangod.\nIgazán a tiéd."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ať váš hlas\nzní jako vy."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš glas.\nViše nalik vama."
          }
        }
      }
    },
    "hero.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get to know your voice. Find your own rhythm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认识自己的声音，也找到自己的节奏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "認識自己的聲音，也找到自己的節奏。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprenez à connaître votre voix et trouvez votre propre rythme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lerne deine Stimme kennen und finde deinen eigenen Rhythmus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conoce tu voz y encuentra tu propio ritmo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узнайте свой голос. Найдите свой ритм."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرّف على صوتك، واعثر على إيقاعك الخاص."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の声を知り、自分のペースを見つける。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להכיר את הקול שלך. למצוא את הקצב שלך."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesini tanı. Kendi ritmini bul."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiểu giọng nói của mình và tìm nhịp điệu riêng."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γνώρισε τη φωνή σου. Βρες τον δικό σου ρυθμό."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conosci la tua voce e trova il tuo ritmo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำความรู้จักเสียงของตัวเอง และค้นหาจังหวะที่ใช่สำหรับคุณ"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी आवाज़ को जानें और अपनी लय खोजें।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пізнайте свій голос. Знайдіть власний ритм."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lär känna din röst och hitta din egen rytm."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenali suara anda dan temui rentak sendiri."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenali suara Anda dan temukan ritme sendiri."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutustu ääneesi ja löydä oma rytmisi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznaj swój głos. Znajdź własny rytm."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lær din stemme at kende, og find din egen rytme."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer je stem kennen en vind je eigen ritme."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 목소리를 이해하고 나만의 리듬을 찾아보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conheça sua voz e encontre seu próprio ritmo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ismerd meg a hangod. Találd meg a saját ritmusod."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznejte svůj hlas. Najděte vlastní rytmus."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upoznajte svoj glas. Pronađite vlastiti ritam."
          }
        }
      }
    },
