    "hero.accessibility.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays a visual sound wave animation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放一段视觉声波动效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放一段聲波視覺動畫。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance une animation visuelle d’ondes sonores."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt eine visuelle Schallwellenanimation ab."
          }
        },
        "es": {
          "stringUnit": {
