    "feature.progress.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn individual recordings into trends, so even subtle changes leave a trace."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将每次记录连成趋势，让细微的变化也有迹可循。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將每次紀錄連成趨勢，讓細微的變化也有跡可循。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reliez vos enregistrements pour dégager des tendances et garder une trace des changements, même subtils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus einzelnen Aufzeichnungen werden Trends, die auch feine Veränderungen sichtbar machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta tus registros para descubrir tendencias y seguir incluso los cambios más sutiles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объединяйте отдельные записи в тенденции, чтобы замечать даже едва уловимые изменения."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجمع سجلاتك في اتجاهات واضحة، حتى تجد أثراً للتغيّرات الدقيقة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一つひとつの記録をつなぎ、小さな変化も傾向として振り返れます。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרישומים מצטרפים למגמות, כך שגם שינויים עדינים משאירים עקבות."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek tek kayıtları eğilimlere dönüştür; en küçük değişimlerin bile izini sür."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối từng bản ghi thành xu hướng, để cả những thay đổi nhỏ cũng có thể theo dõi."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύνδεσε τις επιμέρους καταγραφές σε τάσεις, ώστε να διακρίνεις ακόμη και τις πιο λεπτές αλλαγές."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega le singole registrazioni per scoprire tendenze e tenere traccia anche dei cambiamenti più lievi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมโยงบันทึกแต่ละครั้งเป็นแนวโน้ม เพื่อให้ติดตามได้แม้เป็นการเปลี่ยนแปลงเล็กน้อย"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर रिकॉर्ड को रुझानों में पिरोएँ, ताकि छोटे-से-छोटे बदलाव भी नज़र आएँ।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Об’єднуйте окремі записи в тенденції, щоб помічати навіть найтонші зміни."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Samla dina mätningar i trender, så att även små förändringar blir synliga."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan setiap rekod menjadi arah aliran, supaya perubahan kecil pun dapat dijejaki."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan setiap catatan menjadi tren, agar perubahan kecil pun bisa ditelusuri."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä mittauksesi kehityssuunniksi, jotta pienetkin muutokset tulevat näkyviin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łącz poszczególne zapisy w trendy, by dostrzegać nawet subtelne zmiany."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Saml dine målinger i tendenser, så selv små forandringer bliver synlige."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Breng losse metingen samen in trends, zodat ook kleine veranderingen zichtbaar worden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매번의 기록을 추세로 연결하여 미세한 변화도 살펴볼 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte seus registros para descobrir tendências e acompanhar até as mudanças mais sutis."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyes feljegyzésekből kirajzolódó trendek a finom változásokat is láthatóvá teszik."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Propojte jednotlivé záznamy do trendů, abyste zachytili i jemné změny."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povežite pojedinačne zapise u trendove kako biste uočili i suptilne promjene."
          }
        }
      }
    },
