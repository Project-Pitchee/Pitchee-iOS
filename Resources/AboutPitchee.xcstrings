    "story.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don’t have to become\nsomeone else."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你不必成为\n另一个人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你不必成為\n另一個人。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n’avez pas à devenir\nquelqu’un d’autre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst niemand\nanderes werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tienes que convertirte\nen otra persona."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вам не нужно становиться\nкем-то другим."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لست مضطراً لتصبح\nشخصاً آخر."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かほかの人に\nならなくていい。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין צורך להפוך\nלמישהו אחר."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka biri olmana\ngerek yok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn không cần trở thành\nmột ai khác."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν χρειάζεται να γίνεις\nκάποιος άλλος."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non devi diventare\nqualcun altro."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณไม่จำเป็นต้องเป็น\nคนอื่น"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको कोई और\nबनने की ज़रूरत नहीं।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вам не потрібно ставати\nкимось іншим."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du behöver inte bli\nnågon annan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda tidak perlu menjadi\norang lain."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda tidak perlu menjadi\norang lain."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinun ei tarvitse muuttua\njoksikuksi toiseksi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie musisz stawać się\nkimś innym."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du behøver ikke blive\nen anden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hoeft geen\nander te worden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사람이\n될 필요는 없어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não precisa se tornar\noutra pessoa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem kell\nmásvalakivé válnod."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemusíte se stát\nněkým jiným."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne morate postati\nnetko drugi."
          }
        }
      }
    },
    "story.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every voice has its own character. Pitchee helps you notice the details and explore how you express yourself, so every practice brings you closer to understanding your voice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一种声音都有自己的质感。Pitchee 陪你听见细节、探索表达，让每一次练习都更接近自己的声音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每一種聲音都有自己的質感。Pitchee 陪你聽見細節、探索表達，讓每一次練習都更接近自己的聲音。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque voix a son propre caractère. Pitchee vous aide à en percevoir les nuances et à explorer votre expression, pour mieux vous connaître à chaque séance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Stimme hat ihren eigenen Charakter. Pitchee hilft dir, die Feinheiten wahrzunehmen und deinen Ausdruck zu entdecken. So lernst du dich mit jeder Übung besser kennen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada voz tiene su propio carácter. Pitchee te ayuda a escuchar los detalles y a explorar tu expresión, para que cada práctica te permita conocerte mejor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждого голоса свой характер. Pitchee помогает замечать детали и находить способы самовыражения, чтобы с каждым занятием вы лучше понимали свой голос."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لكل صوت طابعه الخاص. يساعدك Pitchee على ملاحظة التفاصيل واستكشاف طرق التعبير، لتتعرف أكثر على صوتك مع كل تمرين."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "声には、一人ひとりの個性があります。Pitchee と一緒に細かな違いに気づき、表現を探りながら、練習のたびに自分の声をもっと知っていきましょう。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לכל קול יש אופי משלו. Pitchee עוזר להבחין בפרטים ולגלות דרכים לביטוי עצמי, כדי שכל תרגול יקרב אותך להבנת הקול שלך."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sesin kendine özgü bir karakteri vardır. Pitchee, ayrıntıları fark etmene ve kendini ifade etmenin yollarını keşfetmene yardımcı olur. Böylece her alıştırmada sesini biraz daha iyi tanırsın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi giọng nói đều có nét riêng. Pitchee giúp bạn lắng nghe từng chi tiết và khám phá cách biểu đạt, để hiểu mình hơn sau mỗi lần luyện tập."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε φωνή έχει τον δικό της χαρακτήρα. Το Pitchee σε βοηθά να προσέχεις τις λεπτομέρειες και να εξερευνάς τρόπους έκφρασης, ώστε κάθε εξάσκηση να σε φέρνει πιο κοντά στη φωνή σου."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni voce ha il proprio carattere. Pitchee ti aiuta a cogliere i dettagli e a esplorare il tuo modo di esprimerti, per conoscerti meglio a ogni esercizio."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกเสียงมีเอกลักษณ์ของตัวเอง Pitchee ช่วยให้คุณได้ยินรายละเอียดและสำรวจการแสดงออก เพื่อให้ทุกครั้งที่ฝึกได้รู้จักตัวเองมากขึ้น"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर आवाज़ की अपनी पहचान होती है। Pitchee बारीकियाँ सुनने और अभिव्यक्ति के तरीके खोजने में आपका साथ देता है, ताकि हर अभ्यास के साथ आप खुद को और बेहतर जान सकें।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен голос має свій характер. Pitchee допомагає помічати деталі й досліджувати способи самовираження, щоб із кожним заняттям ви краще розуміли свій голос."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje röst har sin egen karaktär. Pitchee hjälper dig att höra detaljerna och utforska ditt uttryck, så att du lär känna dig själv bättre med varje övning."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap suara mempunyai keunikan tersendiri. Pitchee membantu anda mendengar perincian dan meneroka cara berekspresi, supaya setiap latihan membawa anda lebih dekat untuk memahami diri sendiri."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap suara memiliki karakternya sendiri. Pitchee membantu Anda mendengar detail dan menjelajahi cara berekspresi, agar setiap latihan membuat Anda makin memahami diri sendiri."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokaisella äänellä on oma luonteensa. Pitchee auttaa sinua kuulemaan yksityiskohdat ja tutkimaan ilmaisuasi, jotta opit tuntemaan itsesi paremmin jokaisella harjoituskerralla."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy głos ma swój charakter. Pitchee pomaga dostrzegać szczegóły i odkrywać sposoby wyrażania siebie, by z każdym ćwiczeniem lepiej rozumieć własny głos."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver stemme har sin egen karakter. Pitchee hjælper dig med at høre detaljerne og udforske dit udtryk, så du lærer dig selv bedre at kende med hver øvelse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke stem heeft een eigen karakter. Pitchee helpt je de details te horen en je uitdrukking te verkennen, zodat je jezelf bij elke oefening beter leert kennen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 목소리에는 고유한 개성이 있어요. Pitchee와 함께 작은 차이에 귀 기울이고 표현 방식을 탐색하며, 연습할 때마다 나를 더 알아가세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada voz tem sua própria personalidade. O Pitchee ajuda você a perceber os detalhes e explorar sua expressão, para se conhecer melhor a cada prática."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden hangnak saját karaktere van. A Pitchee segít észrevenni a részleteket és felfedezni az önkifejezés lehetőségeit, hogy minden gyakorlással jobban megértsd a saját hangod."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý hlas má svůj charakter. Pitchee vám pomáhá vnímat detaily a objevovat způsoby vyjádření, abyste s každým cvičením lépe rozuměli vlastnímu hlasu."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaki glas ima svoj karakter. Pitchee vam pomaže zamijetiti detalje i istražiti načine izražavanja kako biste sa svakom vježbom bolje razumjeli svoj glas."
          }
        }
      }
    },
