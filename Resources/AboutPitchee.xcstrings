    "feature.listen.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From pitch to spectrum, turn what you hear into feedback you can see."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从音高到频谱，把听见的细节变成看得见的反馈。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從音高到頻譜，把聽見的細節變成看得見的回饋。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De la hauteur au spectre sonore, les détails que vous entendez deviennent des repères visuels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von der Tonhöhe bis zum Frequenzspektrum: Was du hörst, wird zu sichtbarem Feedback."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde el tono hasta el espectro, convierte los detalles que escuchas en información que puedes ver."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От высоты тона до спектра: превратите то, что вы слышите, в наглядную обратную связь."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من درجة الصوت إلى طيفه، حوّل التفاصيل التي تسمعها إلى ملاحظات يمكنك رؤيتها."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音の高さからスペクトルまで。耳で感じた細かな違いを、目に見えるフィードバックに。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מגובה הצליל ועד הספקטרום, הפרטים שנשמעים הופכים למשוב שאפשר לראות."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses perdesinden spektruma, duyduğun ayrıntıları görebileceğin geri bildirimlere dönüştür."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Từ cao độ đến phổ âm, biến những chi tiết bạn nghe được thành phản hồi có thể nhìn thấy."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Από το τονικό ύψος μέχρι το φάσμα, μετέτρεψε όσα ακούς σε ανατροφοδότηση που μπορείς να δεις."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dall’altezza allo spettro sonoro, trasforma i dettagli che senti in riscontri che puoi vedere."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จากระดับเสียงถึงสเปกตรัม เปลี่ยนรายละเอียดที่ได้ยินให้เป็นข้อมูลตอบกลับที่มองเห็นได้"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुर की ऊँचाई से लेकर ध्वनि स्पेक्ट्रम तक, सुनी हुई बारीकियों को ऐसे फ़ीडबैक में बदलें जो नज़र आए।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Від висоти тону до спектра: перетворіть те, що чуєте, на наочний зворотний зв’язок."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Från tonhöjd till spektrum – förvandla det du hör till återkoppling du kan se."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Daripada pic hingga spektrum, ubah perincian yang anda dengar menjadi maklum balas yang boleh dilihat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dari tinggi nada hingga spektrum, ubah detail yang Anda dengar menjadi umpan balik yang bisa dilihat."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sävelkorkeudesta taajuusspektriin – muuta kuulemasi yksityiskohdat näkyväksi palautteeksi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od wysokości dźwięku po widmo — zamień to, co słyszysz, w informacje, które możesz zobaczyć."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra tonehøjde til spektrum – gør det, du hører, til feedback, du kan se."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Van toonhoogte tot spectrum: maak van wat je hoort feedback die je kunt zien."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음높이부터 스펙트럼까지, 귀로 들은 작은 차이를 눈으로 확인할 수 있는 피드백으로 바꿔요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Da altura ao espectro sonoro, transforme os detalhes que você ouve em informações que pode ver."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hangmagasságtól a spektrumig: alakítsd a hallott részleteket látható visszajelzéssé."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Od výšky tónu po spektrum — proměňte to, co slyšíte, ve zpětnou vazbu, kterou uvidíte."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Od visine tona do spektra, pretvorite ono što čujete u povratne informacije koje možete vidjeti."
          }
        }
      }
    },
